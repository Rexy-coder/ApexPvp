----------------------------------------------------------------------
-- Data
----------------------------------------------------------------------
local function defaultData()
	return {
		Coins = 0,
		BestEarn = 0,
		BestDistance = 0,
		BestCombo = 0,
		Runs = 0,
		TotalSmashed = 0,
		TotalEarned = 0,
		Rebirths = 0,
		Owned = {},
		Skins = { Classic = true },
		Skin = "Classic",
		Settings = { Music = true, SFX = true, Shake = true, SpeedLines = true, Hints = true, PerfectPush = true },
		Turbos = 0,
		BoostEnds = 0,
		GrantedPasses = {}, -- passes given by an admin
		Receipts = {}, -- PurchaseId -> true (so a purchase is never granted twice)
		ReceiptOrder = {},
		-- Update 2
		Candy = 0,
		Pets = {}, -- uid -> { P = petId, L = locked }
		Equipped = {}, -- list of uids
		Index = {}, -- petId -> true once ever hatched
		NextPetId = 1,
		DailyStreak = 0,
		LastDaily = -1, -- day number of the last claim
		Codes = {}, -- redeemed codes
		-- Update 3
		Presents = 0,
	}
end

local SETTING_KEYS = { Music = true, SFX = true, Shake = true, SpeedLines = true, Hints = true, PerfectPush = true }

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("SnowballSmash_v1")
	end)
	if ok then
		store = result
	else
		warn("[SnowballSmash] DataStore unavailable, progress will not save:", result)
	end
end

local profiles = {}
local loaded = {}
local activeRuns = {}

local function merge(saved)
	local data = defaultData()
	if type(saved) ~= "table" then
		return data
	end
	for key, value in saved do
		if data[key] ~= nil and type(value) == type(data[key]) then
			if type(value) == "table" then
				for k, v in value do
					data[key][k] = v
				end
			else
				data[key] = value
			end
		end
	end
	return data
end

local function save(player: Player)
	local data = profiles[player]
	if not data or not store or not loaded[player] then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync("p_" .. player.UserId, data)
	end)
	if not ok then
		warn("[SnowballSmash] Save failed for", player.Name, err)
	end
end

local function waitForData(player: Player)
	local t = 0
	while not profiles[player] and t < 15 and player.Parent do
		t += task.wait(0.1)
	end
	return profiles[player]
end

----------------------------------------------------------------------
-- Passes, admins, events
----------------------------------------------------------------------
local robloxOwned = {} -- [player] = { [passKey] = true }

local function hasPass(player: Player, key: string): boolean
	if Monetization.StudioOwnsAllPasses and RunService:IsStudio() then
		return true
	end
	local data = profiles[player]
	if data and data.GrantedPasses[key] then
		return true
	end
	local owned = robloxOwned[player]
	return owned ~= nil and owned[key] == true
end

local function isAdmin(player: Player): boolean
	if AdminConfig.StudioEveryoneIsAdmin and RunService:IsStudio() then
		return true
	end
	if AdminConfig.CreatorIsAdmin and game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	return table.find(AdminConfig.Admins, player.UserId) ~= nil
end

local function eventActive(id: string): boolean
	local ends = GameState:GetAttribute("Event_" .. id)
	return type(ends) == "number" and ends > now()
end

local function extrasFor(player: Player)
	local data = profiles[player]
	local extras = { CoinMult = 1, GrowthMult = 1, LaunchMult = 1, CritBonus = 0, StartRadiusBonus = 0, Mutations = {}, AirMult = 1, GravityMult = 1 }
	if hasPass(player, "VIP") then
		extras.CoinMult *= 1 + Perks.VIPCoinBonus
	end
	if hasPass(player, "DoubleCoins") then
		extras.CoinMult *= Perks.DoubleCoinsMult
	end
	if hasPass(player, "MegaStart") then
		extras.StartRadiusBonus = Perks.MegaStartRadius
	end
	if hasPass(player, "LuckyCharm") then
		extras.CritBonus += Perks.LuckyCharmCrit
	end
	if data and data.BoostEnds > now() then
		extras.CoinMult *= Perks.BoostMult
	end
	if data then
		local coins, growth, launch = 0, 0, 0
		for _, uid in data.Equipped do
			local owned = data.Pets[uid]
			local pet = owned and Pets.ById[owned.P]
			if pet then
				coins += pet.Coins
				growth += pet.Growth
				launch += pet.Launch
			end
		end
		local petPower = Config.PetPowerMult(data.Owned)
		coins = coins * petPower + #Pets.CompletedEggs(data.Index) * Pets.IndexBonus
		extras.CoinMult *= 1 + coins / 100
		extras.GrowthMult *= 1 + growth * petPower / 100
		extras.LaunchMult *= 1 + launch * petPower / 100
	end
	for _, e in Config.Events do
		if eventActive(e.Id) then
			extras.CoinMult *= e.CoinMult or 1
			extras.GrowthMult *= e.GrowthMult or 1
			extras.LaunchMult *= e.LaunchMult or 1
			extras.CritBonus += e.CritBonus or 0
			extras.AirMult *= e.AirMult or 1
			extras.GravityMult *= e.GravityMult or 1
			for _, id in e.Mutations or {} do
				if not table.find(extras.Mutations, id) then
					table.insert(extras.Mutations, id)
				end
			end
		end
	end
	return extras
end

local function statsFor(player: Player)
	local data = profiles[player]
	return Config.ComputeStats(data.Owned, data.Rebirths, data.Skin, extrasFor(player))
end

-- Name tag over the head for VIPs and admins
local function applyNameTag(player: Player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("SnowballTag")
	if old then
		old:Destroy()
	end
	local vip = hasPass(player, "VIP")
	local admin = player:GetAttribute("IsAdmin") == true
	if not vip and not admin then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "SnowballTag"
	gui.Size = UDim2.fromOffset(160, 34)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 120
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = (if admin then "🛡️ ADMIN " else "") .. (if vip then "👑 VIP" else "")
	label.TextColor3 = if vip then Color3.fromRGB(255, 210, 60) else Color3.fromRGB(255, 90, 90)
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(28, 18, 12)
	stroke.Parent = label
	gui.Parent = head
end

local function refreshPassAttributes(player: Player)
	for _, pass in Monetization.Passes do
		player:SetAttribute("Pass_" .. pass.Key, hasPass(player, pass.Key))
	end
	applyNameTag(player)
end

local function updateLeaderstats(player: Player)
	local data = profiles[player]
	local stats = player:FindFirstChild("leaderstats")
	if not data or not stats then
		return
	end
	stats.Coins.Value = math.floor(data.Coins)
	stats.Best.Value = math.floor(data.BestEarn)
end

local function push(player: Player)
	local data = profiles[player]
	if data then
		DataChanged:FireClient(player, data)
		updateLeaderstats(player)
	end
end

local function notify(player: Player?, kind: string, payload: any)
	if player then
		Notify:FireClient(player, kind, payload)
	else
		Notify:FireAllClients(kind, payload)
	end
end

local function startEvent(id: string, minutes: number, by: string, extend: boolean)
	local def = Config.EventById[id]
	if not def then
		return false
	end
	local current = GameState:GetAttribute("Event_" .. id)
	local base = if extend and type(current) == "number" and current > now() then current else now()
	GameState:SetAttribute("Event_" .. id, base + minutes * 60)
	notify(nil, "EventStarted", { Id = id, By = by, Minutes = minutes })
	return true
end

local function stopEvent(id: string)
	if eventActive(id) then
		GameState:SetAttribute("Event_" .. id, 0)
		notify(nil, "EventEnded", { Id = id })
	end
end

local Crazy = Config.CrazyEvents
local baseGravity = Workspace.Gravity

-- expire storms, low gravity during the Galaxy Event
task.spawn(function()
	while true do
		task.wait(1)
		for _, e in Config.Events do
			local ends = GameState:GetAttribute("Event_" .. e.Id)
			if type(ends) == "number" and ends > 0 and ends <= now() then
				GameState:SetAttribute("Event_" .. e.Id, 0)
				notify(nil, "EventEnded", { Id = e.Id })
			end
		end
		local gravity = if eventActive("Galaxy") then baseGravity * Crazy.LobbyGravity else baseGravity
		if Workspace.Gravity ~= gravity then
			Workspace.Gravity = gravity
		end
	end
end)

----------------------------------------------------------------------
-- Crazy events (Meteor Shower, Galaxy Event): a big countdown for the
-- whole server, then the event. They also start by themselves.
----------------------------------------------------------------------
GameState:SetAttribute("CrazyAuto", Crazy.Auto)
GameState:SetAttribute("CrazyIncoming", "")
GameState:SetAttribute("CrazyIncomingAt", 0)
GameState:SetAttribute("NextCrazy", 0)

local function crazyBusy(): boolean
	if GameState:GetAttribute("CrazyIncoming") ~= "" then
		return true
	end
	for _, e in Config.Events do
		if e.Crazy and eventActive(e.Id) then
			return true
		end
	end
	return false
end

local function startCrazy(id: string, minutes: number, by: string): (boolean, string?)
	local def = Config.EventById[id]
	if not def or not def.Crazy then
		return false, "Unknown event"
	end
	if GameState:GetAttribute("CrazyIncoming") ~= "" then
		return false, "An event is already starting!"
	end
	local at = now() + Crazy.WarningSeconds
	GameState:SetAttribute("CrazyIncoming", id)
	GameState:SetAttribute("CrazyIncomingAt", at)
	notify(nil, "CrazyIncoming", { Id = id, At = at, By = by })
	task.delay(Crazy.WarningSeconds, function()
		if GameState:GetAttribute("CrazyIncoming") ~= id then
			return -- cancelled by an admin
		end
		GameState:SetAttribute("CrazyIncoming", "")
		GameState:SetAttribute("CrazyIncomingAt", 0)
		startEvent(id, minutes, by, true)
	end)
	return true, nil
end

local function cancelCrazyCountdown()
	GameState:SetAttribute("CrazyIncoming", "")
	GameState:SetAttribute("CrazyIncomingAt", 0)
end

-- automatic crazy events
task.spawn(function()
	while true do
		GameState:SetAttribute("NextCrazy", now() + rng:NextNumber(Crazy.MinMinutes, Crazy.MaxMinutes) * 60)
		while now() < (GameState:GetAttribute("NextCrazy") or 0) do
			task.wait(1)
		end
		if GameState:GetAttribute("CrazyAuto") == true and not crazyBusy() then
			startCrazy(Crazy.Pool[rng:NextInteger(1, #Crazy.Pool)], Crazy.Minutes, "the Mountain")
		end
	end
end)

-- Meteor Shower: meteors crash into the lobby and leave shards worth coins
local shardFolder = Instance.new("Folder")
shardFolder.Name = "MeteorShards"
shardFolder.Parent = Workspace
local LOBBY_Y = CourseGen.Origin.Y

local function spawnShard(pos: Vector3)
	local shard = Instance.new("Part")
	shard.Name = "MeteorShard"
	shard.Anchored = true
	shard.CanCollide = false
	shard.CanQuery = false
	shard.Size = Vector3.new(2.6, 4.2, 2.6)
	shard.CFrame = CFrame.new(pos + Vector3.new(0, 2.4, 0)) * CFrame.Angles(0.25, rng:NextNumber(0, 6.28), 0.2)
	shard.Material = Enum.Material.Neon
	shard.Color = Color3.fromRGB(255, 120, 30)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 40)
	light.Range = 16
	light.Brightness = 3
	light.Parent = shard
	local fire = Instance.new("ParticleEmitter")
	fire.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 70, 20))
	fire.LightEmission = 1
	fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	fire.Lifetime = NumberRange.new(0.6, 1.1)
	fire.Rate = 20
	fire.Speed = NumberRange.new(3, 7)
	fire.SpreadAngle = Vector2.new(25, 25)
	fire.Parent = shard
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(120, 40)
	tag.StudsOffset = Vector3.new(0, 4, 0)
	tag.MaxDistance = 80
	tag.LightInfluence = 0
	tag.AlwaysOnTop = true
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "☄️ GRAB!"
	label.TextColor3 = Color3.fromRGB(255, 200, 80)
	label.Parent = tag
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(40, 10, 0)
	stroke.Parent = label
	tag.Parent = shard
	shard.Parent = shardFolder

	local taken = false
	shard.Touched:Connect(function(hit)
		if taken then
			return
		end
		local character = hit:FindFirstAncestorOfClass("Model")
		local p = character and Players:GetPlayerFromCharacter(character)
		local data = p and profiles[p]
		if not p or not data then
			return
		end
		taken = true
		local coins = math.max(Crazy.ShardMinCoins, math.floor(data.BestEarn * Crazy.ShardBestShare))
		data.Coins += coins
		data.TotalEarned += coins
		push(p)
		notify(p, "Shard", { Coins = coins })
		shard:Destroy()
	end)
	Debris:AddItem(shard, Crazy.ShardLifetime)
end

task.spawn(function()
	while true do
		task.wait(Crazy.ShardEvery)
		if eventActive("Meteor") then
			local pos = Vector3.new(rng:NextNumber(-82, 82), LOBBY_Y, rng:NextNumber(8, 124))
			local fall = 1.4
			notify(nil, "Meteor", { Pos = pos, At = now() + fall })
			task.delay(fall, function()
				spawnShard(pos)
			end)
		elseif #shardFolder:GetChildren() > 0 and not eventActive("Meteor") then
			shardFolder:ClearAllChildren()
		end
	end
end)

----------------------------------------------------------------------
-- Pets
----------------------------------------------------------------------
local leaderboardDirty = {}

local function equipSlots(player: Player): number
	return Pets.BaseEquipSlots + (if hasPass(player, "ExtraPets") then Pets.ExtraSlotsPass else 0)
end

-- Lucky Eggs pass x Hatch Luck upgrades x events (Galaxy Event)
local function hatchLuck(player: Player, data): number
	local luck = (if hasPass(player, "LuckyEggs") then Perks.LuckyEggsLuck else 1) * Config.HatchLuckMult(data.Owned)
	for _, e in Config.Events do
		if e.HatchLuck and eventActive(e.Id) then
			luck *= e.HatchLuck
		end
	end
	return luck
end

local function petCount(data): number
	local n = 0
	for _ in data.Pets do
		n += 1
	end
	return n
end

-- other clients draw everyone's equipped pets from this attribute
local function updatePetAttribute(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	local ids = {}
	for _, uid in data.Equipped do
		local owned = data.Pets[uid]
		if owned then
			table.insert(ids, owned.P)
		end
	end
	player:SetAttribute("EquippedPets", table.concat(ids, ","))
end

local function cleanEquipped(player: Player, data)
	local slots = equipSlots(player)
	local clean = {}
	for _, uid in data.Equipped do
		if data.Pets[uid] and #clean < slots and not table.find(clean, uid) then
			table.insert(clean, uid)
		end
	end
	data.Equipped = clean
end

-- adds a pet to the inventory (auto-equips it if there is a free slot)
givePet = function(player: Player, data, petId: string, autoEquip: boolean?): string
	local uid = "p" .. data.NextPetId
	data.NextPetId += 1
	data.Pets[uid] = { P = petId, L = false }
	data.Index[petId] = true
	if autoEquip ~= false and #data.Equipped < equipSlots(player) then
		table.insert(data.Equipped, uid)
	end
	updatePetAttribute(player)
	return uid
end

local function grantReward(player: Player, data, reward)
	local hatched = nil
	data.Coins += reward.Coins or 0
	data.Turbos += reward.Turbos or 0
	data.Candy += reward.Candy or 0
	data.Presents += reward.Presents or 0
	if reward.Egg and Pets.EggById[reward.Egg] then
		hatched = Pets.Roll(reward.Egg, hatchLuck(player, data), rng)
		givePet(player, data, hatched)
	end
	return hatched
end

----------------------------------------------------------------------
-- Players joining / leaving
----------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = leaderstats
	local best = Instance.new("IntValue")
	best.Name = "Best"
	best.Parent = leaderstats
	leaderstats.Parent = player

	player:SetAttribute("IsAdmin", isAdmin(player))

	-- which game passes does this player own on Roblox?
	robloxOwned[player] = {}
	for _, pass in Monetization.Passes do
		if pass.Id ~= 0 then
			task.spawn(function()
				local ok, owns = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
				end)
				if ok and owns and robloxOwned[player] then
					robloxOwned[player][pass.Key] = true
					refreshPassAttributes(player)
				end
			end)
		end
	end

	local saved = nil
	if store then
		local ok, result = pcall(function()
			return store:GetAsync("p_" .. player.UserId)
		end)
		if ok then
			saved = result
			loaded[player] = true
		else
			warn("[SnowballSmash] Load failed for", player.Name, result)
		end
	end
	if player.Parent == nil then
		return
	end
	profiles[player] = merge(saved)
	cleanEquipped(player, profiles[player])
	refreshPassAttributes(player)
	updatePetAttribute(player)
	push(player)

	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Head", 10)
		applyNameTag(player)
	end)
	if player.Character then
		applyNameTag(player)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	save(player)
	profiles[player] = nil
	loaded[player] = nil
	activeRuns[player] = nil
	robloxOwned[player] = nil
	leaderboardDirty[player] = nil
end)

game:BindToClose(function()
	if RunService:IsStudio() then
		task.wait(1)
	end
	for _, player in Players:GetPlayers() do
		task.spawn(save, player)
	end
	task.wait(2)
end)

task.spawn(function()
	while true do
		task.wait(90)
		for _, player in Players:GetPlayers() do
			task.spawn(save, player)
		end
	end
end)

----------------------------------------------------------------------
-- Robux purchases
----------------------------------------------------------------------
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	local pass = Monetization.PassById[passId]
	if pass and robloxOwned[player] then
		robloxOwned[player][pass.Key] = true
		refreshPassAttributes(player)
		push(player)
		notify(player, "Purchased", { Name = pass.Name, Icon = pass.Icon })
	end
end)

local function grantProduct(player: Player, data, product)
	if product.Kind == "Coins" then
		data.Coins += product.Amount
	elseif product.Kind == "Boost" then
		data.BoostEnds = math.max(data.BoostEnds, now()) + product.Minutes * 60
	elseif product.Kind == "Turbo" then
		data.Turbos += product.Amount
	elseif product.Kind == "ServerBoost" then
		startEvent("Coins2", product.Minutes, player.DisplayName, true)
	elseif product.Kind == "Candy" then
		data.Candy += product.Amount
	elseif product.Kind == "Presents" then
		data.Presents += product.Amount
	elseif product.Kind == "LegendaryPet" then
		local petId = Pets.RollLegendary(rng)
		givePet(player, data, petId, true)
		notify(player, "PetGranted", { Pets = { petId } })
	end
end

MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = waitForData(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if data.Receipts[info.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local product = Monetization.ProductById[info.ProductId]
	if not product then
		warn("[SnowballSmash] Unknown developer product", info.ProductId, "- add its id in Monetization")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	grantProduct(player, data, product)
	data.Receipts[info.PurchaseId] = true
	table.insert(data.ReceiptOrder, info.PurchaseId)
	while #data.ReceiptOrder > 50 do
		data.Receipts[table.remove(data.ReceiptOrder, 1)] = nil
	end
	push(player)
	save(player)
	notify(player, "Purchased", { Name = product.Name, Icon = product.Icon })
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

