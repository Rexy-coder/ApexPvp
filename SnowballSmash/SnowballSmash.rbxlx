SPECS.CrystalGolem = { Body = rgb(110, 220, 255), Cube = true, Size = Vector3.new(2.4, 2.3, 2.1), Material = Enum.Material.Glass, Transparency = 0.1, EyeGlow = true, Eye = rgb(220, 255, 255), NoBlush = true, Extra = function(m, ctx)
