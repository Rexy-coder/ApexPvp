    <Item class="Script" referent="785">
      <Properties>
        <string name="Name">GameServer</string>
        <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: server. Owns player data (coins, upgrades, skins, settings,
-- turbos, boosts), validates run results, handles Robux purchases, server
-- storms and the admin panel, and saves everything to a DataStore.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local TextService = game:GetService("TextService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Monetization = require(Shared:WaitForChild("Monetization"))
local CourseGen = require(Shared:WaitForChild("CourseGen"))
local AdminConfig = require(script.Parent:WaitForChild("AdminConfig"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameState = ReplicatedStorage:WaitForChild("GameState")

local GetData = Remotes:WaitForChild("GetData") :: RemoteFunction
local DataChanged = Remotes:WaitForChild("DataChanged") :: RemoteEvent
local StartRun = Remotes:WaitForChild("StartRun") :: RemoteFunction
local FinishRun = Remotes:WaitForChild("FinishRun") :: RemoteFunction
local BuyUpgrade = Remotes:WaitForChild("BuyUpgrade") :: RemoteFunction
local BuySkin = Remotes:WaitForChild("BuySkin") :: RemoteFunction
local DoRebirth = Remotes:WaitForChild("Rebirth") :: RemoteFunction
local SetSetting = Remotes:WaitForChild("SetSetting") :: RemoteEvent
local UseTurbo = Remotes:WaitForChild("UseTurbo") :: RemoteFunction
local AdminAction = Remotes:WaitForChild("AdminAction") :: RemoteFunction
local Notify = Remotes:WaitForChild("Notify") :: RemoteEvent

local P = Config.Physics
local Perks = Monetization.Perks

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- The preview slope that is only there so the map shows in Studio's editor;
-- the real endless course is generated by every client.
local course = Workspace:FindFirstChild("Course")
local preview = course and course:FindFirstChild("Preview")
if preview then
	preview:Destroy()
end

----------------------------------------------------------------------
-- Data
----------------------------------------------------------------------
local function defaultData()
	return {
		Coins = 0,
		BestEarn = 0,
		BestDistance = 0,
		BestCombo = 0,
		Runs = 0,
		TotalSmashed = 0,
		TotalEarned = 0,
		Rebirths = 0,
		Owned = {},
		Skins = { Classic = true },
		Skin = "Classic",
		Settings = { Music = true, SFX = true, Shake = true, SpeedLines = true, Hints = true, PerfectPush = true },
		Turbos = 0,
		BoostEnds = 0,
		GrantedPasses = {}, -- passes given by an admin
		Receipts = {}, -- PurchaseId -> true (so a purchase is never granted twice)
		ReceiptOrder = {},
	}
end

local SETTING_KEYS = { Music = true, SFX = true, Shake = true, SpeedLines = true, Hints = true, PerfectPush = true }

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("SnowballSmash_v1")
	end)
	if ok then
		store = result
	else
		warn("[SnowballSmash] DataStore unavailable, progress will not save:", result)
	end
end

local profiles = {}
local loaded = {}
local activeRuns = {}

local function merge(saved)
	local data = defaultData()
	if type(saved) ~= "table" then
		return data
	end
	for key, value in saved do
		if data[key] ~= nil and type(value) == type(data[key]) then
			if type(value) == "table" then
				for k, v in value do
					data[key][k] = v
				end
			else
				data[key] = value
			end
		end
	end
	return data
end

local function save(player: Player)
	local data = profiles[player]
	if not data or not store or not loaded[player] then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync("p_" .. player.UserId, data)
	end)
	if not ok then
		warn("[SnowballSmash] Save failed for", player.Name, err)
	end
end

local function waitForData(player: Player)
	local t = 0
	while not profiles[player] and t < 15 and player.Parent do
		t += task.wait(0.1)
	end
	return profiles[player]
end

----------------------------------------------------------------------
-- Passes, admins, events
----------------------------------------------------------------------
local robloxOwned = {} -- [player] = { [passKey] = true }

local function hasPass(player: Player, key: string): boolean
	if Monetization.StudioOwnsAllPasses and RunService:IsStudio() then
		return true
	end
	local data = profiles[player]
	if data and data.GrantedPasses[key] then
		return true
	end
	local owned = robloxOwned[player]
	return owned ~= nil and owned[key] == true
end

local function isAdmin(player: Player): boolean
	if AdminConfig.StudioEveryoneIsAdmin and RunService:IsStudio() then
		return true
	end
	if AdminConfig.CreatorIsAdmin and game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	return table.find(AdminConfig.Admins, player.UserId) ~= nil
end

local function eventActive(id: string): boolean
	local ends = GameState:GetAttribute("Event_" .. id)
	return type(ends) == "number" and ends > now()
end

local function extrasFor(player: Player)
	local data = profiles[player]
	local extras = { CoinMult = 1, GrowthMult = 1, LaunchMult = 1, CritBonus = 0, StartRadiusBonus = 0, Mutation = false }
	if hasPass(player, "VIP") then
		extras.CoinMult *= 1 + Perks.VIPCoinBonus
	end
	if hasPass(player, "DoubleCoins") then
		extras.CoinMult *= Perks.DoubleCoinsMult
	end
	if hasPass(player, "MegaStart") then
		extras.StartRadiusBonus = Perks.MegaStartRadius
	end
	if hasPass(player, "LuckyCharm") then
		extras.CritBonus += Perks.LuckyCharmCrit
	end
	if data and data.BoostEnds > now() then
		extras.CoinMult *= Perks.BoostMult
	end
	for _, e in Config.Events do
		if eventActive(e.Id) then
			extras.CoinMult *= e.CoinMult or 1
			extras.GrowthMult *= e.GrowthMult or 1
			extras.LaunchMult *= e.LaunchMult or 1
			extras.CritBonus += e.CritBonus or 0
			if e.Mutation then
				extras.Mutation = true
			end
		end
	end
	return extras
end

local function statsFor(player: Player)
	local data = profiles[player]
	return Config.ComputeStats(data.Owned, data.Rebirths, data.Skin, extrasFor(player))
end

-- Name tag over the head for VIPs and admins
local function applyNameTag(player: Player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("SnowballTag")
	if old then
		old:Destroy()
	end
	local vip = hasPass(player, "VIP")
	local admin = player:GetAttribute("IsAdmin") == true
	if not vip and not admin then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "SnowballTag"
	gui.Size = UDim2.fromOffset(160, 34)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 120
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = (if admin then "🛡️ ADMIN " else "") .. (if vip then "👑 VIP" else "")
	label.TextColor3 = if vip then Color3.fromRGB(255, 210, 60) else Color3.fromRGB(255, 90, 90)
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.fromRGB(28, 18, 12)
	stroke.Parent = label
	gui.Parent = head
end

local function refreshPassAttributes(player: Player)
	for _, pass in Monetization.Passes do
		player:SetAttribute("Pass_" .. pass.Key, hasPass(player, pass.Key))
	end
	applyNameTag(player)
end

local function updateLeaderstats(player: Player)
	local data = profiles[player]
	local stats = player:FindFirstChild("leaderstats")
	if not data or not stats then
		return
	end
	stats.Coins.Value = math.floor(data.Coins)
	stats.Best.Value = math.floor(data.BestEarn)
end

local function push(player: Player)
	local data = profiles[player]
	if data then
		DataChanged:FireClient(player, data)
		updateLeaderstats(player)
	end
end

local function notify(player: Player?, kind: string, payload: any)
	if player then
		Notify:FireClient(player, kind, payload)
	else
		Notify:FireAllClients(kind, payload)
	end
end

local function startEvent(id: string, minutes: number, by: string, extend: boolean)
	local def = Config.EventById[id]
	if not def then
		return false
	end
	local current = GameState:GetAttribute("Event_" .. id)
	local base = if extend and type(current) == "number" and current > now() then current else now()
	GameState:SetAttribute("Event_" .. id, base + minutes * 60)
	notify(nil, "EventStarted", { Id = id, By = by, Minutes = minutes })
	return true
end

local function stopEvent(id: string)
	if eventActive(id) then
		GameState:SetAttribute("Event_" .. id, 0)
		notify(nil, "EventEnded", { Id = id })
	end
end

-- expire storms
task.spawn(function()
	while true do
		task.wait(1)
		for _, e in Config.Events do
			local ends = GameState:GetAttribute("Event_" .. e.Id)
			if type(ends) == "number" and ends > 0 and ends <= now() then
				GameState:SetAttribute("Event_" .. e.Id, 0)
				notify(nil, "EventEnded", { Id = e.Id })
			end
		end
	end
end)

----------------------------------------------------------------------
-- Players joining / leaving
----------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Parent = leaderstats
	local best = Instance.new("IntValue")
	best.Name = "Best"
	best.Parent = leaderstats
	leaderstats.Parent = player

	player:SetAttribute("IsAdmin", isAdmin(player))

	-- which game passes does this player own on Roblox?
	robloxOwned[player] = {}
	for _, pass in Monetization.Passes do
		if pass.Id ~= 0 then
			task.spawn(function()
				local ok, owns = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
				end)
				if ok and owns and robloxOwned[player] then
					robloxOwned[player][pass.Key] = true
					refreshPassAttributes(player)
				end
			end)
		end
	end

	local saved = nil
	if store then
		local ok, result = pcall(function()
			return store:GetAsync("p_" .. player.UserId)
		end)
		if ok then
			saved = result
			loaded[player] = true
		else
			warn("[SnowballSmash] Load failed for", player.Name, result)
		end
	end
	if player.Parent == nil then
		return
	end
	profiles[player] = merge(saved)
	refreshPassAttributes(player)
	push(player)

	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Head", 10)
		applyNameTag(player)
	end)
	if player.Character then
		applyNameTag(player)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	save(player)
	profiles[player] = nil
	loaded[player] = nil
	activeRuns[player] = nil
	robloxOwned[player] = nil
end)

game:BindToClose(function()
	if RunService:IsStudio() then
		task.wait(1)
	end
	for _, player in Players:GetPlayers() do
		task.spawn(save, player)
	end
	task.wait(2)
end)

task.spawn(function()
	while true do
		task.wait(90)
		for _, player in Players:GetPlayers() do
			task.spawn(save, player)
		end
	end
end)

----------------------------------------------------------------------
-- Robux purchases
----------------------------------------------------------------------
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	local pass = Monetization.PassById[passId]
	if pass and robloxOwned[player] then
		robloxOwned[player][pass.Key] = true
		refreshPassAttributes(player)
		push(player)
		notify(player, "Purchased", { Name = pass.Name, Icon = pass.Icon })
	end
end)

local function grantProduct(player: Player, data, product)
	if product.Kind == "Coins" then
		data.Coins += product.Amount
	elseif product.Kind == "Boost" then
		data.BoostEnds = math.max(data.BoostEnds, now()) + product.Minutes * 60
	elseif product.Kind == "Turbo" then
		data.Turbos += product.Amount
	elseif product.Kind == "ServerBoost" then
		startEvent("Coins2", product.Minutes, player.DisplayName, true)
	end
end

MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = waitForData(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if data.Receipts[info.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local product = Monetization.ProductById[info.ProductId]
	if not product then
		warn("[SnowballSmash] Unknown developer product", info.ProductId, "- add its id in Monetization")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	grantProduct(player, data, product)
	data.Receipts[info.PurchaseId] = true
	table.insert(data.ReceiptOrder, info.PurchaseId)
	while #data.ReceiptOrder > 50 do
		data.Receipts[table.remove(data.ReceiptOrder, 1)] = nil
	end
	push(player)
	save(player)
	notify(player, "Purchased", { Name = product.Name, Icon = product.Icon })
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

----------------------------------------------------------------------
-- Gameplay remotes
----------------------------------------------------------------------
GetData.OnServerInvoke = function(player)
	return waitForData(player)
end

StartRun.OnServerInvoke = function(player)
	local data = profiles[player]
	if not data then
		return nil
	end
	local stats = statsFor(player)
	activeRuns[player] = { Started = os.clock(), Stats = stats, Turbos = 0 }
	return stats
end

UseTurbo.OnServerInvoke = function(player)
	local data = profiles[player]
	local run = activeRuns[player]
	if not data or not run or data.Turbos <= 0 then
		return false
	end
	data.Turbos -= 1
	run.Turbos += 1
	push(player)
	return true
end

FinishRun.OnServerInvoke = function(player, report)
	local data = profiles[player]
	local run = activeRuns[player]
	activeRuns[player] = nil
	if not data or not run or type(report) ~= "table" then
		return nil
	end

	local elapsed = os.clock() - run.Started
	local stats = run.Stats

	local distance = math.max(0, tonumber(report.Distance) or 0)
	distance = math.min(distance, elapsed * P.MaxSpeed * 1.25 + 40)
	if distance ~= distance then
		distance = 0
	end
	local smashed = math.clamp(math.floor(tonumber(report.Smashed) or 0), 0, CourseGen.CountUpTo(distance + 50))
	local combo = math.clamp(math.floor(tonumber(report.BestCombo) or 0), 0, 9999)

	-- Generous upper bound: everything on the course so far smashed at max combo,
	-- max size, always critical and (during a Mutation Storm) always Diamond.
	local sizeBonusMax = 1 + (stats.MaxRadius - P.StartRadius) / P.SizeBonusDiv
	local mutation = if stats.Mutation then Config.MaxMutationMult else 1
	local cap = CourseGen.ValueUpTo(distance + 50, P.PickupValue) * P.MaxCombo * sizeBonusMax * 2 * mutation * stats.CoinMult
	local smashCoins = math.clamp(tonumber(report.SmashCoins) or 0, 0, cap)
	if smashCoins ~= smashCoins then
		smashCoins = 0
	end
	local distanceCoins = distance * P.DistanceCoinRate * stats.CoinMult
	local earned = math.floor(smashCoins + distanceCoins)

	local newBest = earned > data.BestEarn
	data.Coins += earned
	data.TotalEarned += earned
	data.Runs += 1
	data.TotalSmashed += smashed
	data.BestEarn = math.max(data.BestEarn, earned)
	data.BestDistance = math.max(data.BestDistance, math.floor(distance))
	data.BestCombo = math.max(data.BestCombo, combo)
	push(player)

	return {
		Earned = earned,
		NewBest = newBest,
		Distance = math.floor(distance),
		Smashed = smashed,
		Combo = combo,
	}
end

BuyUpgrade.OnServerInvoke = function(player, nodeId)
	local data = profiles[player]
	if not data or type(nodeId) ~= "string" then
		return false, "Not ready"
	end
	local ok, reason = Config.CanBuy(data.Owned, nodeId)
	if not ok then
		return false, reason
	end
	local node = Config.Nodes[nodeId]
	if data.Coins < node.Cost then
		return false, "Not enough coins!"
	end
	data.Coins -= node.Cost
	data.Owned[nodeId] = true
	push(player)
	return true, nil
end

BuySkin.OnServerInvoke = function(player, skinId)
	local data = profiles[player]
	local skin = if type(skinId) == "string" then Config.SkinById[skinId] else nil
	if not data or not skin then
		return false, "Not ready"
	end
	if skin.Pass then
		if not hasPass(player, skin.Pass) then
			return false, "Needs the " .. Monetization.PassByKey[skin.Pass].Name .. " pass!"
		end
		data.Skins[skin.Id] = true
	elseif not data.Skins[skin.Id] then
		if data.Coins < skin.Price then
			return false, "Not enough coins!"
		end
		data.Coins -= skin.Price
		data.Skins[skin.Id] = true
	end
	data.Skin = skin.Id
	push(player)
	return true, nil
end

DoRebirth.OnServerInvoke = function(player)
	local data = profiles[player]
	if not data then
		return false, "Not ready"
	end
	local cost = Config.RebirthCost(data.Rebirths)
	if data.Coins < cost then
		return false, "You need " .. Config.Commas(cost) .. " coins to rebirth!"
	end
	data.Coins = 0
	data.Owned = {}
	data.Rebirths += 1
	push(player)
	return true, nil
end

SetSetting.OnServerEvent:Connect(function(player, key, value)
	local data = profiles[player]
	if data and type(key) == "string" and SETTING_KEYS[key] and type(value) == "boolean" then
		data.Settings[key] = value
	end
end)

----------------------------------------------------------------------
-- Admin panel
----------------------------------------------------------------------
local lastAnnounce = {}

local function findPlayer(admin: Player, query): Player?
	if type(query) ~= "string" or query == "" or string.lower(query) == "me" then
		return admin
	end
	local q = string.lower(query)
	for _, p in Players:GetPlayers() do
		if string.lower(p.Name) == q or string.lower(p.DisplayName) == q then
			return p
		end
	end
	for _, p in Players:GetPlayers() do
		if string.sub(string.lower(p.Name), 1, #q) == q or string.sub(string.lower(p.DisplayName), 1, #q) == q then
			return p
		end
	end
	return nil
end

local function filterBroadcast(text: string, from: Player): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, from.UserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok then
		return result
	end
	if RunService:IsStudio() then
		return text -- filtering is not available in some Studio sessions
	end
	return nil
end

local actions = {}

actions.Announce = function(admin: Player, args)
	local text = tostring(args.Text or "")
	text = string.sub(string.gsub(text, "^%s+", ""), 1, AdminConfig.MaxAnnouncementLength)
	if text == "" then
		return false, "Type a message first"
	end
	if lastAnnounce[admin] and os.clock() - lastAnnounce[admin] < 3 then
		return false, "Wait a moment between announcements"
	end
	local filtered = filterBroadcast(text, admin)
	if not filtered then
		return false, "Could not filter the message, try again"
	end
	lastAnnounce[admin] = os.clock()
	notify(nil, "Announcement", { Text = filtered, From = admin.DisplayName })
	return true, "Announcement sent!"
end

actions.StartEvent = function(admin: Player, args)
	local minutes = math.clamp(tonumber(args.Minutes) or 5, 1, 240)
	if not Config.EventById[args.Id] then
		return false, "Unknown storm"
	end
	startEvent(args.Id, minutes, admin.DisplayName, false)
	return true, Config.EventById[args.Id].Name .. " started for " .. minutes .. " min"
end

actions.StopEvent = function(_admin: Player, args)
	if args.Id == "All" then
		for _, e in Config.Events do
			stopEvent(e.Id)
		end
		return true, "All storms stopped"
	end
	stopEvent(args.Id)
	return true, "Storm stopped"
end

actions.GiveCoins = function(admin: Player, args)
	local target = findPlayer(admin, args.Target)
	local amount = math.floor(tonumber(args.Amount) or 0)
	if not target or not profiles[target] then
		return false, "Player not found"
	end
	if amount == 0 or amount ~= amount then
		return false, "Enter an amount"
	end
	amount = math.clamp(amount, -1e15, 1e15)
	local data = profiles[target]
	data.Coins = math.max(0, data.Coins + amount)
	push(target)
	if target ~= admin then
		notify(target, "Gift", { Text = "An admin gave you " .. Config.Commas(amount) .. " coins!" })
	end
	return true, "Gave " .. Config.Commas(amount) .. " coins to " .. target.DisplayName
end

actions.GiveTurbos = function(admin: Player, args)
	local target = findPlayer(admin, args.Target)
	local amount = math.clamp(math.floor(tonumber(args.Amount) or 5), 1, 1000)
	if not target or not profiles[target] then
		return false, "Player not found"
	end
	profiles[target].Turbos += amount
	push(target)
	if target ~= admin then
		notify(target, "Gift", { Text = "An admin gave you " .. amount .. " Turbos!" })
	end
	return true, "Gave " .. amount .. " Turbos to " .. target.DisplayName
end

actions.SetPass = function(admin: Player, args)
	local target = findPlayer(admin, args.Target)
	local pass = Monetization.PassByKey[args.Pass]
	if not target or not profiles[target] then
		return false, "Player not found"
	end
	if not pass then
		return false, "Unknown pass"
	end
	local give = args.Give == true
	profiles[target].GrantedPasses[pass.Key] = if give then true else nil
	refreshPassAttributes(target)
	push(target)
	if give and target ~= admin then
		notify(target, "Gift", { Text = "An admin gave you the " .. pass.Name .. " pass! " .. pass.Icon })
	end
	return true, (if give then "Gave " else "Removed ") .. pass.Name .. (if give then " to " else " from ") .. target.DisplayName
end

AdminAction.OnServerInvoke = function(player, action, args)
	if not isAdmin(player) then
		return false, "You are not an admin"
	end
	local handler = actions[action]
	if type(action) ~= "string" or not handler then
		return false, "Unknown action"
	end
	return handler(player, if type(args) == "table" then args else {})
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="786">
      <Properties>
        <string name="Name">AdminConfig</string>
        <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: who can open the Admin Panel.
--
-- Put Roblox user ids in Admins (find yours in your profile URL:
-- roblox.com/users/<USER ID>/profile).

local AdminConfig = {}

AdminConfig.Admins = {
	0, -- << your user id here
	-- 12345678,
}

-- The owner of the game (user-owned games) is always an admin.
AdminConfig.CreatorIsAdmin = true

-- Everyone is admin while testing in Roblox Studio.
AdminConfig.StudioEveryoneIsAdmin = true

-- Longest announcement allowed
AdminConfig.MaxAnnouncementLength = 140

-- Choices shown in the panel for how long a storm lasts (minutes)
AdminConfig.Durations = { 1, 5, 15, 30 }

return AdminConfig
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="787">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">80</float>
      <float name="CharacterWalkSpeed">20</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="788">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="789">
        <Properties>
          <string name="Name">SnowballClient</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: client entry point. Wires the HUD, menus, shop, admin panel,
-- upgrade tree and the run together and talks to the server.

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local MarketplaceService = game:GetService("MarketplaceService")
local TextChatService = game:GetService("TextChatService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameState = ReplicatedStorage:WaitForChild("GameState")

local Config = require(Shared:WaitForChild("Config"))
local Monetization = require(Shared:WaitForChild("Monetization"))
local UIKit = require(script:WaitForChild("UIKit"))
local Effects = require(script:WaitForChild("Effects"))
local Hud = require(script:WaitForChild("Hud"))
local Panels = require(script:WaitForChild("Panels"))
local UpgradeTree = require(script:WaitForChild("UpgradeTree"))
local Runner = require(script:WaitForChild("Runner"))

local C = UIKit.Colors

local GetData = Remotes:WaitForChild("GetData") :: RemoteFunction
local DataChanged = Remotes:WaitForChild("DataChanged") :: RemoteEvent
local StartRun = Remotes:WaitForChild("StartRun") :: RemoteFunction
local FinishRun = Remotes:WaitForChild("FinishRun") :: RemoteFunction
local BuyUpgrade = Remotes:WaitForChild("BuyUpgrade") :: RemoteFunction
local BuySkin = Remotes:WaitForChild("BuySkin") :: RemoteFunction
local DoRebirth = Remotes:WaitForChild("Rebirth") :: RemoteFunction
local SetSetting = Remotes:WaitForChild("SetSetting") :: RemoteEvent
local UseTurbo = Remotes:WaitForChild("UseTurbo") :: RemoteFunction
local AdminAction = Remotes:WaitForChild("AdminAction") :: RemoteFunction
local Notify = Remotes:WaitForChild("Notify") :: RemoteEvent

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function hasPass(key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true
end

local function errorToast(text: string)
	Hud.toast(text, C.Red)
	Effects.play("Error", 1)
end

----------------------------------------------------------------------
-- Player data
----------------------------------------------------------------------
local data = nil
local refreshBoosts = function() end

local function apply(newData)
	if type(newData) ~= "table" then
		return
	end
	local first = data == nil
	data = newData
	for key, value in newData.Settings do
		Effects.Settings[key] = value
	end
	Hud.setCoins(newData.Coins, first)
	Hud.setBest(newData.BestEarn)
	Hud.setTurbos(newData.Turbos or 0)
	Panels.refresh(newData)
	UpgradeTree.refresh(newData)
	Hud.setAlert("Upgrades", UpgradeTree.anyAffordable(newData))
	Hud.setAlert("Shop", Panels.anySkinAffordable(newData))
	Hud.setAlert("Rebirth", Panels.canRebirth(newData))
	Effects.applyMusic()
	refreshBoosts()
end

DataChanged.OnClientEvent:Connect(apply)
task.spawn(function()
	apply(GetData:InvokeServer())
end)

----------------------------------------------------------------------
-- Game passes (owned / given by an admin) come in as player attributes
----------------------------------------------------------------------
local function refreshPasses()
	local owned = {}
	for _, pass in Monetization.Passes do
		owned[pass.Key] = hasPass(pass.Key)
	end
	Panels.setPasses(owned)
	Hud.setAdmin(player:GetAttribute("IsAdmin") == true)
	refreshBoosts()
end
player.AttributeChanged:Connect(function(name)
	if string.sub(name, 1, 5) == "Pass_" or name == "IsAdmin" then
		refreshPasses()
	end
end)

-- real Robux prices from Roblox (falls back to the price in Monetization)
for _, pass in Monetization.Passes do
	if pass.Id ~= 0 then
		task.spawn(function()
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(pass.Id, Enum.InfoType.GamePass)
			end)
			if ok and info and info.PriceInRobux then
				Panels.setRobuxPrice(pass.Key, info.PriceInRobux)
			end
		end)
	end
end
for _, product in Monetization.Products do
	if product.Id ~= 0 then
		task.spawn(function()
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(product.Id, Enum.InfoType.Product)
			end)
			if ok and info and info.PriceInRobux then
				Panels.setRobuxPrice(product.Key, info.PriceInRobux)
			end
		end)
	end
end

local function buyRobux(kind: string, key: string)
	local item = if kind == "Pass" then Monetization.PassByKey[key] else Monetization.ProductByKey[key]
	if not item then
		return
	end
	if kind == "Pass" and hasPass(key) then
		Hud.toast("You already own " .. item.Name .. "!", C.Purple)
		return
	end
	if item.Id == 0 then
		errorToast("Coming soon! (add its ID in Shared.Monetization)")
		return
	end
	if kind == "Pass" then
		MarketplaceService:PromptGamePassPurchase(player, item.Id)
	else
		MarketplaceService:PromptProductPurchase(player, item.Id)
	end
end
Panels.Callbacks.BuyRobux = buyRobux

----------------------------------------------------------------------
-- Chat tags: [ADMIN] and [VIP]
----------------------------------------------------------------------
TextChatService.OnIncomingMessage = function(message: TextChatMessage)
	local props = Instance.new("TextChatMessageProperties")
	local source = message.TextSource
	if source then
		local speaker = Players:GetPlayerByUserId(source.UserId)
		if speaker then
			local tags = ""
			if speaker:GetAttribute("IsAdmin") then
				tags ..= '<font color="#FF5A5A">[ADMIN]</font> '
			end
			if speaker:GetAttribute("Pass_VIP") then
				tags ..= '<font color="#FFD23C">[VIP]</font> '
			end
			if tags ~= "" then
				props.PrefixText = tags .. message.PrefixText
			end
		end
	end
	return props
end

local function systemChat(text: string)
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral")
		if general then
			general:DisplaySystemMessage(text)
		end
	end)
end

----------------------------------------------------------------------
-- Boosts, storms and the side list
----------------------------------------------------------------------
local function activeEvents()
	local list = {}
	local t = serverNow()
	for _, e in Config.Events do
		local ends = GameState:GetAttribute("Event_" .. e.Id)
		if type(ends) == "number" and ends > t then
			table.insert(list, { Def = e, EndsAt = ends })
		end
	end
	return list
end

refreshBoosts = function()
	local entries = {}
	if hasPass("VIP") then
		table.insert(entries, { Key = "VIP", Icon = "👑", Text = "VIP +25%", Color = Color3.fromRGB(255, 200, 40) })
	end
	if hasPass("DoubleCoins") then
		table.insert(entries, { Key = "Double", Icon = "💰", Text = "2x Coins", Color = Color3.fromRGB(90, 220, 70) })
	end
	if data and (data.BoostEnds or 0) > serverNow() then
		table.insert(entries, { Key = "Boost", Icon = "⏱️", Text = "x2 Coins", Color = Color3.fromRGB(150, 96, 245), EndsAt = data.BoostEnds })
	end
	local events = activeEvents()
	for _, ev in events do
		table.insert(entries, { Key = "Event_" .. ev.Def.Id, Icon = ev.Def.Icon, Text = ev.Def.Name, Color = ev.Def.Color, EndsAt = ev.EndsAt })
	end
	Hud.setBoosts(entries)

	local mutation = false
	local stormColor = nil
	for _, ev in events do
		stormColor = stormColor or ev.Def.Color
		if ev.Def.Mutation then
			mutation = true
		end
	end
	Effects.setStorm(#events > 0, stormColor)
	Effects.setEventMusic(#events > 0)
	Runner.setMutation(mutation)
end

GameState.AttributeChanged:Connect(function()
	refreshBoosts()
end)
task.spawn(function()
	while true do
		task.wait(1)
		refreshBoosts()
	end
end)

Notify.OnClientEvent:Connect(function(kind: string, payload)
	payload = payload or {}
	if kind == "Announcement" then
		Hud.announce("📢 " .. tostring(payload.From), tostring(payload.Text), C.Yellow)
		systemChat("[ANNOUNCEMENT] " .. tostring(payload.Text))
		Effects.play("Notify", 0.9)
	elseif kind == "EventStarted" then
		local def = Config.EventById[payload.Id]
		if def then
			Hud.announce(def.Icon .. " " .. string.upper(def.Name), def.Desc .. "  (" .. tostring(payload.Minutes) .. " min, by " .. tostring(payload.By) .. ")", def.Color)
			systemChat(def.Name .. " started by " .. tostring(payload.By) .. "!")
			Effects.play("Notify", 1.2)
		end
		refreshBoosts()
	elseif kind == "EventEnded" then
		local def = Config.EventById[payload.Id]
		if def then
			Hud.toast(def.Name .. " is over", C.Slate)
		end
		refreshBoosts()
	elseif kind == "Purchased" then
		Hud.toast("Thank you! " .. tostring(payload.Icon or "") .. " " .. tostring(payload.Name) .. " received!", C.Green)
		Effects.play("Purchase", 1.2)
	elseif kind == "Gift" then
		Hud.announce("🎁 GIFT", tostring(payload.Text), C.Green)
		Effects.play("Purchase", 1.3)
	end
end)

----------------------------------------------------------------------
-- Freeze the character while the snowball is out
----------------------------------------------------------------------
local controls = nil
task.spawn(function()
	local ok, result = pcall(function()
		local module = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10)
		return (require :: any)(module):GetControls()
	end)
	if ok then
		controls = result
	end
end)

local frozen = false
local function freeze(on: boolean)
	frozen = on
	if controls then
		if on then
			controls:Disable()
		else
			controls:Enable()
		end
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		root.Anchored = on
	end
end

player.CharacterAdded:Connect(function(character)
	if frozen then
		local root = character:WaitForChild("HumanoidRootPart", 5)
		if root then
			root.Anchored = true
		end
	end
end)

----------------------------------------------------------------------
-- Game flow: Idle -> Charge -> Rolling -> Result
----------------------------------------------------------------------
local mode = "Idle"
local power = 0
local powerDir = 1
local charging = false

local prompt: ProximityPrompt? = nil
local lobby = Workspace:WaitForChild("Lobby", 10)
local pad = lobby and lobby:FindFirstChild("StartPad", true)
if pad then
	prompt = pad:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function setMode(newMode: string)
	mode = newMode
	if prompt then
		prompt.Enabled = newMode == "Idle"
	end
end

local function startCharge()
	if mode ~= "Idle" and mode ~= "Result" then
		return
	end
	setMode("Starting")
	Panels.closeAll()
	UpgradeTree.close()
	local stats = StartRun:InvokeServer()
	if not stats or not data then
		setMode("Idle")
		errorToast("Still loading, try again!")
		return
	end
	freeze(true)
	Runner.prepare(stats, data.Skin)
	power = 0
	powerDir = 1
	charging = false
	Hud.setPower(0, false)
	Hud.setMode("Charge")
	setMode("Charge")
end

local function backToLobby()
	Panels.hideResult()
	Runner.stop()
	freeze(false)
	Hud.setMode("Idle")
	setMode("Idle")
end

local function cancelCharge()
	if mode ~= "Charge" then
		return
	end
	backToLobby()
end

local function launch()
	if mode ~= "Charge" then
		return
	end
	charging = false
	Runner.launch(math.max(0.05, power))
	Hud.setMode("Rolling")
	setMode("Rolling")
end

local function turbo()
	if mode ~= "Rolling" or not data then
		return
	end
	if (data.Turbos or 0) <= 0 then
		buyRobux("Product", "Turbo5")
		return
	end
	if not Runner.canTurbo() then
		return
	end
	-- fire straight away so it feels instant; the server takes one off the count
	data.Turbos -= 1
	Hud.setTurbos(data.Turbos)
	Runner.turbo()
	Hud.turboFired()
	task.spawn(function()
		UseTurbo:InvokeServer()
	end)
end
Hud.Callbacks.Turbo = turbo

Runner.OnFinish = function(report)
	setMode("Finishing")
	task.spawn(function()
		task.wait(0.6)
		local result = FinishRun:InvokeServer(report)
		if not result then
			result = { Earned = 0, NewBest = false, Distance = report.Distance, Smashed = report.Smashed, Combo = report.BestCombo }
		end
		if result.NewBest and result.Earned > 0 then
			Effects.play("NewBest", 1)
		end
		Hud.setMode("Result")
		setMode("Result")
		Panels.showResult(result, function()
			Panels.hideResult()
			startCharge()
		end, backToLobby)
	end)
end

----------------------------------------------------------------------
-- HUD / menu callbacks
----------------------------------------------------------------------
Hud.Callbacks.Roll = startCharge
Hud.Callbacks.CancelCharge = cancelCharge
Hud.Callbacks.Upgrade = function()
	if mode == "Idle" then
		Panels.closeAll()
		UpgradeTree.open()
		Hud.setMode("Tree")
	end
end
Hud.Callbacks.Menu = function(name: string)
	if mode ~= "Idle" then
		return
	end
	if name == "Upgrades" then
		Hud.Callbacks.Upgrade()
	elseif name == "Index" then
		Hud.toast("Coming soon!", C.Blue)
	else
		Panels.open(name)
	end
end

UpgradeTree.OnClosed = function()
	if mode == "Idle" then
		Hud.setMode("Idle")
	end
end

UpgradeTree.OnBuy = function(nodeId: string)
	local ok, message = BuyUpgrade:InvokeServer(nodeId)
	if ok then
		UpgradeTree.celebrate(nodeId)
		Effects.play("Purchase", 1.5)
	else
		errorToast(message or "Can't buy that yet")
	end
end

Panels.Callbacks.SetSetting = function(key: string, value: boolean)
	Effects.Settings[key] = value
	Panels.refreshSettings()
	SetSetting:FireServer(key, value)
	Effects.applyMusic()
end

Panels.Callbacks.BuySkin = function(id: string)
	local owned = data and data.Skins[id]
	local ok, message = BuySkin:InvokeServer(id)
	if ok then
		Effects.play("Purchase", 1.4)
		Hud.toast(if owned then "Equipped!" else "Unlocked & equipped!", C.Green)
	else
		errorToast(message or "Can't buy that yet")
	end
end

Panels.Callbacks.Rebirth = function()
	local ok, message = DoRebirth:InvokeServer()
	if ok then
		Effects.play("Purchase", 0.8)
		Hud.toast("Reborn! Coins are worth more now.", C.Purple)
		Panels.closeAll()
	else
		errorToast(message or "Not yet!")
	end
end

Panels.Callbacks.Admin = function(action: string, args)
	local ok, message = AdminAction:InvokeServer(action, args)
	if ok then
		Hud.toast(message or "Done!", C.Green)
		Effects.play("Click", 1.3)
	else
		errorToast(message or "That didn't work")
	end
end

if prompt then
	ProximityPromptService.PromptTriggered:Connect(function(triggered)
		if triggered == prompt then
			startCharge()
		end
	end)
end

----------------------------------------------------------------------
-- Input
----------------------------------------------------------------------
local function isChargeInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
		or input.KeyCode == Enum.KeyCode.Space
		or input.KeyCode == Enum.KeyCode.ButtonA
end

UserInputService.InputBegan:Connect(function(input, processed)
	if mode == "Charge" and isChargeInput(input) and not processed then
		charging = true
		return
	end
	if processed then
		return
	end
	local key = input.KeyCode
	if mode == "Idle" and not Panels.anyOpen() and not UpgradeTree.IsOpen then
		if key == Enum.KeyCode.E then
			startCharge()
		elseif key == Enum.KeyCode.U then
			Hud.Callbacks.Upgrade()
		end
	elseif UpgradeTree.IsOpen and key == Enum.KeyCode.U then
		UpgradeTree.close()
	elseif mode == "Rolling" and (key == Enum.KeyCode.T or key == Enum.KeyCode.ButtonY) then
		turbo()
	elseif mode == "Result" then
		if key == Enum.KeyCode.R then
			Panels.hideResult()
			startCharge()
		elseif key == Enum.KeyCode.Q then
			backToLobby()
		end
	elseif mode == "Charge" and key == Enum.KeyCode.X then
		cancelCharge()
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if mode == "Charge" and charging and isChargeInput(input) then
		launch()
	end
end)

----------------------------------------------------------------------
-- Frame loop (runs right after the default camera update)
----------------------------------------------------------------------
RunService:BindToRenderStep("SnowballSmash", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if mode == "Charge" then
		if charging then
			if hasPass("PerfectPush") and Effects.Settings.PerfectPush ~= false then
				-- Perfect Push pass: fills fast and stays at MAX
				power = math.min(1, power + dt * 4)
			else
				-- fills in about a second, then swings so timing matters
				power += powerDir * dt * 0.95
				if power >= 1 then
					power = 1
					powerDir = -1
				elseif power <= 0.35 and powerDir < 0 then
					powerDir = 1
				end
			end
		end
		Hud.setPower(power, charging)
	end
	if Runner.State ~= "Idle" then
		Runner.update(dt)
	end
end)

-- Show the course from the start so the lobby looks alive
refreshPasses()
Runner.resetCourse(false)
refreshBoosts()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="790">
          <Properties>
            <string name="Name">UIKit</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: small UI toolkit. Chunky cartoon buttons, wooden panels
-- with stud-pattern headers, and smooth tween helpers.

local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local UIKit = {}

UIKit.Font = Enum.Font.FredokaOne

UIKit.Colors = {
	White = Color3.fromRGB(255, 255, 255),
	Black = Color3.fromRGB(0, 0, 0),
	Outline = Color3.fromRGB(28, 18, 12),
	Wood = Color3.fromRGB(98, 60, 38),
	WoodDark = Color3.fromRGB(70, 42, 26),
	WoodLight = Color3.fromRGB(128, 82, 52),
	Yellow = Color3.fromRGB(255, 200, 40),
	YellowDark = Color3.fromRGB(214, 140, 12),
	Green = Color3.fromRGB(88, 220, 64),
	GreenDark = Color3.fromRGB(40, 150, 32),
	Blue = Color3.fromRGB(60, 150, 255),
	BlueDark = Color3.fromRGB(28, 88, 205),
	Red = Color3.fromRGB(240, 64, 64),
	RedDark = Color3.fromRGB(160, 26, 32),
	Purple = Color3.fromRGB(156, 96, 245),
	PurpleDark = Color3.fromRGB(92, 48, 172),
	Pink = Color3.fromRGB(255, 92, 196),
	Grey = Color3.fromRGB(120, 120, 130),
	GreyDark = Color3.fromRGB(70, 70, 80),
	Slate = Color3.fromRGB(34, 40, 56),
	Gold = Color3.fromRGB(255, 214, 60),
}
local C = UIKit.Colors

----------------------------------------------------------------------
-- Instance helpers
----------------------------------------------------------------------
function UIKit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className) :: any
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				inst[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
local new = UIKit.new

function UIKit.corner(parent: Instance, radius: number?): UICorner
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function UIKit.round(parent: Instance): UICorner
	return new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = parent })
end

function UIKit.stroke(parent: Instance, thickness: number?, color: Color3?, transparency: number?): UIStroke
	return new("UIStroke", {
		Thickness = thickness or 3,
		Color = color or C.Outline,
		Transparency = transparency or 0,
		ApplyStrokeMode = if parent:IsA("TextLabel") or parent:IsA("TextButton")
			then Enum.ApplyStrokeMode.Border
			else Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function UIKit.gradient(parent: Instance, colors: { Color3 }, rotation: number?): UIGradient
	local keypoints = {}
	for i, color in colors do
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), color))
	end
	return new("UIGradient", { Color = ColorSequence.new(keypoints), Rotation = rotation or 90, Parent = parent })
end

-- Cartoon text: white fill, thick dark outline, scales with its box.
function UIKit.label(props: { [string]: any }): TextLabel
	local strokeThickness = props.Stroke
	local maxSize = props.MaxTextSize
	props.Stroke = nil
	props.MaxTextSize = nil
	local base = {
		BackgroundTransparency = 1,
		Font = UIKit.Font,
		TextColor3 = C.White,
		TextScaled = true,
		Text = "",
	}
	for k, v in props do
		base[k] = v
	end
	local label = new("TextLabel", base)
	if strokeThickness ~= 0 then
		new("UIStroke", {
			Thickness = strokeThickness or 2.5,
			Color = C.Outline,
			LineJoinMode = Enum.LineJoinMode.Round,
			Parent = label,
		})
	end
	if maxSize then
		new("UITextSizeConstraint", { MaxTextSize = maxSize, Parent = label })
	end
	return label
end

-- Lego-like stud pattern overlay (purely decorative)
function UIKit.studs(parent: GuiObject, width: number, height: number, cell: number?, transparency: number?)
	local size = cell or 16
	local holder = new("Frame", {
		Name = "Studs",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ClipsDescendants = true,
		ZIndex = parent.ZIndex,
		Parent = parent,
	})
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(size, size),
		CellPadding = UDim2.fromOffset(0, 0),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = holder,
	})
	local cols = math.ceil(width / size)
	local rows = math.ceil(height / size)
	for _ = 1, math.min(cols * rows, 260) do
		local cellFrame = new("Frame", { BackgroundTransparency = 1, ZIndex = parent.ZIndex, Parent = holder })
		local dot = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.5, 0.5),
			BackgroundColor3 = C.White,
			BackgroundTransparency = transparency or 0.82,
			ZIndex = parent.ZIndex,
			Parent = cellFrame,
		})
		UIKit.corner(dot, 3)
	end
	return holder
end

----------------------------------------------------------------------
-- Tweens
----------------------------------------------------------------------
function UIKit.tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

-- Quick "pop" bounce on any GuiObject that has (or gets) a UIScale
function UIKit.pop(gui: GuiObject, amount: number?)
	local scale = gui:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = gui })
	scale.Scale = amount or 1.25
	UIKit.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

----------------------------------------------------------------------
-- Sound hook (set by Effects so UI clicks can play sounds)
----------------------------------------------------------------------
UIKit.PlaySound = function(_name: string, _pitch: number?, _volume: number?) end

----------------------------------------------------------------------
-- Chunky 3D button: dark base, coloured face that sinks when pressed.
----------------------------------------------------------------------
export type ButtonOptions = {
	Size: UDim2,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	Color: Color3?,
	DarkColor: Color3?,
	Text: string?,
	Icon: string?,
	TextSize: number?,
	Key: string?,
	Studs: boolean?,
	Parent: Instance?,
	ZIndex: number?,
	Corner: number?,
	OnClick: (() -> ())?,
}

export type Button = {
	Holder: Frame,
	Face: Frame,
	Label: TextLabel,
	IconLabel: TextLabel?,
	Hitbox: TextButton,
	SetColors: (Color3, Color3) -> (),
	SetText: (string) -> (),
	Clicked: (() -> ())?,
}

function UIKit.button(opts: ButtonOptions): Button
	local color = opts.Color or C.Green
	local dark = opts.DarkColor or C.GreenDark
	local z = opts.ZIndex or 1
	local radius = opts.Corner or 14

	local holder = new("Frame", {
		Name = "Button",
		BackgroundTransparency = 1,
		Size = opts.Size,
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		ZIndex = z,
		Parent = opts.Parent,
	})
	local scale = new("UIScale", { Parent = holder })

	local base = new("Frame", {
		Name = "Base",
		BackgroundColor3 = dark,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = z,
		Parent = holder,
	})
	UIKit.corner(base, radius)
	UIKit.stroke(base, 3)

	local face = new("Frame", {
		Name = "Face",
		BackgroundColor3 = color,
		Size = UDim2.new(1, 0, 1, -6),
		Position = UDim2.fromOffset(0, 0),
		ZIndex = z + 1,
		ClipsDescendants = false,
		Parent = holder,
	})
	UIKit.corner(face, radius)
	-- soft top highlight
	local shine = new("Frame", {
		Name = "Shine",
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.78,
		Size = UDim2.new(1, -12, 0.42, 0),
		Position = UDim2.fromOffset(6, 4),
		ZIndex = z + 1,
		Parent = face,
	})
	UIKit.corner(shine, radius - 4)

	local pxW = opts.Size.X.Offset
	local pxH = opts.Size.Y.Offset
	if opts.Studs and pxW > 0 and pxH > 0 then
		local studs = UIKit.studs(face, pxW, pxH, 14, 0.85)
		studs.ZIndex = z + 1
		UIKit.corner(studs, radius)
	end

	local textLeft = 0
	local iconLabel: TextLabel? = nil
	if opts.Icon then
		iconLabel = UIKit.label({
			Name = "Icon",
			Text = opts.Icon,
			Size = UDim2.new(0, pxH * 0.78, 0.86, 0),
			Position = UDim2.new(0, 10, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			ZIndex = z + 2,
			Stroke = 0,
			Parent = face,
		})
		textLeft = pxH * 0.78 + 8
	end

	local label = UIKit.label({
		Name = "Label",
		Text = opts.Text or "",
		Size = UDim2.new(1, -(textLeft + 16), 0.62, 0),
		Position = UDim2.new(0, textLeft + 8, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = z + 2,
		Stroke = 3,
		MaxTextSize = opts.TextSize,
		Parent = face,
	})

	if opts.Key then
		UIKit.label({
			Name = "Key",
			Text = opts.Key,
			Size = UDim2.fromOffset(14, 14),
			Position = UDim2.new(1, -4, 1, -2),
			AnchorPoint = Vector2.new(1, 1),
			ZIndex = z + 2,
			Stroke = 1.5,
			TextColor3 = C.White,
			Parent = face,
		})
	end

	local hitbox = new("TextButton", {
		Name = "Hitbox",
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		ZIndex = z + 3,
		AutoButtonColor = false,
		Parent = holder,
	})

	local button: Button = {
		Holder = holder,
		Face = face,
		Label = label,
		IconLabel = iconLabel,
		Hitbox = hitbox,
		SetColors = function(_c: Color3, _d: Color3) end,
		SetText = function(_t: string) end,
		Clicked = opts.OnClick,
	}

	button.SetColors = function(c: Color3, d: Color3)
		face.BackgroundColor3 = c
		base.BackgroundColor3 = d
	end
	button.SetText = function(t: string)
		label.Text = t
	end

	local hovering = false
	hitbox.MouseEnter:Connect(function()
		hovering = true
		UIKit.PlaySound("Hover", 1)
		UIKit.tween(scale, 0.18, { Scale = 1.06 }, Enum.EasingStyle.Back)
	end)
	hitbox.MouseLeave:Connect(function()
		hovering = false
		UIKit.tween(scale, 0.18, { Scale = 1 })
		UIKit.tween(face, 0.1, { Position = UDim2.fromOffset(0, 0) })
	end)
	hitbox.MouseButton1Down:Connect(function()
		UIKit.tween(scale, 0.08, { Scale = 0.95 })
		UIKit.tween(face, 0.08, { Position = UDim2.fromOffset(0, 4) })
	end)
	hitbox.MouseButton1Up:Connect(function()
		UIKit.tween(scale, 0.25, { Scale = if hovering then 1.06 else 1 }, Enum.EasingStyle.Back)
		UIKit.tween(face, 0.12, { Position = UDim2.fromOffset(0, 0) })
	end)
	hitbox.Activated:Connect(function()
		UIKit.PlaySound("Click", 1.2)
		if button.Clicked then
			button.Clicked()
		end
	end)

	return button
end

----------------------------------------------------------------------
-- Red square close button (X)
----------------------------------------------------------------------
function UIKit.closeButton(parent: Instance, position: UDim2, z: number?, onClick: () -> ()): Button
	local b = UIKit.button({
		Size = UDim2.fromOffset(58, 58),
		Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Color = C.Red,
		DarkColor = C.RedDark,
		Text = "✕",
		Parent = parent,
		ZIndex = z,
		Corner = 12,
		OnClick = onClick,
	})
	b.Label.Size = UDim2.new(1, -10, 0.8, 0)
	b.Label.Position = UDim2.new(0.5, 0, 0.5, 0)
	b.Label.AnchorPoint = Vector2.new(0.5, 0.5)
	b.Label.TextXAlignment = Enum.TextXAlignment.Center
	return b
end

----------------------------------------------------------------------
-- Text input box
----------------------------------------------------------------------
function UIKit.textbox(parent: Instance, placeholder: string, size: UDim2, position: UDim2?): TextBox
	local frame = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(46, 28, 18),
		Size = size,
		Position = position or UDim2.new(),
		Parent = parent,
	})
	UIKit.corner(frame, 10)
	UIKit.stroke(frame, 2.5, C.WoodLight)
	local box = new("TextBox", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromOffset(10, 4),
		Font = UIKit.Font,
		Text = "",
		PlaceholderText = placeholder,
		PlaceholderColor3 = Color3.fromRGB(170, 140, 120),
		TextColor3 = C.White,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		Parent = frame,
	})
	box.Focused:Connect(function()
		local st = frame:FindFirstChildOfClass("UIStroke")
		if st then
			UIKit.tween(st, 0.15, { Color = C.Yellow })
		end
	end)
	box.FocusLost:Connect(function()
		local st = frame:FindFirstChildOfClass("UIStroke")
		if st then
			UIKit.tween(st, 0.15, { Color = C.WoodLight })
		end
	end)
	return box
end

----------------------------------------------------------------------
-- Coin icon built from frames (no image assets needed)
----------------------------------------------------------------------
function UIKit.coin(parent: Instance, size: number, position: UDim2?, anchor: Vector2?, z: number?): Frame
	local zi = z or 1
	local coin = new("Frame", {
		Name = "Coin",
		Size = UDim2.fromOffset(size, size),
		Position = position or UDim2.new(),
		AnchorPoint = anchor or Vector2.zero,
		BackgroundColor3 = Color3.fromRGB(255, 196, 30),
		ZIndex = zi,
		Parent = parent,
	})
	UIKit.round(coin)
	UIKit.stroke(coin, math.max(2, size / 14))
	UIKit.gradient(coin, { Color3.fromRGB(255, 232, 110), Color3.fromRGB(240, 160, 20) }, 90)
	local inner = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.68, 0.68),
		BackgroundColor3 = Color3.fromRGB(230, 150, 20),
		ZIndex = zi,
		Parent = coin,
	})
	UIKit.round(inner)
	UIKit.label({
		Text = "★",
		Size = UDim2.fromScale(0.95, 0.95),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		TextColor3 = Color3.fromRGB(60, 34, 10),
		Stroke = 0,
		ZIndex = zi,
		Parent = inner,
	})
	return coin
end

----------------------------------------------------------------------
-- Wooden panel with a yellow studded header and a red close button
----------------------------------------------------------------------
export type Panel = {
	Root: Frame,
	Content: Frame,
	Header: Frame,
	Title: TextLabel,
	Scale: UIScale,
	IsOpen: boolean,
	OnClose: (() -> ())?,
}

function UIKit.panel(parent: Instance, title: string, icon: string, width: number, height: number, showClose: boolean?): Panel
	local root = new("Frame", {
		Name = title .. "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	})
	local scale = new("UIScale", { Parent = root })

	local body = new("Frame", {
		Name = "Body",
		BackgroundColor3 = C.Wood,
		Size = UDim2.new(1, 0, 1, -34),
		Position = UDim2.fromOffset(0, 34),
		ZIndex = 20,
		Parent = root,
	})
	UIKit.corner(body, 18)
	UIKit.stroke(body, 4)
	local inner = new("Frame", {
		Name = "Inner",
		BackgroundColor3 = C.WoodDark,
		BackgroundTransparency = 0.35,
		Size = UDim2.new(1, -16, 1, -16),
		Position = UDim2.fromOffset(8, 8),
		ZIndex = 20,
		Parent = body,
	})
	UIKit.corner(inner, 14)
	UIKit.stroke(inner, 2, C.WoodLight, 0.2)

	local header = new("Frame", {
		Name = "Header",
		BackgroundColor3 = C.Yellow,
		Size = UDim2.new(1, 16, 0, 72),
		Position = UDim2.fromOffset(-8, 0),
		ZIndex = 22,
		Parent = root,
	})
	UIKit.corner(header, 14)
	UIKit.stroke(header, 4)
	UIKit.gradient(header, { Color3.fromRGB(255, 222, 80), C.Yellow, C.YellowDark }, 90)
	local studs = UIKit.studs(header, width + 16, 72, 16, 0.8)
	UIKit.corner(studs, 14)

	UIKit.label({
		Name = "Icon",
		Text = icon,
		Size = UDim2.fromOffset(58, 58),
		Position = UDim2.new(0, 14, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 23,
		Stroke = 0,
		Parent = header,
	})
	local titleLabel = UIKit.label({
		Name = "Title",
		Text = title,
		Size = UDim2.new(1, -150, 0, 44),
		Position = UDim2.new(0, 82, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 23,
		Stroke = 3.5,
		Parent = header,
	})

	local content = new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -44, 1, -126),
		Position = UDim2.fromOffset(22, 100),
		ZIndex = 21,
		Parent = root,
	})

	local panel: Panel = {
		Root = root,
		Content = content,
		Header = header,
		Title = titleLabel,
		Scale = scale,
		IsOpen = false,
		OnClose = nil,
	}

	if showClose ~= false then
		UIKit.closeButton(root, UDim2.new(1, 4, 0, 6), 30, function()
			if panel.OnClose then
				panel.OnClose()
			end
		end)
	end

	return panel
end

----------------------------------------------------------------------
-- Background blur shared by every menu
----------------------------------------------------------------------
local blur: BlurEffect = Lighting:FindFirstChild("MenuBlur") :: BlurEffect
	or new("BlurEffect", { Name = "MenuBlur", Size = 0, Parent = Lighting })
local blurUsers = 0

function UIKit.setBlur(on: boolean)
	blurUsers = math.max(0, blurUsers + (if on then 1 else -1))
	UIKit.tween(blur, 0.3, { Size = if blurUsers > 0 then 18 else 0 })
end

function UIKit.openPanel(panel: Panel)
	if panel.IsOpen then
		return
	end
	panel.IsOpen = true
	panel.Root.Visible = true
	panel.Scale.Scale = 0.55
	panel.Root.Position = UDim2.fromScale(0.5, 0.58)
	UIKit.tween(panel.Scale, 0.38, { Scale = 1 }, Enum.EasingStyle.Back)
	UIKit.tween(panel.Root, 0.3, { Position = UDim2.fromScale(0.5, 0.52) }, Enum.EasingStyle.Quint)
	UIKit.setBlur(true)
	UIKit.PlaySound("Open", 0.9)
end

function UIKit.closePanel(panel: Panel)
	if not panel.IsOpen then
		return
	end
	panel.IsOpen = false
	UIKit.setBlur(false)
	UIKit.PlaySound("Close", 1)
	local t = UIKit.tween(panel.Scale, 0.2, { Scale = 0.6 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	t.Completed:Connect(function()
		if not panel.IsOpen then
			panel.Root.Visible = false
		end
	end)
end

-- Gently widen the camera's field of view while menus are open
function UIKit.cameraZoom(on: boolean)
	local camera = Workspace.CurrentCamera
	if camera and camera.CameraType ~= Enum.CameraType.Scriptable then
		UIKit.tween(camera, 0.35, { FieldOfView = if on then 62 else 70 })
	end
end

return UIKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="791">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: sounds, camera shake, speed lines, floating world text and snow bursts.

local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared:WaitForChild("Sounds"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))

local Effects = {}

Effects.Settings = { Music = true, SFX = true, Shake = true, SpeedLines = true, Hints = true, PerfectPush = true }

----------------------------------------------------------------------
-- Sound effects (ids come from ReplicatedStorage.Shared.Sounds)
----------------------------------------------------------------------
local soundFolder = Instance.new("Folder")
soundFolder.Name = "SnowballSounds"
soundFolder.Parent = SoundService

local templates = {}
local function addTemplates(list, volume: number)
	for name, id in list do
		if type(id) == "string" and id ~= "" then
			local s = Instance.new("Sound")
			s.Name = name
			s.SoundId = id
			s.Volume = volume
			s.Parent = soundFolder
			templates[name] = s
		end
	end
end
addTemplates(Sounds.UI, Sounds.UIVolume)
addTemplates(Sounds.Game, Sounds.SfxVolume)

-- name: a key from Sounds.UI or Sounds.Game; volume: 0-1 multiplier
function Effects.play(name: string, pitch: number?, volume: number?)
	if not Effects.Settings.SFX then
		return
	end
	local t = templates[name]
	if not t then
		return
	end
	local s = t:Clone()
	s.PlaybackSpeed = pitch or 1
	s.Volume = t.Volume * (volume or 1)
	s.Parent = soundFolder
	s:Play()
	Debris:AddItem(s, 4)
end
UIKit.PlaySound = Effects.play

----------------------------------------------------------------------
-- Background music playlist (+ optional event music)
----------------------------------------------------------------------
local playlist = {}
for _, id in Sounds.Music do
	if type(id) == "string" and id ~= "" then
		table.insert(playlist, id)
	end
end

local music = Instance.new("Sound")
music.Name = "Music"
music.Volume = Sounds.MusicVolume
music.Parent = soundFolder
local track = 0
local eventMusicOn = false

local function playNext()
	if eventMusicOn and Sounds.EventMusic ~= "" then
		music.SoundId = Sounds.EventMusic
		music.Looped = true
	elseif #playlist > 0 then
		track = track % #playlist + 1
		music.SoundId = playlist[track]
		music.Looped = #playlist == 1
	else
		music:Stop()
		return
	end
	music.TimePosition = 0
	music:Play()
end

music.Ended:Connect(function()
	if Effects.Settings.Music then
		playNext()
	end
end)

function Effects.applyMusic()
	if Effects.Settings.Music then
		if not music.IsPlaying then
			playNext()
		end
	else
		music:Stop()
	end
end

-- switch to/from Sounds.EventMusic while a storm is running
function Effects.setEventMusic(on: boolean)
	if on == eventMusicOn then
		return
	end
	eventMusicOn = on
	if Sounds.EventMusic ~= "" and Effects.Settings.Music then
		music:Stop()
		playNext()
	end
end

----------------------------------------------------------------------
-- Camera shake (returns an offset CFrame you multiply into the camera)
----------------------------------------------------------------------
local shakeAmount = 0
function Effects.shake(amount: number)
	if Effects.Settings.Shake then
		shakeAmount = math.min(2.5, shakeAmount + amount)
	end
end

function Effects.shakeOffset(dt: number): CFrame
	if shakeAmount <= 0.001 then
		shakeAmount = 0
		return CFrame.identity
	end
	local a = shakeAmount
	shakeAmount = shakeAmount * math.exp(-dt * 7)
	local rx = (math.random() - 0.5) * a * 0.05
	local ry = (math.random() - 0.5) * a * 0.05
	return CFrame.new((math.random() - 0.5) * a, (math.random() - 0.5) * a, 0) * CFrame.Angles(rx, ry, 0)
end

----------------------------------------------------------------------
-- Speed lines: thin white streaks flying out from the centre of the screen
----------------------------------------------------------------------
local linesLayer: Frame? = nil
local lineTimer = 0

function Effects.setSpeedLayer(layer: Frame)
	linesLayer = layer
end

function Effects.speedLines(dt: number, speed: number)
	local layer = linesLayer
	if not layer or not Effects.Settings.SpeedLines or speed < 45 then
		return
	end
	lineTimer += dt * math.clamp((speed - 40) / 6, 0, 22)
	while lineTimer >= 1 do
		lineTimer -= 1
		local angle = math.random() * math.pi * 2
		local dir = Vector2.new(math.cos(angle), math.sin(angle))
		local startR = 0.28 + math.random() * 0.1
		local line = UIKit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(math.random(60, 160), math.random(2, 4)),
			Position = UDim2.fromScale(0.5 + dir.X * startR, 0.5 + dir.Y * startR),
			Rotation = math.deg(angle),
			Parent = layer,
		})
		local endR = 0.8
		UIKit.tween(line, 0.35, {
			Position = UDim2.fromScale(0.5 + dir.X * endR, 0.5 + dir.Y * endR),
			BackgroundTransparency = 1,
		}, Enum.EasingStyle.Linear)
		Debris:AddItem(line, 0.4)
	end
end

----------------------------------------------------------------------
-- Floating text in the world ("+120", "CRITICAL!")
----------------------------------------------------------------------
function Effects.worldText(position: Vector3, text: string, color: Color3, size: number?)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.Position = position
	anchor.Parent = Workspace

	local px = size or 60
	local gui = UIKit.new("BillboardGui", {
		Size = UDim2.fromOffset(px * 4, px),
		AlwaysOnTop = true,
		LightInfluence = 0,
		StudsOffset = Vector3.new(0, 0, 0),
		Parent = anchor,
	})
	local label = UIKit.label({
		Text = text,
		Size = UDim2.fromScale(1, 1),
		TextColor3 = color,
		Stroke = 3,
		Parent = gui,
	})
	UIKit.pop(label, 0.3)
	UIKit.tween(gui, 1.1, { StudsOffset = Vector3.new(0, 6, 0) }, Enum.EasingStyle.Quad)
	task.delay(0.6, function()
		UIKit.tween(label, 0.5, { TextTransparency = 1 })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			UIKit.tween(stroke, 0.5, { Transparency = 1 })
		end
	end)
	Debris:AddItem(anchor, 1.3)
end

----------------------------------------------------------------------
-- Snow puff particles
----------------------------------------------------------------------
function Effects.burst(position: Vector3, color: Color3, count: number, size: number?)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.one
	holder.Position = position
	holder.Parent = Workspace

	local s = size or 1.5
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.2
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, s),
		NumberSequenceKeypoint.new(1, s * 0.2),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(0.5, 1)
	emitter.Speed = NumberRange.new(14, 32)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -40, 0)
	emitter.Drag = 2
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(count)
	Debris:AddItem(holder, 1.5)
end

----------------------------------------------------------------------
-- Storm weather: heavy snowfall around the camera while a storm is active
----------------------------------------------------------------------
local stormPart: Part? = nil
local stormEmitter: ParticleEmitter? = nil

function Effects.setStorm(on: boolean, color: Color3?)
	if on and not stormPart then
		local p = Instance.new("Part")
		p.Name = "StormSnow"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = Vector3.new(160, 1, 160)
		p.Parent = Workspace
		local e = Instance.new("ParticleEmitter")
		e.Rate = 260
		e.Lifetime = NumberRange.new(2.5, 4)
		e.Speed = NumberRange.new(25, 40)
		e.EmissionDirection = Enum.NormalId.Bottom
		e.SpreadAngle = Vector2.new(15, 15)
		e.Acceleration = Vector3.new(14, 0, 6)
		e.Size = NumberSequence.new(0.35)
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 0.6) })
		e.LightEmission = 0.4
		e.Parent = p
		stormPart = p
		stormEmitter = e
	end
	if stormEmitter and color then
		stormEmitter.Color = ColorSequence.new(Color3.new(1, 1, 1), color)
	end
	if not on and stormPart then
		stormPart:Destroy()
		stormPart = nil
		stormEmitter = nil
	end
end

game:GetService("RunService").RenderStepped:Connect(function()
	local p = stormPart
	local camera = Workspace.CurrentCamera
	if p and camera then
		p.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 45, 0) + camera.CFrame.LookVector * 40)
	end
end)

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="792">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: the always-on HUD. Coins, side menu, top tabs, power bar,
-- run counters, combo tags and toasts.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))
local Effects = require(script.Parent:WaitForChild("Effects"))

local C = UIKit.Colors
local new = UIKit.new

local Hud = {}

Hud.Callbacks = {
	Turbo = function() end,
	Roll = function() end,
	Upgrade = function() end,
	Menu = function(_name: string) end,
	CancelCharge = function() end,
}

local player = Players.LocalPlayer

----------------------------------------------------------------------
-- Root: everything is designed at 1280x720 and scaled to the screen.
----------------------------------------------------------------------
local DESIGN = Vector2.new(1280, 720)

local screenGui = new("ScreenGui", {
	Name = "SnowballSmashUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})
Hud.ScreenGui = screenGui

local speedLayer = new("Frame", {
	Name = "SpeedLines",
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 0,
	Parent = screenGui,
})
Effects.setSpeedLayer(speedLayer)

local root = new("Frame", { Name = "Root", BackgroundTransparency = 1, ZIndex = 1, Parent = screenGui })
local rootScale = new("UIScale", { Parent = root })
Hud.Root = root

local function rescale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local vp = camera.ViewportSize
	local s = math.clamp(math.min(vp.X / DESIGN.X, vp.Y / DESIGN.Y), 0.45, 1.6)
	rootScale.Scale = s
	root.Size = UDim2.fromScale(1 / s, 1 / s)
	Hud.UIScale = s
end
Hud.UIScale = 1
rescale()
local function hookCamera()
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end
	rescale()
end
hookCamera()
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)

----------------------------------------------------------------------
-- Helper to slide whole groups in and out smoothly
----------------------------------------------------------------------
type Slider = { Frame: GuiObject, Shown: UDim2, Hidden: UDim2, Visible: boolean }
local sliders: { [string]: Slider } = {}

local function makeSlider(name: string, frame: GuiObject, shown: UDim2, hidden: UDim2)
	frame.Position = hidden
	frame.Visible = false
	sliders[name] = { Frame = frame, Shown = shown, Hidden = hidden, Visible = false }
end

local function slide(name: string, visible: boolean, instant: boolean?)
	local s = sliders[name]
	if not s or s.Visible == visible then
		return
	end
	s.Visible = visible
	if visible then
		s.Frame.Visible = true
		if instant then
			s.Frame.Position = s.Shown
		else
			UIKit.tween(s.Frame, 0.45, { Position = s.Shown }, Enum.EasingStyle.Back)
		end
	else
		local t = UIKit.tween(s.Frame, 0.3, { Position = s.Hidden }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if not s.Visible then
				s.Frame.Visible = false
			end
		end)
	end
end

----------------------------------------------------------------------
-- Bottom-left: coins + best
----------------------------------------------------------------------
local wallet = new("Frame", {
	Name = "Wallet",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(330, 110),
	AnchorPoint = Vector2.new(0, 1),
	Parent = root,
})
makeSlider("Wallet", wallet, UDim2.new(0, 22, 1, -14), UDim2.new(0, -360, 1, -14))
local walletCoin = UIKit.coin(wallet, 62, UDim2.fromOffset(0, 4))
local coinsLabel = UIKit.label({
	Name = "Coins",
	Text = "0",
	TextColor3 = Color3.fromRGB(255, 214, 50),
	TextXAlignment = Enum.TextXAlignment.Left,
	Size = UDim2.fromOffset(260, 58),
	Position = UDim2.fromOffset(72, 6),
	Stroke = 4,
	Parent = wallet,
})
UIKit.gradient(coinsLabel, { Color3.fromRGB(255, 240, 140), Color3.fromRGB(255, 190, 30) }, 90)
local bestLabel = UIKit.label({
	Name = "Best",
	Text = "🏆 BEST 0",
	TextColor3 = Color3.fromRGB(150, 255, 90),
	TextXAlignment = Enum.TextXAlignment.Left,
	Size = UDim2.fromOffset(250, 30),
	Position = UDim2.fromOffset(6, 74),
	Stroke = 3,
	Parent = wallet,
})

local shownCoins = 0
local targetCoins = 0
function Hud.setCoins(amount: number, instant: boolean?)
	if amount > targetCoins and not instant then
		UIKit.pop(walletCoin, 1.3)
	end
	targetCoins = amount
	if instant then
		shownCoins = amount
	end
end
function Hud.setBest(best: number)
	bestLabel.Text = "🏆 BEST " .. Config.Short(best)
end

----------------------------------------------------------------------
-- Left: menu tiles (2 x 3), like a little app grid
----------------------------------------------------------------------
local menu = new("Frame", {
	Name = "Menu",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(196, 390),
	AnchorPoint = Vector2.new(0, 0.5),
	Parent = root,
})
makeSlider("Menu", menu, UDim2.new(0, 16, 0.5, 10), UDim2.new(0, -240, 0.5, 10))

local badges: { [string]: { Alert: Frame, Soon: Frame? } } = {}

local MENU_ITEMS = {
	{ Name = "Shop", Icon = "🛒", Col = 0, Row = 0 },
	{ Name = "Upgrades", Icon = "⬆️", Col = 1, Row = 0 },
	{ Name = "Rebirth", Icon = "🔄", Col = 0, Row = 1 },
	{ Name = "Index", Icon = "📘", Col = 1, Row = 1, Soon = true },
	{ Name = "Stats", Icon = "📊", Col = 0, Row = 2 },
	{ Name = "Settings", Icon = "⚙️", Col = 1, Row = 2 },
	{ Name = "Admin", Icon = "🛡️", Col = 0, Row = 3, AdminOnly = true },
}
local adminTile: Frame? = nil

for _, item in MENU_ITEMS do
	local tile = new("Frame", {
		Name = item.Name,
		Size = UDim2.fromOffset(90, 90),
		Position = UDim2.fromOffset(item.Col * 100, item.Row * 100),
		BackgroundColor3 = C.Slate,
		BackgroundTransparency = 0.25,
		Visible = not item.AdminOnly,
		Parent = menu,
	})
	if item.AdminOnly then
		adminTile = tile
	end
	UIKit.corner(tile, 14)
	UIKit.stroke(tile, 3, C.Outline, 0.1)
	local tileScale = new("UIScale", { Parent = tile })
	local icon = UIKit.label({
		Text = item.Icon,
		Size = UDim2.fromOffset(56, 52),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		Stroke = 0,
		Parent = tile,
	})
	UIKit.label({
		Text = item.Name,
		Size = UDim2.new(1, -8, 0, 22),
		Position = UDim2.new(0.5, 0, 1, -6),
		AnchorPoint = Vector2.new(0.5, 1),
		Stroke = 2.5,
		Parent = tile,
	})

	local soon: Frame? = nil
	if item.Soon then
		local s = new("Frame", {
			Size = UDim2.fromOffset(54, 22),
			Position = UDim2.new(1, 6, 0, -8),
			AnchorPoint = Vector2.new(1, 0),
			BackgroundColor3 = C.Yellow,
			Rotation = 6,
			Parent = tile,
		})
		UIKit.corner(s, 8)
		UIKit.stroke(s, 2)
		UIKit.label({ Text = "SOON", Size = UDim2.new(1, -6, 1, -4), Position = UDim2.fromOffset(3, 2), Stroke = 2, Parent = s })
		soon = s
	end

	local alert = new("Frame", {
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(1, 8, 0, -8),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = C.Red,
		Visible = false,
		Parent = tile,
	})
	UIKit.round(alert)
	UIKit.stroke(alert, 2.5, C.White)
	UIKit.label({ Text = "!", Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), Stroke = 0, Parent = alert })
	badges[item.Name] = { Alert = alert, Soon = soon }

	local hit = new("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		Parent = tile,
	})
	hit.MouseEnter:Connect(function()
		UIKit.tween(tileScale, 0.18, { Scale = 1.08 }, Enum.EasingStyle.Back)
		UIKit.tween(tile, 0.18, { BackgroundTransparency = 0.05 })
		UIKit.tween(icon, 0.25, { Rotation = -8 }, Enum.EasingStyle.Back)
	end)
	hit.MouseLeave:Connect(function()
		UIKit.tween(tileScale, 0.18, { Scale = 1 })
		UIKit.tween(tile, 0.18, { BackgroundTransparency = 0.25 })
		UIKit.tween(icon, 0.25, { Rotation = 0 }, Enum.EasingStyle.Back)
	end)
	hit.MouseButton1Down:Connect(function()
		UIKit.tween(tileScale, 0.08, { Scale = 0.94 })
	end)
	hit.Activated:Connect(function()
		UIKit.tween(tileScale, 0.3, { Scale = 1.08 }, Enum.EasingStyle.Back)
		Effects.play("Click", 1.1)
		Hud.Callbacks.Menu(item.Name)
	end)
end

function Hud.setAdmin(on: boolean)
	if adminTile then
		adminTile.Visible = on
	end
end

-- Gently bob the "!" badges so they catch the eye
RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for _, b in badges do
		if b.Alert.Visible then
			b.Alert.Rotation = math.sin(t * 6) * 10
		end
	end
end)

function Hud.setAlert(name: string, on: boolean)
	local b = badges[name]
	if b then
		b.Alert.Visible = on
	end
end

----------------------------------------------------------------------
-- Top: Roll! / Upgrade tabs
----------------------------------------------------------------------
local tabs = new("Frame", {
	Name = "Tabs",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(420, 72),
	AnchorPoint = Vector2.new(0.5, 0),
	Parent = root,
})
makeSlider("Tabs", tabs, UDim2.new(0.5, 0, 0, 14), UDim2.new(0.5, 0, 0, -110))
UIKit.button({
	Size = UDim2.fromOffset(204, 70),
	Position = UDim2.fromOffset(0, 0),
	Color = C.Blue,
	DarkColor = C.BlueDark,
	Text = "Roll!",
	Icon = "⛄",
	Studs = true,
	Key = "E",
	Parent = tabs,
	OnClick = function()
		Hud.Callbacks.Roll()
	end,
})
UIKit.button({
	Size = UDim2.fromOffset(204, 70),
	Position = UDim2.fromOffset(216, 0),
	Color = C.Green,
	DarkColor = C.GreenDark,
	Text = "Upgrade",
	Icon = "⬆️",
	Studs = true,
	Key = "U",
	Parent = tabs,
	OnClick = function()
		Hud.Callbacks.Upgrade()
	end,
})

----------------------------------------------------------------------
-- Run counters: coins this run (top centre) and distance (top right)
----------------------------------------------------------------------
local function pill(width: number, height: number): Frame
	local f = new("Frame", {
		BackgroundColor3 = C.Slate,
		BackgroundTransparency = 0.3,
		Size = UDim2.fromOffset(width, height),
		Parent = root,
	})
	UIKit.corner(f, 12)
	UIKit.stroke(f, 3, C.Outline, 0.15)
	return f
end

local runCoins = pill(230, 54)
runCoins.AnchorPoint = Vector2.new(0.5, 0)
makeSlider("RunCoins", runCoins, UDim2.new(0.5, 0, 0, 14), UDim2.new(0.5, 0, 0, -90))
local runCoinIcon = UIKit.coin(runCoins, 40, UDim2.new(0, 8, 0.5, 0), Vector2.new(0, 0.5))
local runCoinsLabel = UIKit.label({
	Text = "0",
	TextColor3 = Color3.fromRGB(255, 220, 70),
	TextXAlignment = Enum.TextXAlignment.Left,
	Size = UDim2.new(1, -64, 0, 36),
	Position = UDim2.new(0, 56, 0.5, 0),
	AnchorPoint = Vector2.new(0, 0.5),
	Stroke = 3,
	Parent = runCoins,
})

local distance = pill(170, 50)
distance.AnchorPoint = Vector2.new(1, 0)
makeSlider("Distance", distance, UDim2.new(1, -20, 0, 20), UDim2.new(1, 200, 0, 20))
UIKit.label({ Text = "🏁", Size = UDim2.fromOffset(36, 36), Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Stroke = 0, Parent = distance })
local distanceLabel = UIKit.label({
	Text = "0",
	TextXAlignment = Enum.TextXAlignment.Left,
	Size = UDim2.new(1, -60, 0, 30),
	Position = UDim2.new(0, 50, 0, 6),
	Stroke = 3,
	Parent = distance,
})
UIKit.label({
	Text = "STUDS",
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.fromRGB(190, 200, 220),
	Size = UDim2.new(1, -60, 0, 12),
	Position = UDim2.new(0, 51, 1, -16),
	Stroke = 1.5,
	Parent = distance,
})

-- speed gauge under the distance pill
local speedBar = pill(170, 18)
speedBar.AnchorPoint = Vector2.new(1, 0)
makeSlider("Speed", speedBar, UDim2.new(1, -20, 0, 78), UDim2.new(1, 200, 0, 78))
local speedFill = new("Frame", {
	BackgroundColor3 = C.White,
	Size = UDim2.new(0, 0, 1, -6),
	Position = UDim2.fromOffset(3, 3),
	Parent = speedBar,
})
UIKit.corner(speedFill, 6)
UIKit.gradient(speedFill, { Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 90, 200) }, 0)

local shownRunCoins = 0
local targetRunCoins = 0
function Hud.setRunCoins(n: number, instant: boolean?)
	if n > targetRunCoins then
		UIKit.pop(runCoinIcon, 1.35)
	end
	targetRunCoins = n
	if instant then
		shownRunCoins = n
		runCoinsLabel.Text = Config.Commas(n)
	end
end
function Hud.setDistance(d: number)
	distanceLabel.Text = Config.Commas(d)
end
function Hud.setSpeed(fraction: number)
	speedFill.Size = UDim2.new(math.clamp(fraction, 0, 1), -6, 1, -6)
end

----------------------------------------------------------------------
-- Combo tag + CRITICAL! text
----------------------------------------------------------------------
local comboTag = new("Frame", {
	Name = "Combo",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 70, 0, 92),
	Size = UDim2.fromOffset(96, 52),
	BackgroundColor3 = C.Pink,
	Rotation = -6,
	Visible = false,
	Parent = root,
})
UIKit.corner(comboTag, 12)
UIKit.stroke(comboTag, 3)
UIKit.gradient(comboTag, { Color3.fromRGB(255, 140, 220), C.Pink }, 90)
local comboLabel = UIKit.label({ Text = "x2", Size = UDim2.new(1, -12, 1, -10), Position = UDim2.fromOffset(6, 5), Stroke = 3, Parent = comboTag })
local comboHideAt = 0

function Hud.combo(n: number, window: number)
	if n < 2 then
		return
	end
	comboLabel.Text = "x" .. n
	comboTag.Visible = true
	comboTag.Rotation = (math.random() - 0.5) * 16
	UIKit.pop(comboTag, 1.6)
	comboHideAt = os.clock() + window
end

local critLabel = UIKit.label({
	Text = "CRITICAL!",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0, 150),
	Size = UDim2.fromOffset(300, 64),
	Rotation = -8,
	Visible = false,
	Stroke = 4,
	Parent = root,
})
UIKit.gradient(critLabel, { Color3.fromRGB(255, 240, 90), Color3.fromRGB(255, 110, 30) }, 90)

function Hud.critical()
	critLabel.Visible = true
	critLabel.TextTransparency = 0
	critLabel.Rotation = -8 + (math.random() - 0.5) * 8
	UIKit.pop(critLabel, 1.8)
	task.delay(0.7, function()
		local t = UIKit.tween(critLabel, 0.25, { TextTransparency = 1 })
		t.Completed:Connect(function()
			critLabel.Visible = false
		end)
	end)
end

----------------------------------------------------------------------
-- Power panel (bottom centre)
----------------------------------------------------------------------
local power = new("Frame", {
	Name = "Power",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(540, 150),
	AnchorPoint = Vector2.new(0.5, 1),
	Parent = root,
})
makeSlider("Power", power, UDim2.new(0.5, 0, 1, -18), UDim2.new(0.5, 0, 1, 200))

local powerBody = new("Frame", {
	BackgroundColor3 = C.Wood,
	Size = UDim2.new(0, 460, 0, 112),
	Position = UDim2.fromOffset(0, 36),
	Parent = power,
})
UIKit.corner(powerBody, 16)
UIKit.stroke(powerBody, 4)

local powerTag = new("Frame", {
	BackgroundColor3 = C.Green,
	Size = UDim2.fromOffset(150, 42),
	Position = UDim2.fromOffset(14, 14),
	Parent = power,
})
UIKit.corner(powerTag, 10)
UIKit.stroke(powerTag, 3)
UIKit.label({ Text = "⚡ POWER", Size = UDim2.new(1, -14, 1, -10), Position = UDim2.fromOffset(7, 5), Stroke = 3, Parent = powerTag })

local percent = UIKit.label({
	Text = "0%",
	TextXAlignment = Enum.TextXAlignment.Right,
	Size = UDim2.fromOffset(130, 38),
	Position = UDim2.new(0, 440, 0, 22),
	AnchorPoint = Vector2.new(1, 0),
	Stroke = 3,
	Parent = power,
})

local barBack = new("Frame", {
	BackgroundColor3 = Color3.fromRGB(30, 22, 18),
	Size = UDim2.fromOffset(424, 38),
	Position = UDim2.fromOffset(18, 64),
	Parent = power,
})
UIKit.corner(barBack, 12)
UIKit.stroke(barBack, 3)
local barClip = new("Frame", {
	BackgroundTransparency = 1,
	ClipsDescendants = true,
	Size = UDim2.new(0, 0, 1, -8),
	Position = UDim2.fromOffset(4, 4),
	Parent = barBack,
})
local barFill = new("Frame", {
	BackgroundColor3 = C.White,
	Size = UDim2.fromOffset(416, 30),
	Parent = barClip,
})
UIKit.corner(barFill, 9)
UIKit.gradient(barFill, {
	Color3.fromRGB(40, 140, 255),
	Color3.fromRGB(150, 70, 255),
	Color3.fromRGB(255, 60, 200),
	Color3.fromRGB(255, 70, 70),
	Color3.fromRGB(255, 170, 40),
	Color3.fromRGB(255, 240, 60),
	Color3.fromRGB(90, 230, 70),
}, 0)
for i = 1, 19 do
	new("Frame", {
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 2, 1, -8),
		Position = UDim2.new(i / 20, 0, 0, 4),
		Parent = barBack,
	})
end

local powerHint = UIKit.label({
	Text = "HOLD CLICK OR SPACE TO CHARGE",
	TextColor3 = Color3.fromRGB(255, 214, 80),
	Size = UDim2.fromOffset(424, 18),
	Position = UDim2.fromOffset(18, 112),
	Stroke = 2,
	Parent = power,
})

UIKit.closeButton(power, UDim2.fromOffset(500, 92), 5, function()
	Hud.Callbacks.CancelCharge()
end)

local maxPower = UIKit.label({
	Text = "MAX POWER!",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -176),
	Size = UDim2.fromOffset(380, 70),
	Visible = false,
	Stroke = 4,
	Parent = root,
})
UIKit.gradient(maxPower, { Color3.fromRGB(110, 255, 80), Color3.fromRGB(60, 220, 255), Color3.fromRGB(110, 120, 255) }, 0)

local wasMax = false
function Hud.setPower(p: number, charging: boolean)
	barClip.Size = UDim2.new(p, -8 * p, 1, -8)
	percent.Text = math.floor(p * 100 + 0.5) .. "%"
	powerHint.Text = if charging then "RELEASE TO LAUNCH!" else "HOLD CLICK OR SPACE TO CHARGE"
	local isMax = p >= 0.97
	if isMax and not wasMax then
		maxPower.Visible = true
		UIKit.pop(maxPower, 1.5)
		Effects.play("MaxPower", 1.6, 0.6)
	elseif not isMax and wasMax then
		maxPower.Visible = false
	end
	wasMax = isMax
end

----------------------------------------------------------------------
-- Hint pill (bottom centre during a run)
----------------------------------------------------------------------
local hint = pill(260, 40)
hint.AnchorPoint = Vector2.new(0.5, 1)
makeSlider("Hint", hint, UDim2.new(0.5, 0, 1, -22), UDim2.new(0.5, 0, 1, 80))
local hintLabel = UIKit.label({
	Text = if RunService:IsStudio() or not game:GetService("UserInputService").TouchEnabled
		then "A / D TO STEER"
		else "TOUCH LEFT / RIGHT TO STEER",
	Size = UDim2.new(1, -20, 0, 22),
	Position = UDim2.fromScale(0.5, 0.5),
	AnchorPoint = Vector2.new(0.5, 0.5),
	Stroke = 2,
	Parent = hint,
})
Hud.HintLabel = hintLabel

----------------------------------------------------------------------
-- Toasts
----------------------------------------------------------------------
local toastHolder = new("Frame", {
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(500, 200),
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 100),
	ZIndex = 50,
	Parent = root,
})
new("UIListLayout", {
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	Padding = UDim.new(0, 6),
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = toastHolder,
})

function Hud.toast(text: string, color: Color3?)
	local box = new("Frame", {
		BackgroundColor3 = color or C.Red,
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = toastHolder,
	})
	UIKit.corner(box, 10)
	UIKit.stroke(box, 3)
	new("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), Parent = box })
	local label = UIKit.label({
		Text = text,
		TextScaled = false,
		TextSize = 22,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		Stroke = 2.5,
		Parent = box,
	})
	UIKit.pop(box, 0.6)
	task.delay(1.8, function()
		UIKit.tween(box, 0.25, { BackgroundTransparency = 1 })
		UIKit.tween(label, 0.25, { TextTransparency = 1 })
		for _, d in box:GetChildren() do
			if d:IsA("UIStroke") then
				UIKit.tween(d, 0.25, { Transparency = 1 })
			end
		end
		local s = label:FindFirstChildOfClass("UIStroke")
		if s then
			UIKit.tween(s, 0.25, { Transparency = 1 })
		end
	end)
	Debris:AddItem(box, 2.2)
end

----------------------------------------------------------------------
-- Active boosts / storms (right side, with countdowns)
----------------------------------------------------------------------
local boostList = new("Frame", {
	Name = "Boosts",
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -16, 0.5, 20),
	Size = UDim2.fromOffset(250, 320),
	Parent = root,
})
new("UIListLayout", {
	Padding = UDim.new(0, 8),
	HorizontalAlignment = Enum.HorizontalAlignment.Right,
	VerticalAlignment = Enum.VerticalAlignment.Center,
	SortOrder = Enum.SortOrder.LayoutOrder,
	Parent = boostList,
})

type BoostEntry = { Key: string, Icon: string, Text: string, Color: Color3, EndsAt: number? }
local boostRows: { [string]: { Frame: Frame, Label: TextLabel, Entry: BoostEntry } } = {}

local function formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	if seconds >= 3600 then
		return string.format("%d:%02d:%02d", seconds // 3600, (seconds % 3600) // 60, seconds % 60)
	end
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- entries: list of { Key, Icon, Text, Color, EndsAt? (server time) }
function Hud.setBoosts(entries: { BoostEntry })
	local keep = {}
	for i, e in entries do
		keep[e.Key] = true
		local row = boostRows[e.Key]
		if not row then
			local f = new("Frame", {
				BackgroundColor3 = e.Color,
				Size = UDim2.fromOffset(0, 42),
				AutomaticSize = Enum.AutomaticSize.X,
				Parent = boostList,
			})
			UIKit.corner(f, 12)
			UIKit.stroke(f, 3)
			UIKit.gradient(f, { Color3.new(1, 1, 1), Color3.new(0.75, 0.75, 0.75) }, 90)
			new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 12), Parent = f })
			new("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				Padding = UDim.new(0, 6),
				Parent = f,
			})
			UIKit.label({ Text = e.Icon, Size = UDim2.fromOffset(30, 30), Stroke = 0, LayoutOrder = 1, Parent = f })
			local label = UIKit.label({
				Text = e.Text,
				TextScaled = false,
				TextSize = 19,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 30),
				Stroke = 2.5,
				LayoutOrder = 2,
				Parent = f,
			})
			row = { Frame = f, Label = label, Entry = e }
			boostRows[e.Key] = row
			UIKit.pop(f, 0.4)
		end
		row.Entry = e
		row.Frame.LayoutOrder = i
		row.Frame.BackgroundColor3 = e.Color
	end
	for key, row in boostRows do
		if not keep[key] then
			row.Frame:Destroy()
			boostRows[key] = nil
		end
	end
end

RunService.RenderStepped:Connect(function()
	local t = Workspace:GetServerTimeNow()
	for _, row in boostRows do
		local e = row.Entry
		row.Label.Text = if e.EndsAt then e.Text .. "  " .. formatTime(e.EndsAt - t) else e.Text
	end
end)

----------------------------------------------------------------------
-- Announcement banner (admin announcements, storms, purchases)
----------------------------------------------------------------------
local banner = new("Frame", {
	Name = "Announcement",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, -200),
	Size = UDim2.fromOffset(620, 118),
	BackgroundTransparency = 1,
	Visible = false,
	ZIndex = 40,
	Parent = root,
})
local bannerBody = new("Frame", {
	BackgroundColor3 = C.Wood,
	Size = UDim2.new(1, 0, 1, -24),
	Position = UDim2.fromOffset(0, 24),
	Parent = banner,
})
UIKit.corner(bannerBody, 16)
UIKit.stroke(bannerBody, 4)
local bannerHead = new("Frame", {
	BackgroundColor3 = C.Yellow,
	Size = UDim2.fromOffset(300, 44),
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 0),
	Parent = banner,
})
UIKit.corner(bannerHead, 12)
UIKit.stroke(bannerHead, 3.5)
local bannerTitle = UIKit.label({ Text = "📢 ANNOUNCEMENT", Size = UDim2.new(1, -20, 1, -12), Position = UDim2.fromOffset(10, 6), Stroke = 3, Parent = bannerHead })
local bannerText = UIKit.label({
	Text = "",
	TextWrapped = true,
	Size = UDim2.new(1, -40, 0, 54),
	Position = UDim2.fromOffset(20, 50),
	Stroke = 2.5,
	MaxTextSize = 30,
	Parent = banner,
})
local bannerToken = 0

function Hud.announce(title: string, text: string, color: Color3?)
	bannerToken += 1
	local token = bannerToken
	bannerTitle.Text = title
	bannerText.Text = text
	bannerHead.BackgroundColor3 = color or C.Yellow
	banner.Visible = true
	banner.Position = UDim2.new(0.5, 0, 0, -200)
	UIKit.tween(banner, 0.5, { Position = UDim2.new(0.5, 0, 0, 96) }, Enum.EasingStyle.Back)
	task.delay(6, function()
		if token ~= bannerToken then
			return
		end
		local t = UIKit.tween(banner, 0.35, { Position = UDim2.new(0.5, 0, 0, -200) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if token == bannerToken then
				banner.Visible = false
			end
		end)
	end)
end

----------------------------------------------------------------------
-- TURBO button (bottom right during a run, key T)
----------------------------------------------------------------------
local turboHolder = new("Frame", {
	Name = "Turbo",
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(150, 150),
	AnchorPoint = Vector2.new(1, 1),
	Parent = root,
})
makeSlider("Turbo", turboHolder, UDim2.new(1, -26, 1, -26), UDim2.new(1, 200, 1, -26))
local turboButton = UIKit.button({
	Size = UDim2.fromOffset(150, 150),
	Color = C.Red,
	DarkColor = C.RedDark,
	Text = "TURBO",
	Key = "T",
	Corner = 75,
	Parent = turboHolder,
	OnClick = function()
		Hud.Callbacks.Turbo()
	end,
})
turboButton.Label.Size = UDim2.new(1, -24, 0, 34)
turboButton.Label.Position = UDim2.new(0.5, 0, 0.62, 0)
turboButton.Label.AnchorPoint = Vector2.new(0.5, 0.5)
turboButton.Label.TextXAlignment = Enum.TextXAlignment.Center
UIKit.label({ Text = "🚀", Size = UDim2.fromOffset(56, 56), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.32, 0), Stroke = 0, Parent = turboButton.Face })
local turboCount = new("Frame", {
	BackgroundColor3 = C.Yellow,
	Size = UDim2.fromOffset(54, 34),
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(1, -18, 0, 18),
	ZIndex = 10,
	Parent = turboHolder,
})
UIKit.corner(turboCount, 10)
UIKit.stroke(turboCount, 3)
local turboCountLabel = UIKit.label({ Text = "x0", Size = UDim2.new(1, -8, 1, -6), Position = UDim2.fromOffset(4, 3), Stroke = 2.5, Parent = turboCount })

function Hud.setTurbos(n: number)
	turboCountLabel.Text = if n > 0 then "x" .. n else "+"
	if n > 0 then
		turboButton.SetColors(C.Red, C.RedDark)
		turboButton.SetText("TURBO")
	else
		turboButton.SetColors(C.Grey, C.GreyDark)
		turboButton.SetText("GET")
	end
end

function Hud.turboFired()
	UIKit.pop(turboHolder, 0.8)
end

----------------------------------------------------------------------
-- Modes
----------------------------------------------------------------------
Hud.Mode = "Idle"
function Hud.setMode(mode: string)
	Hud.Mode = mode
	local idle = mode == "Idle"
	slide("Wallet", idle or mode == "Charge" or mode == "Result")
	slide("Menu", idle)
	slide("Tabs", idle)
	slide("Power", mode == "Charge")
	slide("RunCoins", mode == "Rolling")
	slide("Distance", mode == "Rolling" or mode == "Result")
	slide("Speed", mode == "Rolling")
	slide("Hint", mode == "Rolling" and Effects.Settings.Hints)
	slide("Turbo", mode == "Rolling")
	boostList.Visible = mode ~= "Tree"
	if mode ~= "Charge" then
		maxPower.Visible = false
		wasMax = false
	end
	if mode ~= "Rolling" then
		comboTag.Visible = false
	end
end

----------------------------------------------------------------------
-- Per-frame smoothing of counters
----------------------------------------------------------------------
RunService.RenderStepped:Connect(function(dt)
	local a = 1 - math.exp(-dt * 9)
	if math.abs(targetCoins - shownCoins) > 0.5 then
		shownCoins += (targetCoins - shownCoins) * a
		if math.abs(targetCoins - shownCoins) < 1 then
			shownCoins = targetCoins
		end
	else
		shownCoins = targetCoins
	end
	coinsLabel.Text = Config.Commas(shownCoins)

	if math.abs(targetRunCoins - shownRunCoins) > 0.5 then
		shownRunCoins += (targetRunCoins - shownRunCoins) * math.min(1, a * 1.5)
	else
		shownRunCoins = targetRunCoins
	end
	runCoinsLabel.Text = Config.Commas(shownRunCoins)

	if comboTag.Visible and os.clock() > comboHideAt then
		comboTag.Visible = false
	end
end)

Hud.setMode("Idle")

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="793">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: menu panels (Settings, Stats, Shop, Rebirth, Admin) and the
-- "Run Complete!" results card.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Monetization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Monetization"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Effects = require(script.Parent:WaitForChild("Effects"))

local C = UIKit.Colors
local new = UIKit.new

local Panels = {}
Panels.Callbacks = {
	SetSetting = function(_key: string, _value: boolean) end,
	BuySkin = function(_id: string) end,
	BuyRobux = function(_kind: string, _key: string) end,
	Admin = function(_action: string, _args: { [string]: any }) end,
	Rebirth = function() end,
	Closed = function() end,
}

local panels: { [string]: UIKit.Panel } = {}
local data: any = nil

local function register(name: string, panel: UIKit.Panel)
	panels[name] = panel
	panel.OnClose = function()
		UIKit.closePanel(panel)
		Panels.Callbacks.Closed()
	end
end

function Panels.anyOpen(): boolean
	for _, p in panels do
		if p.IsOpen then
			return true
		end
	end
	return false
end

function Panels.closeAll()
	for _, p in panels do
		UIKit.closePanel(p)
	end
end

function Panels.open(name: string)
	for other, p in panels do
		if other ~= name then
			UIKit.closePanel(p)
		end
	end
	local p = panels[name]
	if p then
		UIKit.openPanel(p)
	end
end

-- A brown row with a label on the left
local function row(parent: Instance, order: number, text: string): Frame
	local r = new("Frame", {
		BackgroundColor3 = C.WoodLight,
		Size = UDim2.new(1, 0, 0, 58),
		LayoutOrder = order,
		Parent = parent,
	})
	UIKit.corner(r, 10)
	UIKit.stroke(r, 3)
	UIKit.label({
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.6, 0, 0, 28),
		Position = UDim2.new(0, 16, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Stroke = 2.5,
		Parent = r,
	})
	return r
end

local function list(parent: Instance, padding: number?)
	new("UIListLayout", {
		Padding = UDim.new(0, padding or 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = parent,
	})
end

----------------------------------------------------------------------
-- Settings
----------------------------------------------------------------------
local settingsPanel = UIKit.panel(Hud.Root, "Settings", "⚙️", 560, 538)
register("Settings", settingsPanel)
list(settingsPanel.Content)

local toggles: { [string]: UIKit.Button } = {}
local SETTINGS = {
	{ Key = "Music", Text = "Music" },
	{ Key = "SFX", Text = "SFX" },
	{ Key = "Shake", Text = "Camera Shake" },
	{ Key = "SpeedLines", Text = "Speed Lines" },
	{ Key = "Hints", Text = "Hints" },
	{ Key = "PerfectPush", Text = "Perfect Push (pass)" },
}
for i, s in SETTINGS do
	local r = row(settingsPanel.Content, i, s.Text)
	local b = UIKit.button({
		Size = UDim2.fromOffset(120, 46),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 2),
		Text = "ON",
		Studs = true,
		Parent = r,
	})
	b.Label.TextXAlignment = Enum.TextXAlignment.Center
	b.Clicked = function()
		Effects.play("Toggle", 1.1)
		local value = not Effects.Settings[s.Key]
		Panels.Callbacks.SetSetting(s.Key, value)
	end
	toggles[s.Key] = b
end

local function refreshSettings()
	for key, b in toggles do
		local on = Effects.Settings[key]
		b.SetText(if on then "ON" else "OFF")
		if on then
			b.SetColors(C.Green, C.GreenDark)
		else
			b.SetColors(C.Red, C.RedDark)
		end
	end
end
Panels.refreshSettings = refreshSettings

----------------------------------------------------------------------
-- Stats
----------------------------------------------------------------------
local statsPanel = UIKit.panel(Hud.Root, "Stats", "📊", 560, 520)
register("Stats", statsPanel)
list(statsPanel.Content, 8)

local statValues: { [string]: TextLabel } = {}
local STATS = {
	{ Key = "Runs", Text = "Runs" },
	{ Key = "BestEarn", Text = "Best Score" },
	{ Key = "BestDistance", Text = "Best Distance" },
	{ Key = "BestCombo", Text = "Best Combo" },
	{ Key = "TotalSmashed", Text = "Smashed" },
	{ Key = "Rebirths", Text = "Rebirths" },
}
for i, s in STATS do
	local r = row(statsPanel.Content, i, s.Text)
	r.Size = UDim2.new(1, 0, 0, 52)
	local valueBox = new("Frame", {
		BackgroundColor3 = C.WoodDark,
		Size = UDim2.fromOffset(170, 36),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Parent = r,
	})
	UIKit.corner(valueBox, 8)
	UIKit.stroke(valueBox, 2)
	statValues[s.Key] = UIKit.label({
		Text = "0",
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(1, -20, 0, 24),
		Position = UDim2.new(0, 10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Stroke = 2,
		Parent = valueBox,
	})
end

local function refreshStats()
	if not data then
		return
	end
	statValues.Runs.Text = Config.Commas(data.Runs)
	statValues.BestEarn.Text = Config.Commas(data.BestEarn)
	statValues.BestDistance.Text = Config.Commas(data.BestDistance) .. " STUDS"
	statValues.BestCombo.Text = "x" .. data.BestCombo
	statValues.TotalSmashed.Text = Config.Commas(data.TotalSmashed)
	statValues.Rebirths.Text = tostring(data.Rebirths)
end

----------------------------------------------------------------------
-- Shop: Robux passes, coins & boosts (developer products), snowball skins
----------------------------------------------------------------------
local shopPanel = UIKit.panel(Hud.Root, "Shop", "🛒", 860, 600)
register("Shop", shopPanel)

local passOwned: { [string]: boolean } = {}
local robuxPrices: { [string]: number } = {}

local tabBar = new("Frame", {
	BackgroundTransparency = 1,
	Size = UDim2.new(1, 0, 0, 54),
	Parent = shopPanel.Content,
})
new("UIListLayout", {
	FillDirection = Enum.FillDirection.Horizontal,
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	Padding = UDim.new(0, 12),
	Parent = tabBar,
})

local pages: { [string]: ScrollingFrame } = {}
local tabButtons: { [string]: UIKit.Button } = {}

local function page(name: string): ScrollingFrame
	local sf = new("ScrollingFrame", {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, -66),
		Position = UDim2.fromOffset(0, 66),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = C.Yellow,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = shopPanel.Content,
	})
	new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 10), Parent = sf })
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(240, 236),
		CellPadding = UDim2.fromOffset(16, 16),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = sf,
	})
	pages[name] = sf
	return sf
end

local function showTab(name: string)
	for n, p in pages do
		p.Visible = n == name
		local b = tabButtons[n]
		if n == name then
			b.SetColors(C.Yellow, C.YellowDark)
		else
			b.SetColors(C.WoodLight, C.WoodDark)
		end
	end
end
Panels.showShopTab = showTab

for i, tab in { { "Passes", "👑 Passes" }, { "Products", "💰 Coins & Boosts" }, { "Skins", "⛄ Skins" } } do
	local b = UIKit.button({
		Size = UDim2.fromOffset(230, 50),
		Text = tab[2],
		Parent = tabBar,
		OnClick = function()
			showTab(tab[1])
		end,
	})
	b.Holder.LayoutOrder = i
	b.Label.TextXAlignment = Enum.TextXAlignment.Center
	tabButtons[tab[1]] = b
end

type RobuxCard = { Button: UIKit.Button, Kind: string, Item: any }
local robuxCards: { [string]: RobuxCard } = {}

local function robuxCard(parent: Instance, order: number, kind: string, item)
	local card = new("Frame", { BackgroundColor3 = C.WoodLight, LayoutOrder = order, Parent = parent })
	UIKit.corner(card, 14)
	UIKit.stroke(card, 3)
	local band = new("Frame", {
		BackgroundColor3 = item.Color,
		Size = UDim2.new(1, -12, 0, 86),
		Position = UDim2.fromOffset(6, 6),
		Parent = card,
	})
	UIKit.corner(band, 10)
	UIKit.gradient(band, { Color3.new(1, 1, 1), Color3.new(0.72, 0.72, 0.72) }, 90)
	UIKit.studs(band, 228, 86, 16, 0.85)
	local icon = UIKit.label({ Text = item.Icon, Size = UDim2.fromOffset(70, 70), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Stroke = 0, Parent = band })
	-- idle wobble on the icon
	RunService.RenderStepped:Connect(function()
		if shopPanel.IsOpen then
			icon.Rotation = math.sin(os.clock() * 2 + order) * 8
		end
	end)
	UIKit.label({ Text = item.Name, Size = UDim2.new(1, -16, 0, 26), Position = UDim2.new(0.5, 0, 0, 96), AnchorPoint = Vector2.new(0.5, 0), Stroke = 2.5, Parent = card })
	UIKit.label({
		Text = item.Desc,
		TextScaled = false,
		TextSize = 15,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = Color3.fromRGB(255, 236, 200),
		Size = UDim2.new(1, -20, 0, 52),
		Position = UDim2.new(0.5, 0, 0, 124),
		AnchorPoint = Vector2.new(0.5, 0),
		Stroke = 1.5,
		Parent = card,
	})
	local b = UIKit.button({
		Size = UDim2.fromOffset(210, 46),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Color = C.Green,
		DarkColor = C.GreenDark,
		Text = "R$ " .. item.Price,
		Parent = card,
		OnClick = function()
			Panels.Callbacks.BuyRobux(kind, item.Key)
		end,
	})
	b.Label.TextXAlignment = Enum.TextXAlignment.Center
	robuxCards[item.Key] = { Button = b, Kind = kind, Item = item }
end

local passesPage = page("Passes")
for i, pass in Monetization.Passes do
	robuxCard(passesPage, i, "Pass", pass)
end
local productsPage = page("Products")
for i, product in Monetization.Products do
	robuxCard(productsPage, i, "Product", product)
end

local function refreshRobux()
	for key, card in robuxCards do
		local price = robuxPrices[key] or card.Item.Price
		if card.Kind == "Pass" and passOwned[key] then
			card.Button.SetText("✔ OWNED")
			card.Button.SetColors(C.Purple, C.PurpleDark)
		else
			card.Button.SetText("R$ " .. Config.Commas(price))
			card.Button.SetColors(C.Green, C.GreenDark)
		end
	end
end

function Panels.setRobuxPrice(key: string, price: number)
	robuxPrices[key] = price
	refreshRobux()
end

function Panels.setPasses(owned: { [string]: boolean })
	passOwned = owned
	refreshRobux()
	Panels.refresh(data)
end

-- skins
local skinsPage = page("Skins")
type SkinCard = { Button: UIKit.Button, Ball: Frame, Coin: Frame }
local skinCards: { [string]: SkinCard } = {}

for i, skin in Config.Skins do
	local card = new("Frame", { BackgroundColor3 = C.WoodLight, LayoutOrder = i, Parent = skinsPage })
	UIKit.corner(card, 14)
	UIKit.stroke(card, 3)
	local ball = new("Frame", {
		BackgroundColor3 = skin.Color,
		Size = UDim2.fromOffset(90, 90),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Parent = card,
	})
	UIKit.round(ball)
	UIKit.stroke(ball, 3)
	local shade = UIKit.gradient(ball, { Color3.new(1, 1, 1), Color3.new(0.7, 0.72, 0.8) }, 60)
	if skin.Rainbow then
		shade.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
			ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 230, 110)),
			ColorSequenceKeypoint.new(0.75, Color3.fromRGB(70, 150, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 90, 255)),
		})
		ball.BackgroundColor3 = Color3.new(1, 1, 1)
	end
	for k = 1, 3 do
		local clump = new("Frame", {
			BackgroundColor3 = skin.Clump,
			Size = UDim2.fromOffset(16 + k * 3, 16 + k * 3),
			Position = UDim2.fromScale(0.15 + k * 0.18, 0.2 + (k % 2) * 0.35),
			Parent = ball,
		})
		UIKit.round(clump)
	end
	RunService.RenderStepped:Connect(function()
		if shopPanel.IsOpen then
			ball.Rotation = (os.clock() * 40 + i * 50) % 360
		end
	end)
	UIKit.label({ Text = skin.Name, Size = UDim2.new(1, -16, 0, 26), Position = UDim2.new(0.5, 0, 0, 108), AnchorPoint = Vector2.new(0.5, 0), Stroke = 2.5, Parent = card })
	UIKit.label({
		Text = if skin.Bonus > 0 then "+" .. math.floor(skin.Bonus * 100) .. "% coins" else "Starter ball",
		TextColor3 = Color3.fromRGB(140, 255, 110),
		Size = UDim2.new(1, -16, 0, 20),
		Position = UDim2.new(0.5, 0, 0, 138),
		AnchorPoint = Vector2.new(0.5, 0),
		Stroke = 2,
		Parent = card,
	})
	local b = UIKit.button({
		Size = UDim2.fromOffset(210, 46),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Text = "",
		Parent = card,
		OnClick = function()
			if skin.Pass and not passOwned[skin.Pass] then
				Panels.Callbacks.BuyRobux("Pass", skin.Pass)
			else
				Panels.Callbacks.BuySkin(skin.Id)
			end
		end,
	})
	b.Label.TextXAlignment = Enum.TextXAlignment.Center
	local coinIcon = UIKit.coin(b.Face, 26, UDim2.new(0, 12, 0.5, 0), Vector2.new(0, 0.5))
	skinCards[skin.Id] = { Button = b, Ball = ball, Coin = coinIcon }
end

local function refreshShop()
	refreshRobux()
	if not data then
		return
	end
	for id, card in skinCards do
		local skin = Config.SkinById[id]
		local unlocked = data.Skins[id] or (skin.Pass ~= nil and passOwned[skin.Pass])
		card.Coin.Visible = not unlocked and skin.Pass == nil
		if data.Skin == id then
			card.Button.SetText("Equipped")
			card.Button.SetColors(C.Purple, C.PurpleDark)
		elseif unlocked then
			card.Button.SetText("Equip")
			card.Button.SetColors(C.Blue, C.BlueDark)
		elseif skin.Pass then
			local pass = Monetization.PassByKey[skin.Pass]
			card.Button.SetText("R$ " .. Config.Commas(robuxPrices[skin.Pass] or pass.Price))
			card.Button.SetColors(C.Green, C.GreenDark)
		else
			card.Button.SetText(Config.Short(skin.Price))
			if data.Coins >= skin.Price then
				card.Button.SetColors(C.Green, C.GreenDark)
			else
				card.Button.SetColors(C.Grey, C.GreyDark)
			end
		end
	end
end

showTab("Passes")

function Panels.anySkinAffordable(d: any): boolean
	if not d then
		return false
	end
	for _, skin in Config.Skins do
		if not skin.Pass and not d.Skins[skin.Id] and d.Coins >= skin.Price then
			return true
		end
	end
	return false
end

----------------------------------------------------------------------
-- Admin panel (only shown to admins; every action is checked on the server)
----------------------------------------------------------------------
local adminPanel = UIKit.panel(Hud.Root, "Admin Panel", "🛡️", 860, 600)
register("Admin", adminPanel)

local adminScroll = new("ScrollingFrame", {
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Size = UDim2.fromScale(1, 1),
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollBarThickness = 8,
	ScrollBarImageColor3 = C.Yellow,
	ScrollingDirection = Enum.ScrollingDirection.Y,
	Parent = adminPanel.Content,
})
new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = adminScroll })
new("UIPadding", { PaddingRight = UDim.new(0, 14), PaddingBottom = UDim.new(0, 12), Parent = adminScroll })

local sectionOrder = 0
local function section(title: string, height: number): Frame
	sectionOrder += 1
	local f = new("Frame", {
		BackgroundColor3 = C.WoodLight,
		Size = UDim2.new(1, 0, 0, height),
		LayoutOrder = sectionOrder,
		Parent = adminScroll,
	})
	UIKit.corner(f, 12)
	UIKit.stroke(f, 3)
	UIKit.label({ Text = title, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -24, 0, 28), Position = UDim2.fromOffset(14, 8), Stroke = 2.5, Parent = f })
	return f
end

local function smallButton(parent: Instance, text: string, size: UDim2, position: UDim2, color: Color3, dark: Color3, onClick: () -> ()): UIKit.Button
	local b = UIKit.button({ Size = size, Position = position, Color = color, DarkColor = dark, Text = text, Parent = parent, OnClick = onClick, Corner = 10 })
	b.Label.TextXAlignment = Enum.TextXAlignment.Center
	return b
end

local function admin(action: string, args: { [string]: any })
	Panels.Callbacks.Admin(action, args)
end

-- announcement
local annSection = section("📢 Announcement (everyone sees it)", 100)
local annBox = UIKit.textbox(annSection, "Type an announcement...", UDim2.new(1, -170, 0, 46), UDim2.fromOffset(14, 44))
smallButton(annSection, "Send", UDim2.fromOffset(130, 46), UDim2.new(1, -144, 0, 42), C.Green, C.GreenDark, function()
	admin("Announce", { Text = annBox.Text })
	annBox.Text = ""
end)

-- storms
local stormSection = section("🌪️ Storms & events (whole server)", 288)
local durations = { 1, 5, 15, 30 }
local chosenMinutes = 5
local durationButtons: { [number]: UIKit.Button } = {}
UIKit.label({ Text = "Duration:", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromOffset(110, 24), Position = UDim2.fromOffset(14, 50), Stroke = 2, Parent = stormSection })
local function refreshDurations()
	for m, b in durationButtons do
		if m == chosenMinutes then
			b.SetColors(C.Yellow, C.YellowDark)
		else
			b.SetColors(C.WoodDark, Color3.fromRGB(40, 24, 14))
		end
	end
end
for i, m in durations do
	durationButtons[m] = smallButton(stormSection, m .. " min", UDim2.fromOffset(96, 40), UDim2.fromOffset(124 + (i - 1) * 106, 42), C.WoodDark, C.Outline, function()
		chosenMinutes = m
		refreshDurations()
	end)
end
refreshDurations()

local eventButtons: { [string]: UIKit.Button } = {}
for i, e in Config.Events do
	local col = (i - 1) % 3
	local rowI = (i - 1) // 3
	local b = UIKit.button({
		Size = UDim2.fromOffset(246, 56),
		Position = UDim2.fromOffset(14 + col * 258, 96 + rowI * 66),
		Color = e.Color,
		DarkColor = Color3.new(e.Color.R * 0.6, e.Color.G * 0.6, e.Color.B * 0.6),
		Text = e.Name,
		Icon = e.Icon,
		Parent = stormSection,
		Corner = 10,
		OnClick = function()
			admin("StartEvent", { Id = e.Id, Minutes = chosenMinutes })
		end,
	})
	eventButtons[e.Id] = b
end
smallButton(stormSection, "⛔ Stop all storms", UDim2.fromOffset(250, 46), UDim2.fromOffset(14, 230), C.Red, C.RedDark, function()
	admin("StopEvent", { Id = "All" })
end)

-- players
local giveSection = section("🎁 Give to a player (leave the name empty = yourself)", 160)
local targetBox = UIKit.textbox(giveSection, "Player name (empty = me)", UDim2.fromOffset(380, 46), UDim2.fromOffset(14, 44))
local amountBox = UIKit.textbox(giveSection, "Amount", UDim2.fromOffset(200, 46), UDim2.fromOffset(408, 44))
smallButton(giveSection, "🪙 Give Coins", UDim2.fromOffset(250, 48), UDim2.fromOffset(14, 102), C.Yellow, C.YellowDark, function()
	admin("GiveCoins", { Target = targetBox.Text, Amount = tonumber(amountBox.Text) })
end)
smallButton(giveSection, "🚀 Give Turbos", UDim2.fromOffset(250, 48), UDim2.fromOffset(278, 102), C.Red, C.RedDark, function()
	admin("GiveTurbos", { Target = targetBox.Text, Amount = tonumber(amountBox.Text) or 5 })
end)

-- game passes
local passSection = section("👑 Game passes (uses the player name above)", 52 + #Monetization.Passes * 56)
for i, pass in Monetization.Passes do
	local y = 46 + (i - 1) * 56
	UIKit.label({
		Text = pass.Icon .. "  " .. pass.Name,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.fromOffset(300, 30),
		Position = UDim2.fromOffset(18, y + 8),
		Stroke = 2,
		Parent = passSection,
	})
	smallButton(passSection, "Give", UDim2.fromOffset(150, 46), UDim2.fromOffset(340, y), C.Green, C.GreenDark, function()
		admin("SetPass", { Target = targetBox.Text, Pass = pass.Key, Give = true })
	end)
	smallButton(passSection, "Remove", UDim2.fromOffset(150, 46), UDim2.fromOffset(504, y), C.Red, C.RedDark, function()
		admin("SetPass", { Target = targetBox.Text, Pass = pass.Key, Give = false })
	end)
end

-- highlight running storms
RunService.RenderStepped:Connect(function()
	if not adminPanel.IsOpen then
		return
	end
	local state = ReplicatedStorage:FindFirstChild("GameState")
	local t = workspace:GetServerTimeNow()
	for id, b in eventButtons do
		local ends = state and state:GetAttribute("Event_" .. id)
		local on = type(ends) == "number" and ends > t
		b.SetText(Config.EventById[id].Name .. (if on then " ✔" else ""))
	end
end)

----------------------------------------------------------------------
-- Rebirth
----------------------------------------------------------------------
local rebirthPanel = UIKit.panel(Hud.Root, "Rebirth", "🔄", 560, 430)
register("Rebirth", rebirthPanel)

local rebirthInfo = UIKit.label({
	Text = "",
	RichText = true,
	TextScaled = false,
	TextSize = 22,
	TextWrapped = true,
	Size = UDim2.new(1, -10, 0, 150),
	Position = UDim2.fromOffset(5, 0),
	Stroke = 2,
	Parent = rebirthPanel.Content,
})
local rebirthBonus = UIKit.label({
	Text = "",
	TextColor3 = Color3.fromRGB(140, 255, 110),
	Size = UDim2.new(1, -10, 0, 30),
	Position = UDim2.fromOffset(5, 160),
	Stroke = 2.5,
	Parent = rebirthPanel.Content,
})
local rebirthButton = UIKit.button({
	Size = UDim2.fromOffset(300, 64),
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, 0),
	Color = C.Purple,
	DarkColor = C.PurpleDark,
	Text = "Rebirth",
	Icon = "🔄",
	Studs = true,
	Parent = rebirthPanel.Content,
	OnClick = function()
		Panels.Callbacks.Rebirth()
	end,
})

local function refreshRebirth()
	if not data then
		return
	end
	local cost = Config.RebirthCost(data.Rebirths)
	rebirthInfo.Text = string.format(
		'Reset your coins and upgrades to get a <font color="#FFD23C">permanent coin bonus</font>.\nSkins and stats are kept.\n\nCost: <font color="#FFD23C">%s coins</font>',
		Config.Commas(cost)
	)
	local now = math.floor(data.Rebirths * Config.Rebirth.BonusPer * 100)
	local nextB = math.floor((data.Rebirths + 1) * Config.Rebirth.BonusPer * 100)
	rebirthBonus.Text = string.format("Coin bonus: +%d%%  →  +%d%%", now, nextB)
	if data.Coins >= cost then
		rebirthButton.SetColors(C.Purple, C.PurpleDark)
	else
		rebirthButton.SetColors(C.Grey, C.GreyDark)
	end
end

function Panels.canRebirth(d: any): boolean
	return d ~= nil and d.Coins >= Config.RebirthCost(d.Rebirths)
end

----------------------------------------------------------------------
-- Result card ("Run Complete!")
----------------------------------------------------------------------
local result = UIKit.panel(Hud.Root, "Run Complete!", "🏆", 520, 470, false)
result.Root.Name = "ResultCard"

local resultTitle = UIKit.label({
	Text = "NEW BEST!",
	Size = UDim2.new(1, 0, 0, 46),
	Position = UDim2.fromOffset(0, 0),
	Stroke = 3.5,
	Parent = result.Content,
})
local resultGradient = UIKit.gradient(resultTitle, {
	Color3.fromRGB(80, 255, 160),
	Color3.fromRGB(60, 200, 255),
	Color3.fromRGB(120, 90, 255),
	Color3.fromRGB(255, 80, 200),
}, 0)
UIKit.label({
	Text = "You earned:",
	Size = UDim2.new(1, 0, 0, 26),
	Position = UDim2.fromOffset(0, 50),
	Stroke = 2.5,
	Parent = result.Content,
})
local earnedRow = new("Frame", {
	BackgroundTransparency = 1,
	Size = UDim2.fromOffset(330, 70),
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 80),
	Parent = result.Content,
})
local earnedCoin = UIKit.coin(earnedRow, 60, UDim2.new(0, 0, 0.5, 0), Vector2.new(0, 0.5))
local earnedLabel = UIKit.label({
	Text = "+0",
	TextColor3 = Color3.fromRGB(110, 255, 90),
	TextXAlignment = Enum.TextXAlignment.Left,
	Size = UDim2.new(1, -72, 0, 60),
	Position = UDim2.new(0, 72, 0.5, 0),
	AnchorPoint = Vector2.new(0, 0.5),
	Stroke = 4,
	Parent = earnedRow,
})

local tiles: { TextLabel } = {}
local TILE_ICONS = { "🏁", "🔨", "🔥" }
for i = 1, 3 do
	local tile = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(56, 34, 22),
		Size = UDim2.fromOffset(142, 58),
		Position = UDim2.fromOffset((i - 1) * 157, 164),
		Parent = result.Content,
	})
	UIKit.corner(tile, 10)
	UIKit.stroke(tile, 2.5, C.WoodLight)
	UIKit.label({ Text = TILE_ICONS[i], Size = UDim2.fromOffset(36, 36), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Stroke = 0, Parent = tile })
	tiles[i] = UIKit.label({
		Text = "0",
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -60, 0, 28),
		Position = UDim2.new(0, 52, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Stroke = 2.5,
		Parent = tile,
	})
end

local onRetry: () -> () = function() end
local onReturn: () -> () = function() end

local retryButton = UIKit.button({
	Size = UDim2.fromOffset(222, 70),
	Position = UDim2.new(0, 0, 1, -70),
	Color = C.Green,
	DarkColor = C.GreenDark,
	Text = "Retry",
	Studs = true,
	Key = "R",
	Parent = result.Content,
	OnClick = function()
		onRetry()
	end,
})
retryButton.Label.TextXAlignment = Enum.TextXAlignment.Center
local returnButton = UIKit.button({
	Size = UDim2.fromOffset(222, 70),
	Position = UDim2.new(1, -222, 1, -70),
	Color = C.Yellow,
	DarkColor = C.YellowDark,
	Text = "Return",
	Studs = true,
	Key = "Q",
	Parent = result.Content,
	OnClick = function()
		onReturn()
	end,
})
returnButton.Label.TextXAlignment = Enum.TextXAlignment.Center

Panels.ResultOpen = false

RunService.RenderStepped:Connect(function()
	if result.IsOpen then
		resultGradient.Offset = Vector2.new(math.sin(os.clock() * 2) * 0.3, 0)
	end
end)

export type RunResult = { Earned: number, NewBest: boolean, Distance: number, Smashed: number, Combo: number }

function Panels.showResult(r: RunResult, retry: () -> (), back: () -> ())
	onRetry = retry
	onReturn = back
	Panels.ResultOpen = true
	if r.NewBest and r.Earned > 0 then
		resultTitle.Text = "NEW BEST!"
		resultGradient.Enabled = true
		resultTitle.TextColor3 = C.White
	else
		resultGradient.Enabled = false
		if r.Earned >= 1000 then
			resultTitle.Text = "GREAT ROLL!"
			resultTitle.TextColor3 = Color3.fromRGB(255, 220, 60)
		elseif r.Earned >= 100 then
			resultTitle.Text = "NICE ROLL!"
			resultTitle.TextColor3 = Color3.fromRGB(255, 220, 60)
		else
			resultTitle.Text = "KEEP ROLLING!"
			resultTitle.TextColor3 = Color3.fromRGB(150, 210, 255)
		end
	end
	tiles[1].Text = Config.Commas(r.Distance)
	tiles[2].Text = Config.Commas(r.Smashed)
	tiles[3].Text = "x" .. math.max(1, r.Combo)
	earnedLabel.Text = "+0"
	UIKit.openPanel(result)
	UIKit.pop(resultTitle, 1.6)

	-- count the coins up
	task.spawn(function()
		task.wait(0.25)
		local duration = 0.9
		local start = os.clock()
		local lastTick = 0
		while Panels.ResultOpen do
			local t = math.min(1, (os.clock() - start) / duration)
			local eased = 1 - (1 - t) ^ 3
			earnedLabel.Text = "+" .. Config.Commas(r.Earned * eased)
			if os.clock() - lastTick > 0.07 and t < 1 then
				lastTick = os.clock()
				Effects.play("Coin", 1 + t * 0.8, 0.25)
			end
			if t >= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
		UIKit.pop(earnedCoin, 1.4)
		UIKit.pop(earnedLabel, 1.2)
	end)
end

function Panels.hideResult()
	Panels.ResultOpen = false
	UIKit.closePanel(result)
end

----------------------------------------------------------------------
-- Refresh everything from new player data
----------------------------------------------------------------------
function Panels.refresh(newData: any)
	data = newData
	refreshSettings()
	refreshStats()
	refreshShop()
	refreshRebirth()
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="794">
          <Properties>
            <string name="Name">UpgradeTree</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: hexagon upgrade tree. Drag to pan, scroll / pinch to zoom,
-- click a hex to see its card and buy it.

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))
local Hud = require(script.Parent:WaitForChild("Hud"))

local C = UIKit.Colors
local new = UIKit.new

local UpgradeTree = {}
UpgradeTree.IsOpen = false
UpgradeTree.OnBuy = function(_nodeId: string) end
UpgradeTree.OnClosed = function() end
-- defined further down
UpgradeTree.select = function(_id: string?) end
UpgradeTree.close = function() end

local SQ3 = math.sqrt(3)
local R = 48 -- hex radius in px
local LAYOUT = R + 9 -- spacing radius

local COLORS = {
	Outline = Color3.fromRGB(26, 16, 44),
	Owned = Color3.fromRGB(160, 100, 250),
	OwnedInner = Color3.fromRGB(128, 72, 226),
	Available = Color3.fromRGB(64, 152, 255),
	AvailableInner = Color3.fromRGB(42, 112, 232),
	Locked = Color3.fromRGB(72, 58, 104),
	LockedInner = Color3.fromRGB(56, 44, 84),
	Start = Color3.fromRGB(70, 214, 214),
	StartInner = Color3.fromRGB(40, 170, 186),
	Glow = Color3.fromRGB(255, 214, 60),
}

----------------------------------------------------------------------
-- Hexagon from three rotated rectangles
----------------------------------------------------------------------
local function hex(parent: Instance, radius: number, color: Color3): (Frame, { Frame })
	local holder = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(radius * 2, radius * 2),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local rects = {}
	for i = 0, 2 do
		rects[i + 1] = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(radius, radius * SQ3),
			Rotation = i * 60,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = holder,
		})
	end
	return holder, rects
end

local function paint(rects: { Frame }, color: Color3, transparency: number?)
	for _, r in rects do
		r.BackgroundColor3 = color
		if transparency then
			r.BackgroundTransparency = transparency
		end
	end
end

local function axialToPixel(q: number, r: number): Vector2
	return Vector2.new(LAYOUT * 1.5 * q, LAYOUT * SQ3 * (r + q / 2))
end

----------------------------------------------------------------------
-- Build
----------------------------------------------------------------------
type NodeView = {
	Id: string,
	Holder: Frame,
	Scale: UIScale,
	Glow: { Frame },
	Main: { Frame },
	Inner: { Frame },
	Icon: TextLabel,
	State: string,
}

local overlay = new("Frame", {
	Name = "UpgradeTree",
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	ZIndex = 30,
	Parent = Hud.Root,
})
local dim = new("Frame", {
	BackgroundColor3 = Color3.fromRGB(14, 10, 30),
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 1,
	Parent = overlay,
})
local capture = new("TextButton", {
	Name = "Capture",
	BackgroundTransparency = 1,
	Text = "",
	AutoButtonColor = false,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 2,
	Parent = overlay,
})
local canvas = new("Frame", {
	Name = "Canvas",
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(0, 0),
	ZIndex = 3,
	Parent = overlay,
})
local zoomScale = new("UIScale", { Parent = canvas })

local views: { [string]: NodeView } = {}
local selected: string? = nil
local data: any = nil

local function makeNode(id: string, q: number, r: number, icon: string, title: string, tier: number?): NodeView
	local pos = axialToPixel(q, r)
	local holder = new("Frame", {
		Name = id,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(pos.X, pos.Y),
		Size = UDim2.fromOffset(R * 2 + 16, R * 2 + 16),
		BackgroundTransparency = 1,
		Parent = canvas,
	})
	local scale = new("UIScale", { Parent = holder })
	local _, glow = hex(holder, R + 7, COLORS.Glow)
	local _, outline = hex(holder, R + 3, COLORS.Outline)
	local _, main = hex(holder, R - 1, COLORS.Locked)
	local _, inner = hex(holder, R - 9, COLORS.LockedInner)
	local _ = outline

	local iconLabel = UIKit.label({
		Text = icon,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.54),
		Size = UDim2.fromOffset(R * 1.05, R * 1.05),
		Stroke = 0,
		Parent = holder,
	})
	UIKit.label({
		Text = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -R * 0.66),
		Size = UDim2.fromOffset(R * 1.35, 13),
		Stroke = 1.5,
		Parent = holder,
	})
	if tier then
		UIKit.label({
			Text = tostring(tier),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, R * 0.5, 0.5, R * 0.48),
			Size = UDim2.fromOffset(22, 22),
			Stroke = 2.5,
			Parent = holder,
		})
	end

	local hit = new("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(R * 1.7, R * 1.7),
		Parent = holder,
	})

	local view: NodeView = {
		Id = id,
		Holder = holder,
		Scale = scale,
		Glow = glow,
		Main = main,
		Inner = inner,
		Icon = iconLabel,
		State = "Locked",
	}

	hit.MouseEnter:Connect(function()
		UIKit.tween(scale, 0.2, { Scale = 1.1 }, Enum.EasingStyle.Back)
	end)
	hit.MouseLeave:Connect(function()
		UIKit.tween(scale, 0.2, { Scale = 1 })
	end)
	hit.Activated:Connect(function()
		UIKit.PlaySound("Click", 1.3)
		UIKit.pop(holder, 0.85)
		if id ~= "Start" then
			UpgradeTree.select(id)
		end
	end)

	views[id] = view
	return view
end

local startView = makeNode("Start", 0, 0, "⛄", "Start", nil)
paint(startView.Main, COLORS.Start)
paint(startView.Inner, COLORS.StartInner)
paint(startView.Glow, COLORS.Glow, 1)

for _, node in Config.NodeList do
	makeNode(node.Id, node.Q, node.R, node.Branch.Icon, node.Title, node.Tier)
end

----------------------------------------------------------------------
-- Side coin box, close + recenter buttons, hint
----------------------------------------------------------------------
local coinBox = new("Frame", {
	BackgroundColor3 = C.Slate,
	BackgroundTransparency = 0.25,
	Size = UDim2.fromOffset(190, 60),
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 20, 0.5, 0),
	ZIndex = 4,
	Parent = overlay,
})
UIKit.corner(coinBox, 12)
UIKit.stroke(coinBox, 3)
UIKit.coin(coinBox, 42, UDim2.new(0, 10, 0.5, 0), Vector2.new(0, 0.5))
local coinBoxLabel = UIKit.label({
	Text = "0",
	TextXAlignment = Enum.TextXAlignment.Left,
	Size = UDim2.new(1, -72, 0, 32),
	Position = UDim2.new(0, 62, 0.5, 0),
	AnchorPoint = Vector2.new(0, 0.5),
	Stroke = 3,
	Parent = coinBox,
})

UIKit.label({
	Text = if UserInputService.TouchEnabled then "DRAG TO MOVE  ·  PINCH TO ZOOM" else "DRAG TO MOVE  ·  SCROLL TO ZOOM",
	TextXAlignment = Enum.TextXAlignment.Left,
	Size = UDim2.fromOffset(330, 16),
	Position = UDim2.new(0, 20, 1, -28),
	Stroke = 2,
	ZIndex = 4,
	Parent = overlay,
})

local closeButton = UIKit.button({
	Size = UDim2.fromOffset(190, 62),
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -16),
	Color = C.Red,
	DarkColor = C.RedDark,
	Text = "Close",
	Studs = true,
	ZIndex = 5,
	Parent = overlay,
	OnClick = function()
		UpgradeTree.close()
	end,
})
closeButton.Label.TextXAlignment = Enum.TextXAlignment.Center

local panTarget = Vector2.zero
local pan = Vector2.zero
local zoomTarget = 1
local zoom = 1

local recenter = UIKit.button({
	Size = UDim2.fromOffset(62, 62),
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0.5, 108, 1, -16),
	Color = C.Slate,
	DarkColor = Color3.fromRGB(18, 22, 32),
	Text = "🔍",
	ZIndex = 5,
	Parent = overlay,
	OnClick = function()
		panTarget = Vector2.zero
		zoomTarget = 1
	end,
})
recenter.Label.Size = UDim2.new(1, -14, 0.7, 0)

----------------------------------------------------------------------
-- Tooltip card
----------------------------------------------------------------------
local tip = new("Frame", {
	Name = "Tooltip",
	BackgroundColor3 = C.Wood,
	Size = UDim2.fromOffset(300, 196),
	AnchorPoint = Vector2.new(0, 0.5),
	Visible = false,
	ZIndex = 40,
	Parent = overlay,
})
UIKit.corner(tip, 12)
UIKit.stroke(tip, 3.5)
local tipScale = new("UIScale", { Parent = tip })
local tipHeader = new("Frame", {
	BackgroundColor3 = C.Purple,
	Size = UDim2.new(1, 8, 0, 34),
	Position = UDim2.fromOffset(-4, -6),
	Parent = tip,
})
UIKit.corner(tipHeader, 10)
UIKit.stroke(tipHeader, 3)
UIKit.gradient(tipHeader, { Color3.fromRGB(190, 140, 255), C.Purple }, 90)
local tipTitle = UIKit.label({ Text = "", Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 6), Stroke = 2.5, Parent = tipHeader })

local tipIconBox = new("Frame", {
	BackgroundColor3 = C.Purple,
	Size = UDim2.fromOffset(62, 62),
	Position = UDim2.fromOffset(12, 40),
	Parent = tip,
})
UIKit.corner(tipIconBox, 12)
UIKit.stroke(tipIconBox, 3)
local tipIcon = UIKit.label({ Text = "", Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), Stroke = 0, Parent = tipIconBox })
local tipDesc = UIKit.label({
	Text = "",
	TextScaled = false,
	TextSize = 16,
	TextWrapped = true,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	Size = UDim2.fromOffset(204, 62),
	Position = UDim2.fromOffset(84, 42),
	Stroke = 1.5,
	Parent = tip,
})
local tipStat = UIKit.label({
	Text = "",
	RichText = true,
	TextXAlignment = Enum.TextXAlignment.Left,
	Size = UDim2.fromOffset(276, 20),
	Position = UDim2.fromOffset(12, 108),
	Stroke = 2,
	Parent = tip,
})
local tipStatus = UIKit.label({
	Text = "",
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.fromRGB(255, 90, 90),
	Size = UDim2.fromOffset(276, 16),
	Position = UDim2.fromOffset(12, 130),
	Stroke = 2,
	Parent = tip,
})
local buyButton = UIKit.button({
	Size = UDim2.fromOffset(276, 44),
	Position = UDim2.fromOffset(12, 148),
	Color = C.Grey,
	DarkColor = C.GreyDark,
	Text = "0",
	Parent = tip,
	OnClick = function()
		if selected then
			UpgradeTree.OnBuy(selected)
		end
	end,
})
buyButton.Label.TextXAlignment = Enum.TextXAlignment.Center
UIKit.coin(buyButton.Face, 28, UDim2.new(0, 12, 0.5, 0), Vector2.new(0, 0.5))

local function nodeState(id: string): string
	if not data then
		return "Locked"
	end
	if data.Owned[id] then
		return "Owned"
	end
	local node = Config.Nodes[id]
	if node.Requires == "Start" or data.Owned[node.Requires] then
		return if data.Coins >= node.Cost then "Affordable" else "Available"
	end
	return "Locked"
end

local function refreshTooltip()
	local id = selected
	if not id or not data then
		return
	end
	local node = Config.Nodes[id]
	local branch = node.Branch
	local state = nodeState(id)
	local level = Config.BranchLevel(data.Owned, branch.Id)

	tipTitle.Text = node.Title
	tipIcon.Text = branch.Icon
	tipDesc.Text = branch.Desc
	local before = Config.StatText(branch, node.Tier - 1)
	local after = Config.StatText(branch, node.Tier)
	tipStat.Text = string.format('%s: %s → <font color="#7CFF5A">%s</font>', branch.Stat, before, after)
	tipIconBox.BackgroundColor3 = if state == "Owned" then COLORS.Owned elseif state == "Locked" then COLORS.Locked else COLORS.Available

	buyButton.SetText(Config.Commas(node.Cost))
	if state == "Owned" then
		tipStatus.Text = "✔ OWNED"
		tipStatus.TextColor3 = Color3.fromRGB(130, 255, 110)
		buyButton.SetColors(C.Purple, C.PurpleDark)
		buyButton.SetText("Owned")
	elseif state == "Locked" then
		tipStatus.Text = "Requires " .. Config.Nodes[node.Requires].Title
		tipStatus.TextColor3 = Color3.fromRGB(255, 120, 120)
		buyButton.SetColors(C.Grey, C.GreyDark)
	elseif state == "Available" then
		tipStatus.Text = "Need " .. Config.Commas(node.Cost - data.Coins) .. " more coins"
		tipStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
		buyButton.SetColors(C.Grey, C.GreyDark)
	else
		tipStatus.Text = if level >= node.Tier - 1 then "Ready to buy!" else ""
		tipStatus.TextColor3 = Color3.fromRGB(130, 255, 110)
		buyButton.SetColors(C.Green, C.GreenDark)
	end
end

local function placeTooltip()
	local id = selected
	if not id then
		return
	end
	local view = views[id]
	local s = Hud.UIScale
	local abs = view.Holder.AbsolutePosition + view.Holder.AbsoluteSize / 2
	local p = abs / s
	local screen = Hud.Root.AbsoluteSize / s
	local offset = R * zoom + 18
	if p.X + offset + 300 > screen.X - 10 then
		tip.AnchorPoint = Vector2.new(1, 0.5)
		tip.Position = UDim2.fromOffset(p.X - offset, math.clamp(p.Y, 110, screen.Y - 110))
	else
		tip.AnchorPoint = Vector2.new(0, 0.5)
		tip.Position = UDim2.fromOffset(p.X + offset, math.clamp(p.Y, 110, screen.Y - 110))
	end
end

UpgradeTree.select = function(id: string?)
	selected = id
	if id then
		refreshTooltip()
		placeTooltip()
		tip.Visible = true
		tipScale.Scale = 0.6
		UIKit.tween(tipScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		tip.Visible = false
	end
end

----------------------------------------------------------------------
-- Refresh node colours from player data
----------------------------------------------------------------------
function UpgradeTree.refresh(newData: any)
	data = newData
	if not data then
		return
	end
	coinBoxLabel.Text = Config.Short(data.Coins)
	for id, view in views do
		if id ~= "Start" then
			local state = nodeState(id)
			view.State = state
			if state == "Owned" then
				paint(view.Main, COLORS.Owned)
				paint(view.Inner, COLORS.OwnedInner)
				view.Icon.TextTransparency = 0
			elseif state == "Available" or state == "Affordable" then
				paint(view.Main, COLORS.Available)
				paint(view.Inner, COLORS.AvailableInner)
				view.Icon.TextTransparency = 0
			else
				paint(view.Main, COLORS.Locked)
				paint(view.Inner, COLORS.LockedInner)
				view.Icon.TextTransparency = 0.45
			end
		end
	end
	refreshTooltip()
end

-- Is there anything the player can buy right now? (drives the "!" badge)
function UpgradeTree.anyAffordable(d: any): boolean
	if not d then
		return false
	end
	for _, node in Config.NodeList do
		if not d.Owned[node.Id] and (node.Requires == "Start" or d.Owned[node.Requires]) and d.Coins >= node.Cost then
			return true
		end
	end
	return false
end

-- Celebrate a purchase: bounce the hex and throw out some sparkles
function UpgradeTree.celebrate(id: string)
	local view = views[id]
	if not view then
		return
	end
	UIKit.pop(view.Holder, 1.45)
	for i = 1, 12 do
		local a = (i / 12) * math.pi * 2
		local spark = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = view.Holder.Position,
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = if i % 2 == 0 then COLORS.Glow else C.White,
			Rotation = 45,
			Parent = canvas,
		})
		UIKit.stroke(spark, 2)
		local dist = 90 + math.random() * 40
		UIKit.tween(spark, 0.6, {
			Position = view.Holder.Position + UDim2.fromOffset(math.cos(a) * dist, math.sin(a) * dist),
			Size = UDim2.fromOffset(2, 2),
			Rotation = 225,
		}, Enum.EasingStyle.Quint)
		Debris:AddItem(spark, 0.65)
	end
end

----------------------------------------------------------------------
-- Pan / zoom input
----------------------------------------------------------------------
local dragging = false
local dragStart = Vector2.zero
local panStart = Vector2.zero
local moved = false

capture.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		moved = false
		dragStart = Vector2.new(input.Position.X, input.Position.Y)
		panStart = panTarget
	end
end)

capture.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		zoomTarget = math.clamp(zoomTarget * (1.15 ^ input.Position.Z), 0.45, 1.7)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		local delta = (Vector2.new(input.Position.X, input.Position.Y) - dragStart) / Hud.UIScale
		if delta.Magnitude > 6 then
			moved = true
		end
		panTarget = panStart + delta
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if dragging and not moved then
			UpgradeTree.select(nil)
		end
		dragging = false
	end
end)

UserInputService.TouchPinch:Connect(function(_positions, scale, _velocity, state)
	if not UpgradeTree.IsOpen then
		return
	end
	if state == Enum.UserInputState.Change then
		zoomTarget = math.clamp(zoomTarget * (1 + (scale - 1) * 0.08), 0.45, 1.7)
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if not UpgradeTree.IsOpen then
		return
	end
	local a = 1 - math.exp(-dt * 12)
	pan = pan:Lerp(panTarget, a)
	zoom += (zoomTarget - zoom) * a
	canvas.Position = UDim2.new(0.5, pan.X, 0.5, pan.Y)
	zoomScale.Scale = zoom

	-- pulse the glow on hexes you can afford
	local pulse = 0.25 + 0.35 * (0.5 + 0.5 * math.sin(os.clock() * 5))
	for id, view in views do
		if id ~= "Start" then
			paint(view.Glow, COLORS.Glow, if view.State == "Affordable" then pulse else 1)
		end
	end
	if tip.Visible then
		placeTooltip()
	end
end)

----------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------
function UpgradeTree.open()
	if UpgradeTree.IsOpen then
		return
	end
	UpgradeTree.IsOpen = true
	overlay.Visible = true
	UpgradeTree.select(nil)
	UIKit.setBlur(true)
	UIKit.tween(dim, 0.3, { BackgroundTransparency = 0.45 })
	zoom = 0.4
	zoomScale.Scale = zoom
	zoomTarget = 1
	pan = Vector2.new(0, 40)
	panTarget = Vector2.zero
	canvas.Position = UDim2.new(0.5, pan.X, 0.5, pan.Y)
	-- stagger the hexes popping in, from the centre outwards
	for id, view in views do
		local node = Config.Nodes[id]
		local ring = if node then math.max(math.abs(node.Q), math.abs(node.R), math.abs(node.Q + node.R)) else 0
		view.Scale.Scale = 0
		task.delay(ring * 0.04, function()
			UIKit.tween(view.Scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end
	UIKit.PlaySound("Open", 0.9)
end

UpgradeTree.close = function()
	if not UpgradeTree.IsOpen then
		return
	end
	UpgradeTree.IsOpen = false
	UpgradeTree.select(nil)
	UIKit.setBlur(false)
	UIKit.tween(dim, 0.25, { BackgroundTransparency = 1 })
	local t = UIKit.tween(zoomScale, 0.25, { Scale = 0.3 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	t.Completed:Connect(function()
		if not UpgradeTree.IsOpen then
			overlay.Visible = false
		end
	end)
	UpgradeTree.OnClosed()
end

return UpgradeTree
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="795">
          <Properties>
            <string name="Name">CourseBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: builds the 3D models for one chunk of the endless course
-- (slope, rails, obstacles, pads, coins, distance signs) from CourseGen specs.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CourseGen = require(Shared:WaitForChild("CourseGen"))

local CourseBuilder = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
local SNOW_A = rgb(244, 249, 255)
local SNOW_B = rgb(214, 232, 252)
local ICE = rgb(150, 215, 255)
local WOOD = rgb(140, 88, 52)
local WOOD_DARK = rgb(98, 60, 36)
local PINE = rgb(46, 150, 84)
local PINE_DARK = rgb(30, 118, 70)
local RED = rgb(230, 52, 60)
local WHITE = rgb(255, 255, 255)
local YELLOW = rgb(255, 204, 40)
local ROCK = rgb(150, 168, 196)

local WIDTH = CourseGen.Width
local TAN = math.tan(math.rad(CourseGen.AngleDeg))

local function part(parent: Instance, props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Color = props.Color or WHITE
	p.Size = props.Size
	p.CFrame = props.CFrame
	if props.Shape then
		p.Shape = props.Shape
	end
	if props.Transparency then
		p.Transparency = props.Transparency
	end
	if props.Reflectance then
		p.Reflectance = props.Reflectance
	end
	if props.CanCollide ~= nil then
		p.CanCollide = props.CanCollide
	end
	if props.CastShadow ~= nil then
		p.CastShadow = props.CastShadow
	end
	p.CanTouch = false
	p.Name = props.Name or "Part"
	p.Parent = parent
	return p
end

local function model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

----------------------------------------------------------------------
-- Obstacle models (cf = upright frame at the base, facing uphill)
----------------------------------------------------------------------
local Builders = {}

function Builders.Snowman(m, cf, o)
	cf = cf * CFrame.Angles(0, math.pi + (o.Rot - math.pi) * 0.12, 0)
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(4.4, 4.4, 4.4), CFrame = cf * CFrame.new(0, 2.2, 0), Color = SNOW_A, Material = Enum.Material.Snow })
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(3.3, 3.3, 3.3), CFrame = cf * CFrame.new(0, 5.4, 0), Color = SNOW_A, Material = Enum.Material.Snow })
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), CFrame = cf * CFrame.new(0, 7.9, 0), Color = SNOW_A, Material = Enum.Material.Snow })
	part(m, { Size = Vector3.new(0.4, 0.4, 1.4), CFrame = cf * CFrame.new(0, 7.9, -1.6), Color = rgb(255, 140, 30) })
	part(m, { Size = Vector3.new(0.35, 0.35, 0.2), CFrame = cf * CFrame.new(-0.45, 8.3, -1.1), Color = rgb(20, 20, 20) })
	part(m, { Size = Vector3.new(0.35, 0.35, 0.2), CFrame = cf * CFrame.new(0.45, 8.3, -1.1), Color = rgb(20, 20, 20) })
	part(m, { Size = Vector3.new(2.6, 0.3, 2.6), CFrame = cf * CFrame.new(0, 9, 0), Color = rgb(30, 30, 36) })
	part(m, { Size = Vector3.new(1.7, 1.6, 1.7), CFrame = cf * CFrame.new(0, 9.9, 0), Color = rgb(30, 30, 36) })
	local scarf = ({ RED, rgb(70, 130, 255), rgb(60, 200, 90), YELLOW })[o.Variant]
	part(m, { Size = Vector3.new(2.8, 0.6, 2.8), CFrame = cf * CFrame.new(0, 6.8, 0), Color = scarf })
end

function Builders.Fence(m, cf)
	for i = -1, 1 do
		part(m, { Size = Vector3.new(1, 4, 1), CFrame = cf * CFrame.new(i * 6, 2, 0), Color = WOOD_DARK, Material = Enum.Material.Wood })
	end
	part(m, { Size = Vector3.new(13, 0.8, 0.6), CFrame = cf * CFrame.new(0, 2.8, 0), Color = WOOD, Material = Enum.Material.WoodPlanks })
	part(m, { Size = Vector3.new(13, 0.8, 0.6), CFrame = cf * CFrame.new(0, 1.4, 0), Color = WOOD, Material = Enum.Material.WoodPlanks })
	part(m, { Size = Vector3.new(13.4, 0.3, 1), CFrame = cf * CFrame.new(0, 3.35, 0), Color = SNOW_A, Material = Enum.Material.Snow })
end

function Builders.Gifts(m, cf, o)
	cf = cf * CFrame.Angles(0, (o.Rot - math.pi) * 0.15, 0)
	local colors = { RED, rgb(60, 190, 90), rgb(70, 130, 255), rgb(190, 90, 240) }
	local boxes = { { -1.6, 0, 3.4, 0 }, { 1.6, 0.6, 2.6, 0 }, { 0.8, 0, 2, 3.4 } }
	for i, b in boxes do
		local size = b[3]
		local boxCF = cf * CFrame.new(b[1], b[4] + size / 2, b[2])
		part(m, { Size = Vector3.new(size, size, size), CFrame = boxCF, Color = colors[(i + o.Variant) % #colors + 1] })
		part(m, { Size = Vector3.new(size + 0.1, size + 0.1, 0.5), CFrame = boxCF, Color = YELLOW })
		part(m, { Size = Vector3.new(0.5, size + 0.1, size + 0.1), CFrame = boxCF, Color = YELLOW })
	end
end

function Builders.Penguin(m, cf, o)
	cf = cf * CFrame.Angles(0, math.pi + (o.Rot - math.pi) * 0.2, 0)
	local black = rgb(30, 34, 46)
	local orange = rgb(255, 160, 30)
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(2.8, 2.8, 2.8), CFrame = cf * CFrame.new(0, 1.6, 0), Color = black })
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(2.1, 2.3, 2.1), CFrame = cf * CFrame.new(0, 1.5, -0.45), Color = WHITE })
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(1.9, 1.9, 1.9), CFrame = cf * CFrame.new(0, 3.5, 0), Color = black })
	part(m, { Size = Vector3.new(0.5, 0.35, 0.8), CFrame = cf * CFrame.new(0, 3.4, -1.1), Color = orange })
	part(m, { Size = Vector3.new(0.7, 0.25, 0.9), CFrame = cf * CFrame.new(-0.6, 0.15, -0.4), Color = orange })
	part(m, { Size = Vector3.new(0.7, 0.25, 0.9), CFrame = cf * CFrame.new(0.6, 0.15, -0.4), Color = orange })
end

local function pineTree(m, cf, s: number)
	part(m, { Size = Vector3.new(1.6, 4, 1.6) * s, CFrame = cf * CFrame.new(0, 2 * s, 0), Color = WOOD, Material = Enum.Material.Wood })
	local tiers = { { 8, 3 }, { 6.4, 2.8 }, { 4.6, 2.6 }, { 2.8, 2.4 } }
	local y = 4 * s
	for i, t in tiers do
		local w, h = t[1] * s, t[2] * s
		local rot = CFrame.Angles(0, math.rad(i * 12), 0)
		part(m, { Size = Vector3.new(w, h, w), CFrame = cf * CFrame.new(0, y + h / 2, 0) * rot, Color = if i % 2 == 0 then PINE_DARK else PINE, Material = Enum.Material.Grass })
		part(m, { Size = Vector3.new(w * 0.8, 0.5 * s, w * 0.8), CFrame = cf * CFrame.new(0, y + h + 0.1, 0) * rot, Color = SNOW_A, Material = Enum.Material.Snow })
		y += h * 0.85
	end
	part(m, { Size = Vector3.new(1.4, 1.4, 1.4) * s, CFrame = cf * CFrame.new(0, y + s, 0) * CFrame.Angles(0, 0, math.rad(45)), Color = YELLOW, Material = Enum.Material.Neon })
end
CourseBuilder.PineTree = pineTree

function Builders.Tree(m, cf, o)
	pineTree(m, cf * CFrame.Angles(0, o.Rot, 0), 1)
end

function Builders.IceWall(m, cf)
	for c = 0, 3 do
		for r = 0, 1 do
			part(m, { Size = Vector3.new(3.9, 3.9, 2), CFrame = cf * CFrame.new((c - 1.5) * 4, r * 4 + 2, 0), Color = ICE, Material = Enum.Material.Ice, Transparency = 0.25, Reflectance = 0.1 })
		end
	end
end

function Builders.SnowWall(m, cf, o)
	local colors = { rgb(120, 170, 255), rgb(90, 140, 240), rgb(150, 195, 255) }
	for r = 0, 2 do
		local offset = if r % 2 == 0 then 0 else 2
		for c = 0, 4 do
			part(m, { Size = Vector3.new(3.9, 2.4, 3), CFrame = cf * CFrame.new((c - 2) * 4 + offset - 1, r * 2.5 + 1.2, 0), Color = colors[(r + c + o.Variant) % 3 + 1], Material = Enum.Material.Glacier })
		end
	end
	part(m, { Size = Vector3.new(20.5, 0.6, 3.4), CFrame = cf * CFrame.new(0, 7.8, 0), Color = SNOW_A, Material = Enum.Material.Snow })
end

function Builders.IceTower(m, cf)
	for i = 0, 3 do
		local size = 5 - i * 0.7
		part(m, { Size = Vector3.new(size, 4, size), CFrame = cf * CFrame.new(0, i * 4 + 2, 0) * CFrame.Angles(0, math.rad(i * 20), 0), Color = ICE, Material = Enum.Material.Ice, Transparency = 0.2, Reflectance = 0.1 })
	end
	part(m, { Size = Vector3.new(1.6, 3, 1.6), CFrame = cf * CFrame.new(0, 17.5, 0) * CFrame.Angles(0, 0, math.rad(45)), Color = rgb(120, 230, 255), Material = Enum.Material.Neon })
end

function Builders.Cabin(m, cf, o)
	cf = cf * CFrame.Angles(0, if o.Variant % 2 == 0 then 0 else math.pi, 0)
	local W, D, H = 14, 12, 8
	for i = 0, H / 2 - 1 do
		local y = i * 2 + 1
		local c = if i % 2 == 0 then WOOD else WOOD_DARK
		part(m, { Size = Vector3.new(W, 2, 1.4), CFrame = cf * CFrame.new(0, y, -D / 2), Color = c, Material = Enum.Material.Wood })
		part(m, { Size = Vector3.new(W, 2, 1.4), CFrame = cf * CFrame.new(0, y, D / 2), Color = c, Material = Enum.Material.Wood })
		part(m, { Size = Vector3.new(1.4, 2, D), CFrame = cf * CFrame.new(-W / 2, y, 0), Color = c, Material = Enum.Material.Wood })
		part(m, { Size = Vector3.new(1.4, 2, D), CFrame = cf * CFrame.new(W / 2, y, 0), Color = c, Material = Enum.Material.Wood })
	end
	part(m, { Size = Vector3.new(3, 5, 0.4), CFrame = cf * CFrame.new(0, 2.5, -D / 2 - 0.6), Color = rgb(200, 60, 50) })
	part(m, { Size = Vector3.new(2.6, 2.4, 0.3), CFrame = cf * CFrame.new(-4.2, 4.6, -D / 2 - 0.6), Color = rgb(255, 220, 120), Material = Enum.Material.Neon })
	part(m, { Size = Vector3.new(2.6, 2.4, 0.3), CFrame = cf * CFrame.new(4.2, 4.6, -D / 2 - 0.6), Color = rgb(255, 220, 120), Material = Enum.Material.Neon })
	local roofAngle = math.rad(32)
	for _, side in { -1, 1 } do
		local roofCF = cf * CFrame.new(side * W / 4, H + 2.2, 0) * CFrame.Angles(0, 0, side * -roofAngle)
		part(m, { Size = Vector3.new(W / 2 / math.cos(roofAngle) + 1.6, 1, D + 2.4), CFrame = roofCF, Color = rgb(196, 44, 50) })
		part(m, { Size = Vector3.new(W / 2 / math.cos(roofAngle) + 1.2, 0.6, D + 2.6), CFrame = roofCF * CFrame.new(0, 0.75, 0), Color = SNOW_A, Material = Enum.Material.Snow })
	end
	part(m, { Size = Vector3.new(1.8, 4, 1.8), CFrame = cf * CFrame.new(3, H + 4.5, 2), Color = rgb(150, 70, 60), Material = Enum.Material.Brick })
end

function Builders.Gate(m, cf)
	local w = WIDTH - 4
	for r = 0, 3 do
		local offset = if r % 2 == 0 then 0 else 3
		for c = 0, math.floor(w / 6) - 1 do
			local bx = -w / 2 + c * 6 + 3 + offset
			if bx < w / 2 - 2 then
				part(m, { Size = Vector3.new(5.9, 3.9, 6), CFrame = cf * CFrame.new(bx, r * 4 + 2, 0), Color = if (r + c) % 2 == 0 then SNOW_A else SNOW_B, Material = Enum.Material.Snow })
			end
		end
	end
	for c = 0, math.floor(w / 12) - 1 do
		part(m, { Size = Vector3.new(5, 4, 6), CFrame = cf * CFrame.new(-w / 2 + c * 12 + 4, 18, 0), Color = SNOW_A, Material = Enum.Material.Snow })
	end
	for _, fx in { -w / 2 + 4, 0, w / 2 - 4 } do
		part(m, { Size = Vector3.new(0.6, 10, 0.6), CFrame = cf * CFrame.new(fx, 25, 0), Color = WOOD_DARK })
		part(m, { Size = Vector3.new(4, 2.6, 0.3), CFrame = cf * CFrame.new(fx + 2.2, 28.6, 0), Color = RED })
	end
end

----------------------------------------------------------------------
-- Mutations (Mutation Storm): recolour the obstacle and add sparkles
----------------------------------------------------------------------
local function mutate(m: Model, mutation)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Color = mutation.Color
			d.Material = mutation.Material
			d.Transparency = if mutation.Material == Enum.Material.Glass then 0.15 else 0
			d.Reflectance = 0.2
		end
	end
	local first = m:FindFirstChildWhichIsA("BasePart")
	if first then
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Color = ColorSequence.new(mutation.Color, WHITE)
		sparkle.LightEmission = 0.8
		sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
		sparkle.Lifetime = NumberRange.new(0.6, 1.2)
		sparkle.Rate = 14
		sparkle.Speed = NumberRange.new(2, 5)
		sparkle.SpreadAngle = Vector2.new(180, 180)
		sparkle.Parent = first
	end
end

----------------------------------------------------------------------
-- Chunk
----------------------------------------------------------------------
export type Obstacle = {
	S0: number,
	S1: number,
	X0: number,
	X1: number,
	Top: number,
	Toughness: number,
	Coins: number,
	Mult: number,
	Model: Model?,
	Smashed: boolean,
}
export type Pad = { S0: number, S1: number, X0: number, X1: number, Top: number, Kind: string, Used: boolean }
export type Pickup = { S: number, X: number, Part: BasePart?, Base: CFrame, Taken: boolean }
export type Built = { Folder: Folder, Obstacles: { Obstacle }, Pads: { Pad }, Pickups: { Pickup } }

local function boostPad(folder, s, x)
	part(folder, { Name = "BoostPad", Size = Vector3.new(12, 0.4, 16), CFrame = CourseGen.SlopeFrame(s, x, 0.15), Color = rgb(40, 220, 255), Material = Enum.Material.Neon, CanCollide = false })
	for i = 0, 1 do
		for _, side in { -1, 1 } do
			part(folder, { Name = "Arrow", Size = Vector3.new(6, 0.3, 1.4), CFrame = CourseGen.SlopeFrame(s - 3 + i * 6, x + side * 2.3, 0.45) * CFrame.Angles(0, math.rad(side * 40), 0), Color = WHITE, Material = Enum.Material.Neon, CanCollide = false })
		end
	end
end

local function ramp(folder, s, x)
	local w = 18
	part(folder, { Class = "WedgePart", Name = "Ramp", Size = Vector3.new(w, 5, 16), CFrame = CourseGen.SlopeFrame(s, x, 2.5) * CFrame.Angles(0, math.pi, 0), Color = SNOW_A, Material = Enum.Material.Snow })
	for _, side in { -1, 1 } do
		part(folder, { Class = "WedgePart", Name = "RampEdge", Size = Vector3.new(1, 5.2, 16.2), CFrame = CourseGen.SlopeFrame(s, x + side * (w / 2 + 0.5), 2.6) * CFrame.Angles(0, math.pi, 0), Color = YELLOW })
	end
end

local function marker(folder, s)
	for _, side in { -1, 1 } do
		local base = CourseGen.Surface(s, side * (WIDTH / 2 + 2))
		for i = 0, 9 do
			part(folder, { Name = "Cane", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 3.2, 3.2), CFrame = CFrame.new(base + Vector3.new(0, i * 3 + 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = if i % 2 == 0 then RED else WHITE })
		end
	end
	local top = CourseGen.Surface(s, 0) + Vector3.new(0, 32, 0)
	local sign = part(folder, { Name = "Sign", Size = Vector3.new(WIDTH + 8, 8, 1.5), CFrame = CFrame.new(top), Color = rgb(98, 60, 38), Material = Enum.Material.WoodPlanks })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 16
	gui.LightInfluence = 0
	gui.Parent = sign
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = rgb(255, 220, 70)
	label.Text = "🏁 " .. Config.Commas(s) .. " STUDS"
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 5
	stroke.Color = rgb(28, 18, 12)
	stroke.Parent = label
end

function CourseBuilder.Build(index: number, parent: Instance, mutationOn: boolean): Built
	local spec = CourseGen.Chunk(index)
	local L = CourseGen.ChunkLength
	local folder = Instance.new("Folder")
	folder.Name = "Chunk" .. index
	local built: Built = { Folder = folder, Obstacles = {}, Pads = {}, Pickups = {} }
	local rng = Random.new(index * 31 + 7)

	-- ground: checker tiles, rails, body underneath, wide shoulders
	local TILE = 50
	for row = 0, L / TILE - 1 do
		for col = 0, WIDTH / TILE - 1 do
			local s = spec.S0 + row * TILE + TILE / 2
			local x = -WIDTH / 2 + col * TILE + TILE / 2
			part(folder, { Name = "Snow", Size = Vector3.new(TILE, 4, TILE), CFrame = CourseGen.SlopeFrame(s, x, -2), Color = if (row + col + index * 5) % 2 == 0 then SNOW_A else SNOW_B, Material = Enum.Material.Snow })
		end
	end
	local SEG = 10
	for i = 0, L / SEG - 1 do
		for _, side in { -1, 1 } do
			part(folder, { Name = "Rail", Size = Vector3.new(2, 2, SEG), CFrame = CourseGen.SlopeFrame(spec.S0 + i * SEG + SEG / 2, side * (WIDTH / 2 + 1), 1), Color = if i % 2 == 0 then RED else WHITE })
		end
	end
	local mid = spec.S0 + L / 2
	part(folder, { Name = "Body", Size = Vector3.new(WIDTH + 6, 120, L + 1), CFrame = CourseGen.SlopeFrame(mid, 0, -64), Color = rgb(226, 238, 250), Material = Enum.Material.Snow, CastShadow = false })
	for _, side in { -1, 1 } do
		part(folder, { Name = "Shoulder", Size = Vector3.new(360, 40, L + 1), CFrame = CourseGen.SlopeFrame(mid, side * (WIDTH / 2 + 183), -42), Color = ROCK, Material = Enum.Material.Snow, CastShadow = false })
	end
	-- trees beside the run
	for _ = 1, 4 do
		local side = if rng:NextNumber() < 0.5 then -1 else 1
		local s = rng:NextNumber(spec.S0, spec.S1)
		local off = rng:NextNumber(WIDTH / 2 + 10, WIDTH / 2 + 80)
		local p = CourseGen.Surface(s, side * off) - Vector3.new(0, 22.5 + 2, 0)
		local tree = model(folder, "SideTree")
		pineTree(tree, CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), rng:NextNumber(1.3, 2.2))
	end
	if spec.Marker then
		marker(folder, spec.Marker)
	end

	-- obstacles
	local obstacles = Instance.new("Folder")
	obstacles.Name = "Smashables"
	obstacles.Parent = folder
	for _, o in spec.Obstacles do
		local m = model(obstacles, o.Kind)
		local builder = Builders[o.Kind]
		if builder then
			builder(m, CourseGen.Upright(o.S, o.X, math.min(o.D, 12)), o)
		end
		local mult = 1
		if mutationOn and o.Kind ~= "Gate" then
			local roll = rng:NextNumber()
			local acc = 0
			for _, mutation in Config.Mutations do
				acc += mutation.Chance
				if roll < acc then
					mult = mutation.Mult
					mutate(m, mutation)
					break
				end
			end
		end
		table.insert(built.Obstacles, {
			S0 = o.S - o.D / 2,
			S1 = o.S + o.D / 2,
			X0 = o.X - o.W / 2,
			X1 = o.X + o.W / 2,
			Top = o.H + o.D * 0.5 * TAN,
			Toughness = o.Tough,
			Coins = o.Coins,
			Mult = mult,
			Model = m,
			Smashed = false,
		})
	end
	table.sort(built.Obstacles, function(a, b)
		return a.S0 < b.S0
	end)

	-- pads
	for _, p in spec.Pads do
		if p.Kind == "Boost" then
			boostPad(folder, p.S, p.X)
			table.insert(built.Pads, { S0 = p.S - 8, S1 = p.S + 8, X0 = p.X - 6, X1 = p.X + 6, Top = 0, Kind = "Boost", Used = false })
		else
			ramp(folder, p.S, p.X)
			table.insert(built.Pads, { S0 = p.S - 8, S1 = p.S + 8, X0 = p.X - 9, X1 = p.X + 9, Top = 5, Kind = "Ramp", Used = false })
		end
	end

	-- coins
	for _, c in spec.Coins do
		local cf = CFrame.new(CourseGen.Surface(c.S, c.X) + Vector3.new(0, c.H, 0)) * CFrame.Angles(0, math.pi / 2, 0)
		local coin = part(folder, {
			Name = "Coin",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, 3, 3),
			CFrame = cf,
			Color = rgb(255, 196, 30),
			Reflectance = 0.15,
			CanCollide = false,
			CastShadow = false,
		})
		table.insert(built.Pickups, { S = c.S, X = c.X, Part = coin, Base = cf, Taken = false })
	end

	folder.Parent = parent
	return built
end

return CourseBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="796">
          <Properties>
            <string name="Name">Runner</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: the run itself. The snowball is simulated on the client
-- along the endless slope (no physics jitter), grows as it rolls, smashes
-- everything in its way and the camera chases it. Course chunks are built
-- ahead of the ball and removed behind it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CourseGen = require(Shared:WaitForChild("CourseGen"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local CourseBuilder = require(script.Parent:WaitForChild("CourseBuilder"))

local P = Config.Physics
local player = Players.LocalPlayer

local Runner = {}
Runner.State = "Idle" -- Idle | Charge | Rolling | Done
Runner.OnFinish = function(_report) end

local WIDTH = CourseGen.Width
local CHUNK = CourseGen.ChunkLength
local START_S = CourseGen.StartOffset
local RIGHT = CourseGen.Right
local surface = CourseGen.Surface

local AHEAD = 650 -- studs of course kept built in front of the ball
local BEHIND = 120

----------------------------------------------------------------------
-- Course chunks (each player smashes their own copy)
----------------------------------------------------------------------
local courseFolder = Instance.new("Folder")
courseFolder.Name = "LocalCourse"
courseFolder.Parent = Workspace

local chunks = {} -- [index] = CourseBuilder.Built
local mutationOn = false
local courseDirty = true

local function buildChunk(i: number)
	if chunks[i] or i < 0 then
		return
	end
	chunks[i] = CourseBuilder.Build(i, courseFolder, mutationOn)
end

local function dropChunk(i: number)
	local c = chunks[i]
	if c then
		c.Folder:Destroy()
		chunks[i] = nil
	end
end

-- keep chunks around `s` built; build at most `budget` new ones this call
local function streamAround(s: number, budget: number)
	local first = math.max(0, math.floor((s - BEHIND) / CHUNK))
	local last = math.floor((s + AHEAD) / CHUNK)
	for i in chunks do
		if i < first then
			dropChunk(i)
		end
	end
	local built = 0
	for i = first, last do
		if not chunks[i] then
			buildChunk(i)
			built += 1
			if built >= budget then
				return
			end
		end
	end
end

function Runner.resetCourse(mutation: boolean?)
	for i in chunks do
		dropChunk(i)
	end
	mutationOn = mutation == true
	streamAround(0, 99)
	courseDirty = false
end

-- e.g. a Mutation Storm started while standing in the lobby
function Runner.setMutation(on: boolean)
	if on ~= mutationOn and Runner.State == "Idle" then
		Runner.resetCourse(on)
	end
end

----------------------------------------------------------------------
-- Snowball visual
----------------------------------------------------------------------
local CLUMP_DIRS = {
	Vector3.new(1, 0.3, 0.2).Unit,
	Vector3.new(-0.6, 0.7, 0.4).Unit,
	Vector3.new(0.1, -0.8, 0.6).Unit,
	Vector3.new(-0.3, 0.2, -1).Unit,
	Vector3.new(0.7, -0.4, -0.6).Unit,
	Vector3.new(-0.9, -0.5, -0.1).Unit,
	Vector3.new(0.2, 1, -0.3).Unit,
}

local ball = nil

local function makeBall(skin)
	local model = Instance.new("Model")
	model.Name = "Snowball"

	local function basePart(name: string): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Shape = Enum.PartType.Ball
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end

	local body = basePart("Body")
	body.Color = skin.Color
	body.Material = skin.Material
	body.Transparency = skin.Transparency
	body.Size = Vector3.one * P.StartRadius * 2

	local clumps = {}
	for i = 1, #CLUMP_DIRS do
		local c = basePart("Clump" .. i)
		c.Color = skin.Clump
		c.Material = if skin.Material == Enum.Material.Neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
		c.CastShadow = false
		table.insert(clumps, c)
	end

	local carrier = Instance.new("Part")
	carrier.Name = "Carrier"
	carrier.Anchored = true
	carrier.CanCollide = false
	carrier.CanQuery = false
	carrier.CanTouch = false
	carrier.Transparency = 1
	carrier.Size = Vector3.one
	carrier.Parent = model

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(-1, 0, 0)
	a0.Parent = carrier
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(1, 0, 0)
	a1.Parent = carrier
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(skin.Trail)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Lifetime = 0.6
	trail.FaceCamera = true
	trail.LightEmission = 0.3
	trail.Parent = carrier

	local spray = Instance.new("ParticleEmitter")
	spray.Color = ColorSequence.new(skin.Trail)
	spray.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0.1) })
	spray.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	spray.Lifetime = NumberRange.new(0.4, 0.8)
	spray.Speed = NumberRange.new(6, 14)
	spray.SpreadAngle = Vector2.new(70, 70)
	spray.Acceleration = Vector3.new(0, -30, 0)
	spray.EmissionDirection = Enum.NormalId.Top
	spray.Rate = 0
	spray.Parent = a0

	-- flames that show while a Turbo is active
	local flames = Instance.new("ParticleEmitter")
	flames.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60), Color3.fromRGB(255, 60, 30))
	flames.LightEmission = 1
	flames.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.5), NumberSequenceKeypoint.new(1, 0) })
	flames.Lifetime = NumberRange.new(0.25, 0.45)
	flames.Speed = NumberRange.new(10, 20)
	flames.SpreadAngle = Vector2.new(25, 25)
	flames.EmissionDirection = Enum.NormalId.Back
	flames.Rate = 0
	flames.Parent = carrier

	model.PrimaryPart = body
	model.Parent = Workspace
	return { Model = model, Body = body, Clumps = clumps, Carrier = carrier, Spray = spray, Trail = trail, Flames = flames, Skin = skin }
end

----------------------------------------------------------------------
-- Run state
----------------------------------------------------------------------
local run = nil
local camPos: Vector3? = nil
local camLook: Vector3? = nil

local function newRun(stats)
	return {
		S = START_S,
		X = 0,
		VX = 0,
		H = 0,
		VH = 0,
		RampH = 0,
		V = 0,
		R = stats.StartRadius or P.StartRadius,
		Roll = 0,
		Combo = 0,
		LastSmash = -100,
		BestCombo = 0,
		Smashed = 0,
		Coins = 0,
		Stats = stats,
		Time = 0,
		Stopped = 0,
		TurboUntil = -1,
	}
end

----------------------------------------------------------------------
-- Steering input: keyboard, gamepad stick, or touching either side
----------------------------------------------------------------------
local stickX = 0
local touches = {}

UserInputService.InputChanged:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Thumbstick1 then
		stickX = if math.abs(input.Position.X) > 0.2 then input.Position.X else 0
	end
end)
UserInputService.TouchStarted:Connect(function(input, processed)
	if not processed then
		touches[input] = input.Position.X
	end
end)
UserInputService.TouchMoved:Connect(function(input)
	if touches[input] then
		touches[input] = input.Position.X
	end
end)
UserInputService.TouchEnded:Connect(function(input)
	touches[input] = nil
end)

local function steerInput(): number
	local v = 0
	if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
		v -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
		v += 1
	end
	v += stickX
	local camera = Workspace.CurrentCamera
	if camera then
		local half = camera.ViewportSize.X / 2
		for _, x in touches do
			v += if x < half then -1 else 1
		end
	end
	return math.clamp(v, -1, 1)
end

----------------------------------------------------------------------
-- Smashing
----------------------------------------------------------------------
local function partsOf(inst: Instance)
	local list = {}
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(list, d)
		end
	end
	return list
end

local function breakApart(o, st, center: Vector3)
	local model = o.Model
	if not model then
		return
	end
	local parts = partsOf(model)
	for _, part in parts do
		part.Anchored = false
		part.CanCollide = true
		part.CanQuery = false
		part.CanTouch = false
		local away = part.Position - center
		away = Vector3.new(away.X, 0, away.Z)
		if away.Magnitude > 0.01 then
			away = away.Unit
		end
		part.AssemblyLinearVelocity = CourseGen.Down * (st.V * 0.8 + 12)
			+ Vector3.yAxis * (22 + math.random() * 26)
			+ away * (10 + math.random() * 20)
		part.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 18
	end
	task.delay(1.3, function()
		for _, part in parts do
			if part.Parent then
				TweenService:Create(part, TweenInfo.new(0.6), { Transparency = 1 }):Play()
			end
		end
	end)
	Debris:AddItem(model, 2.1)
	o.Model = nil
end

local function smash(o, st, center: Vector3)
	o.Smashed = true
	local stats = st.Stats
	local turbo = st.Time < st.TurboUntil
	if not turbo then
		local power = (st.R / P.StartRadius) * stats.Smash
		st.V = math.max(0, st.V - o.Toughness * P.SmashLoss / power)
	end

	if st.Time - st.LastSmash <= stats.ComboTime then
		st.Combo += 1
	else
		st.Combo = 1
	end
	st.LastSmash = st.Time
	st.BestCombo = math.max(st.BestCombo, st.Combo)

	local crit = math.random() < stats.Crit
	local mult = math.min(st.Combo, P.MaxCombo)
	local sizeBonus = 1 + (st.R - P.StartRadius) / P.SizeBonusDiv
	local coins = o.Coins * mult * sizeBonus * stats.CoinMult * o.Mult * (if crit then 2 else 1)
	coins = math.floor(coins + 0.5)
	st.Coins += coins
	st.Smashed += 1
	st.R = math.min(stats.MaxRadius, st.R + 0.12)

	-- feedback
	local midS = (o.S0 + o.S1) / 2
	local midX = (o.X0 + o.X1) / 2
	local base = surface(midS, midX)
	local popPos = base + Vector3.yAxis * (math.min(o.Top, 25) + 2)
	local color = if o.Mult >= 8 then Color3.fromRGB(120, 235, 255)
		elseif o.Mult >= 3 then Color3.fromRGB(255, 200, 40)
		elseif crit then Color3.fromRGB(255, 170, 40)
		else Color3.fromRGB(255, 225, 70)
	Effects.worldText(popPos, "+" .. Config.Commas(coins), color, if crit or o.Mult > 1 then 80 else 60)
	Effects.burst(base + Vector3.yAxis * math.min(o.Top, 6), Color3.fromRGB(240, 248, 255), 14 + math.floor(math.min(o.Toughness, 10) * 3), 1.6)
	Effects.play("Smash", 0.9 + math.random() * 0.3)
	if o.Mult > 1 then
		Effects.play("Mutation", 1.4)
	end
	Effects.shake(0.35 + math.min(o.Toughness, 12) * 0.12)
	Hud.setRunCoins(st.Coins)
	Hud.combo(mult, stats.ComboTime)
	if crit then
		Hud.critical()
		Effects.play("Critical", 1.2)
	end
	breakApart(o, st, center)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
-- Put a fresh snowball on the start pad and point the camera down the hill.
function Runner.prepare(stats, skinId: string)
	if courseDirty or (stats.Mutation == true) ~= mutationOn then
		Runner.resetCourse(stats.Mutation)
	end
	if ball then
		ball.Model:Destroy()
	end
	ball = makeBall(Config.SkinById[skinId] or Config.SkinById.Classic)
	run = newRun(stats)
	camPos = nil
	camLook = nil
	Runner.State = "Charge"
	local camera = Workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	Hud.setRunCoins(0, true)
	Hud.setDistance(0)
	Hud.setSpeed(0)
end

function Runner.launch(power: number)
	local st = run
	if not st or Runner.State ~= "Charge" then
		return
	end
	courseDirty = true
	st.V = math.max(8, st.Stats.Launch * power)
	Runner.State = "Rolling"
	Effects.play("Launch", 1)
	Effects.shake(0.6)
end

function Runner.canTurbo(): boolean
	return run ~= nil and Runner.State == "Rolling" and run.Time >= run.TurboUntil
end

function Runner.turbo()
	local st = run
	if not st or Runner.State ~= "Rolling" then
		return
	end
	st.TurboUntil = st.Time + Config.Turbo.Duration
	st.V = math.min(P.MaxSpeed + Config.Turbo.SpeedAdd, st.V + Config.Turbo.SpeedAdd)
	st.Stopped = 0
	Effects.play("Boost", 0.8)
	Effects.play("Launch", 1.3)
	Effects.shake(1.5)
end

function Runner.stop()
	if ball then
		ball.Model:Destroy()
		ball = nil
	end
	run = nil
	Runner.State = "Idle"
	local camera = Workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
		TweenService:Create(camera, TweenInfo.new(0.4), { FieldOfView = 70 }):Play()
	end
	Hud.setSpeed(0)
	-- show a fresh course in the lobby again
	Runner.resetCourse(mutationOn)
end

local function finish(st)
	Runner.State = "Done"
	Runner.OnFinish({
		Distance = math.max(0, math.floor(st.S)),
		Smashed = st.Smashed,
		BestCombo = st.BestCombo,
		SmashCoins = st.Coins,
	})
end

----------------------------------------------------------------------
-- Per-frame update (called from Main, bound after the camera)
----------------------------------------------------------------------
local spinT = 0

function Runner.update(dt: number)
	local st = run
	local b = ball
	if not st or not b then
		return
	end
	dt = math.min(dt, 1 / 20)
	local stats = st.Stats
	local turbo = st.Time < st.TurboUntil

	if Runner.State == "Rolling" then
		st.Time += dt

		-- steering
		local steer = steerInput()
		local steerSpeed = stats.Steer * (if st.H > 0 then 0.7 else 1)
		st.VX += (steer * steerSpeed - st.VX) * (1 - math.exp(-dt * 8))
		local halfW = WIDTH / 2 - st.R - 1
		st.X = math.clamp(st.X + st.VX * dt, -halfW, halfW)

		-- forward motion
		local airborne = st.H > 0 or st.VH > 0
		if airborne then
			st.VH -= P.Gravity * dt
			st.H += st.VH * dt
			if st.H <= 0 then
				st.H = 0
				st.VH = 0
				Effects.play("Land", 0.8)
				Effects.shake(0.8)
				Effects.burst(surface(st.S, st.X), Color3.fromRGB(240, 248, 255), 26, 2)
			end
		elseif not turbo then
			st.V -= stats.Friction * dt
		end
		local maxSpeed = if turbo then P.MaxSpeed + Config.Turbo.SpeedAdd else P.MaxSpeed
		st.V = math.clamp(st.V, 0, math.max(maxSpeed, st.V - 60 * dt))
		local ds = st.V * dt
		st.S += ds
		if not airborne then
			st.R = math.min(stats.MaxRadius, st.R + stats.Growth * ds)
		end
		st.Roll += ds / st.R

		streamAround(st.S, 1)

		local ci0 = math.max(0, math.floor((st.S - 30) / CHUNK))
		local ci1 = math.floor((st.S + 30) / CHUNK)

		-- boost pads and ramps
		st.RampH = 0
		for ci = ci0, ci1 do
			local chunk = chunks[ci]
			if chunk then
				for _, pad in chunk.Pads do
					local inLane = st.X + st.R * 0.5 >= pad.X0 and st.X - st.R * 0.5 <= pad.X1
					if not pad.Used and st.H <= 0 and inLane and st.S >= pad.S0 and st.S <= pad.S1 then
						if pad.Kind == "Boost" then
							pad.Used = true
							st.V = math.min(maxSpeed, st.V + stats.Boost)
							Effects.play("Boost", 1.1)
							Effects.shake(0.5)
						elseif pad.Kind == "Ramp" then
							-- ride up the ramp, then fly off the lip
							local frac = (st.S - pad.S0) / math.max(1, pad.S1 - pad.S0)
							st.RampH = frac * pad.Top
							if frac >= 0.92 then
								pad.Used = true
								st.H = math.max(0.01, st.RampH)
								st.RampH = 0
								st.VH = P.RampLift * stats.Air + st.V * 0.1
								Effects.play("Launch", 1.2)
							end
						end
					end
				end
			end
		end

		local point, up = surface(st.S, st.X)
		local center = point + up * (st.R + st.H + st.RampH)

		-- smash obstacles and grab coins
		for ci = math.max(0, math.floor((st.S - st.R - 20) / CHUNK)), math.floor((st.S + st.R + 20) / CHUNK) do
			local chunk = chunks[ci]
			if chunk then
				for _, o in chunk.Obstacles do
					if o.S0 > st.S + st.R then
						break
					end
					if not o.Smashed and o.S1 > st.S - st.R and st.X + st.R * 0.85 > o.X0 and st.X - st.R * 0.85 < o.X1 and st.H < o.Top then
						smash(o, st, center)
					end
				end
				for _, p in chunk.Pickups do
					local part = p.Part
					if not p.Taken and part and math.abs(p.S - st.S) < st.R + 1.5 and math.abs(p.X - st.X) < st.R + 1.5 and part.Position.Y < center.Y + st.R + 3 then
						p.Taken = true
						local value = math.floor(P.PickupValue * stats.CoinMult + 0.5)
						st.Coins += value
						Hud.setRunCoins(st.Coins)
						Effects.play("Coin", 1.3 + math.random() * 0.3, 0.4)
						TweenService:Create(part, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
							Size = Vector3.new(0.1, 0.1, 0.1),
							CFrame = part.CFrame + Vector3.yAxis * 4,
						}):Play()
						Debris:AddItem(part, 0.3)
						p.Part = nil
					end
				end
			end
		end

		-- end of the run (the mountain never ends, you just run out of speed)
		if st.V <= P.StopSpeed and st.H <= 0 and not turbo then
			st.Stopped += dt
			st.V = 0
			if st.Stopped > 0.35 then
				finish(st)
			end
		elseif st.Time > P.MaxRunTime then
			finish(st)
		else
			st.Stopped = 0
		end

		Hud.setDistance(math.max(0, st.S))
		Hud.setSpeed(st.V / 120)
		Effects.speedLines(dt, st.V)
	end

	-- spin nearby coins
	spinT += dt
	local ci = math.max(0, math.floor(st.S / CHUNK))
	for i = ci, ci + 1 do
		local chunk = chunks[i]
		if chunk then
			for _, p in chunk.Pickups do
				if p.Part and not p.Taken then
					p.Part.CFrame = p.Base * CFrame.Angles(0, spinT * 3, 0)
				end
			end
		end
	end

	-- place the snowball
	local point, up, forward = surface(st.S, st.X)
	local center = point + up * (st.R + st.H + st.RampH)
	local rot = CFrame.fromAxisAngle(-RIGHT, st.Roll) * CFrame.fromAxisAngle(forward, -st.X * 0.05)
	local ballCF = CFrame.new(center) * rot
	b.Body.Size = Vector3.one * st.R * 2
	b.Body.CFrame = ballCF
	if b.Skin.Rainbow then
		b.Body.Color = Color3.fromHSV((os.clock() * 0.25) % 1, 0.75, 1)
		b.Trail.Color = ColorSequence.new(b.Body.Color)
	end
	for i, c in b.Clumps do
		c.Size = Vector3.one * st.R * 0.55
		c.CFrame = ballCF * CFrame.new(CLUMP_DIRS[i] * st.R * 0.82)
	end
	b.Carrier.CFrame = CFrame.lookAt(point + up * 0.3, point + up * 0.3 + forward)
	for _, a in b.Carrier:GetChildren() do
		if a:IsA("Attachment") then
			a.Position = Vector3.new(math.sign(a.Position.X) * st.R * 0.7, 0, 0)
		end
	end
	b.Spray.Rate = if Runner.State == "Rolling" and st.H <= 0 then math.clamp(st.V * 0.8, 0, 90) else 0
	b.Trail.Enabled = Runner.State == "Rolling" and st.H <= 0.5
	b.Flames.Rate = if turbo and Runner.State == "Rolling" then 120 else 0

	-- camera
	local camera = Workspace.CurrentCamera
	if camera then
		local flatForward = Vector3.new(forward.X, 0, forward.Z).Unit
		local back = 20 + st.R * 2.4
		local height = 9 + st.R * 1.5
		local wantPos = center - flatForward * back + Vector3.yAxis * height
		local wantLook = center + forward * (10 + st.R)
		if not camPos or not camLook then
			camPos = wantPos
			camLook = wantLook
		end
		local cp = (camPos :: Vector3):Lerp(wantPos, 1 - math.exp(-dt * 6))
		local cl = (camLook :: Vector3):Lerp(wantLook, 1 - math.exp(-dt * 10))
		camPos = cp
		camLook = cl
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = CFrame.lookAt(cp, cl) * Effects.shakeOffset(dt)
		local fov = 70 + math.clamp((st.V - 40) * 0.18, 0, 30)
		camera.FieldOfView += (fov - camera.FieldOfView) * (1 - math.exp(-dt * 4))
	end
end

return Runner
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
