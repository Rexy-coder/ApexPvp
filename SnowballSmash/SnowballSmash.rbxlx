local returnButton = UIKit.button({
	Size = UDim2.fromOffset(222, 70),
	Position = UDim2.new(1, -222, 1, -70),
	Color = C.Yellow,
	DarkColor = C.YellowDark,
	Text = "Return",
	Studs = true,
	Key = "Q",
	Parent = result.Content,
	OnClick = function()
		onReturn()
	end,
})
returnButton.Label.TextXAlignment = Enum.TextXAlignment.Center

Panels.ResultOpen = false

RunService.RenderStepped:Connect(function()
	if result.IsOpen then
		resultGradient.Offset = Vector2.new(math.sin(os.clock() * 2) * 0.3, 0)
	end
end)

export type RunResult = { Earned: number, NewBest: boolean, Distance: number, Smashed: number, Combo: number }

function Panels.showResult(r: RunResult, retry: () -> (), back: () -> ())
	onRetry = retry
	onReturn = back
	Panels.ResultOpen = true
	if r.NewBest and r.Earned > 0 then
		resultTitle.Text = "NEW BEST!"
		resultGradient.Enabled = true
		resultTitle.TextColor3 = C.White
	else
		resultGradient.Enabled = false
		if r.Earned >= 1000 then
			resultTitle.Text = "GREAT ROLL!"
			resultTitle.TextColor3 = Color3.fromRGB(255, 220, 60)
		elseif r.Earned >= 100 then
			resultTitle.Text = "NICE ROLL!"
			resultTitle.TextColor3 = Color3.fromRGB(255, 220, 60)
		else
			resultTitle.Text = "KEEP ROLLING!"
			resultTitle.TextColor3 = Color3.fromRGB(150, 210, 255)
		end
	end
	tiles[1].Text = Config.Commas(r.Distance)
	tiles[2].Text = Config.Commas(r.Smashed)
	tiles[3].Text = "x" .. math.max(1, r.Combo)
	earnedLabel.Text = "+0"
	UIKit.openPanel(result)
	UIKit.pop(resultTitle, 1.6)

	-- count the coins up
	task.spawn(function()
		task.wait(0.25)
		local duration = 0.9
		local start = os.clock()
		local lastTick = 0
		while Panels.ResultOpen do
			local t = math.min(1, (os.clock() - start) / duration)
			local eased = 1 - (1 - t) ^ 3
			earnedLabel.Text = "+" .. Config.Commas(r.Earned * eased)
			if os.clock() - lastTick > 0.07 and t < 1 then
				lastTick = os.clock()
				Effects.play("Coin", 1 + t * 0.8, 0.25)
			end
			if t >= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
		UIKit.pop(earnedCoin, 1.4)
		UIKit.pop(earnedLabel, 1.2)
	end)
end

function Panels.hideResult()
	Panels.ResultOpen = false
	UIKit.closePanel(result)
end

----------------------------------------------------------------------
-- Refresh everything from new player data
----------------------------------------------------------------------
function Panels.refresh(newData: any)
	data = newData
	refreshSettings()
	refreshStats()
	refreshShop()
	refreshRebirth()
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1303">
          <Properties>
            <string name="Name">UpgradeTree</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: hexagon upgrade tree. Drag to pan, scroll / pinch to zoom,
-- click a hex to see its card and buy it.

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))
local Hud = require(script.Parent:WaitForChild("Hud"))

local C = UIKit.Colors
local new = UIKit.new

local UpgradeTree = {}
UpgradeTree.IsOpen = false
UpgradeTree.OnBuy = function(_nodeId: string) end
UpgradeTree.OnClosed = function() end
-- defined further down
UpgradeTree.select = function(_id: string?) end
UpgradeTree.close = function() end

local SQ3 = math.sqrt(3)
local R = 48 -- hex radius in px
local LAYOUT = R + 9 -- spacing radius

local COLORS = {
	Outline = Color3.fromRGB(26, 16, 44),
	Owned = Color3.fromRGB(160, 100, 250),
	OwnedInner = Color3.fromRGB(128, 72, 226),
	Available = Color3.fromRGB(64, 152, 255),
	AvailableInner = Color3.fromRGB(42, 112, 232),
	Locked = Color3.fromRGB(72, 58, 104),
	LockedInner = Color3.fromRGB(56, 44, 84),
	Start = Color3.fromRGB(70, 214, 214),
	StartInner = Color3.fromRGB(40, 170, 186),
	Glow = Color3.fromRGB(255, 214, 60),
}

----------------------------------------------------------------------
-- Hexagon from three rotated rectangles
----------------------------------------------------------------------
local function hex(parent: Instance, radius: number, color: Color3): (Frame, { Frame })
	local holder = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(radius * 2, radius * 2),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local rects = {}
	for i = 0, 2 do
		rects[i + 1] = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(radius, radius * SQ3),
			Rotation = i * 60,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = holder,
		})
	end
	return holder, rects
end

local function paint(rects: { Frame }, color: Color3, transparency: number?)
	for _, r in rects do
		r.BackgroundColor3 = color
		if transparency then
			r.BackgroundTransparency = transparency
		end
	end
end

local function axialToPixel(q: number, r: number): Vector2
	return Vector2.new(LAYOUT * 1.5 * q, LAYOUT * SQ3 * (r + q / 2))
end

----------------------------------------------------------------------
-- Build
----------------------------------------------------------------------
type NodeView = {
	Id: string,
	Holder: Frame,
	Scale: UIScale,
	Glow: { Frame },
	Main: { Frame },
	Inner: { Frame },
	Icon: TextLabel,
	State: string,
}

local overlay = new("Frame", {
	Name = "UpgradeTree",
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	ZIndex = 30,
	Parent = Hud.Root,
})
local dim = new("Frame", {
	BackgroundColor3 = Color3.fromRGB(14, 10, 30),
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 1,
	Parent = overlay,
})
local capture = new("TextButton", {
	Name = "Capture",
	BackgroundTransparency = 1,
	Text = "",
	AutoButtonColor = false,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 2,
	Parent = overlay,
})
local canvas = new("Frame", {
	Name = "Canvas",
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(0, 0),
	ZIndex = 3,
	Parent = overlay,
})
local zoomScale = new("UIScale", { Parent = canvas })

local views: { [string]: NodeView } = {}
local selected: string? = nil
local data: any = nil

local function makeNode(id: string, q: number, r: number, icon: string, title: string, tier: number?): NodeView
	local pos = axialToPixel(q, r)
	local holder = new("Frame", {
		Name = id,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(pos.X, pos.Y),
		Size = UDim2.fromOffset(R * 2 + 16, R * 2 + 16),
		BackgroundTransparency = 1,
		Parent = canvas,
	})
	local scale = new("UIScale", { Parent = holder })
	local _, glow = hex(holder, R + 7, COLORS.Glow)
	local _, outline = hex(holder, R + 3, COLORS.Outline)
	local _, main = hex(holder, R - 1, COLORS.Locked)
	local _, inner = hex(holder, R - 9, COLORS.LockedInner)
	local _ = outline

	local iconLabel = UIKit.label({
		Text = icon,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.54),
		Size = UDim2.fromOffset(R * 1.05, R * 1.05),
		Stroke = 0,
		Parent = holder,
	})
	UIKit.label({
		Text = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -R * 0.66),
		Size = UDim2.fromOffset(R * 1.35, 13),
		Stroke = 1.5,
		Parent = holder,
	})
	if tier then
		UIKit.label({
			Text = tostring(tier),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, R * 0.5, 0.5, R * 0.48),
			Size = UDim2.fromOffset(22, 22),
			Stroke = 2.5,
			Parent = holder,
		})
	end

	local hit = new("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(R * 1.7, R * 1.7),
		Parent = holder,
	})

	local view: NodeView = {
		Id = id,
		Holder = holder,
		Scale = scale,
		Glow = glow,
		Main = main,
		Inner = inner,
		Icon = iconLabel,
		State = "Locked",
	}

	hit.MouseEnter:Connect(function()
		UIKit.tween(scale, 0.2, { Scale = 1.1 }, Enum.EasingStyle.Back)
	end)
	hit.MouseLeave:Connect(function()
		UIKit.tween(scale, 0.2, { Scale = 1 })
	end)
	hit.Activated:Connect(function()
		UIKit.PlaySound("Click", 1.3)
		UIKit.pop(holder, 0.85)
		if id ~= "Start" then
			UpgradeTree.select(id)
		end
	end)

	views[id] = view
	return view
end

local startView = makeNode("Start", 0, 0, "⛄", "Start", nil)
paint(startView.Main, COLORS.Start)
paint(startView.Inner, COLORS.StartInner)
paint(startView.Glow, COLORS.Glow, 1)

for _, node in Config.NodeList do
	makeNode(node.Id, node.Q, node.R, node.Branch.Icon, node.Title, node.Tier)
end

----------------------------------------------------------------------
-- Side coin box, close + recenter buttons, hint
----------------------------------------------------------------------
local coinBox = new("Frame", {
	BackgroundColor3 = C.Slate,
	BackgroundTransparency = 0.25,
	Size = UDim2.fromOffset(190, 60),
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 20, 0.5, 0),
	ZIndex = 4,
	Parent = overlay,
})
UIKit.corner(coinBox, 12)
UIKit.stroke(coinBox, 3)
UIKit.coin(coinBox, 42, UDim2.new(0, 10, 0.5, 0), Vector2.new(0, 0.5))
local coinBoxLabel = UIKit.label({
	Text = "0",
	TextXAlignment = Enum.TextXAlignment.Left,
	Size = UDim2.new(1, -72, 0, 32),
	Position = UDim2.new(0, 62, 0.5, 0),
	AnchorPoint = Vector2.new(0, 0.5),
	Stroke = 3,
	Parent = coinBox,
})

UIKit.label({
	Text = if UserInputService.TouchEnabled then "DRAG TO MOVE  ·  PINCH TO ZOOM" else "DRAG TO MOVE  ·  SCROLL TO ZOOM",
	TextXAlignment = Enum.TextXAlignment.Left,
	Size = UDim2.fromOffset(330, 16),
	Position = UDim2.new(0, 20, 1, -28),
	Stroke = 2,
	ZIndex = 4,
	Parent = overlay,
})

local closeButton = UIKit.button({
	Size = UDim2.fromOffset(190, 62),
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -16),
	Color = C.Red,
	DarkColor = C.RedDark,
	Text = "Close",
	Studs = true,
	ZIndex = 5,
	Parent = overlay,
	OnClick = function()
		UpgradeTree.close()
	end,
})
closeButton.Label.TextXAlignment = Enum.TextXAlignment.Center

local panTarget = Vector2.zero
local pan = Vector2.zero
local zoomTarget = 1
local zoom = 1

local recenter = UIKit.button({
	Size = UDim2.fromOffset(62, 62),
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0.5, 108, 1, -16),
	Color = C.Slate,
	DarkColor = Color3.fromRGB(18, 22, 32),
	Text = "🔍",
	ZIndex = 5,
	Parent = overlay,
	OnClick = function()
		panTarget = Vector2.zero
		zoomTarget = 1
	end,
})
recenter.Label.Size = UDim2.new(1, -14, 0.7, 0)

----------------------------------------------------------------------
-- Tooltip card
----------------------------------------------------------------------
local tip = new("Frame", {
	Name = "Tooltip",
	BackgroundColor3 = C.Wood,
	Size = UDim2.fromOffset(300, 196),
	AnchorPoint = Vector2.new(0, 0.5),
	Visible = false,
	ZIndex = 40,
	Parent = overlay,
})
UIKit.corner(tip, 12)
UIKit.stroke(tip, 3.5)
local tipScale = new("UIScale", { Parent = tip })
local tipHeader = new("Frame", {
	BackgroundColor3 = C.Purple,
	Size = UDim2.new(1, 8, 0, 34),
	Position = UDim2.fromOffset(-4, -6),
	Parent = tip,
})
UIKit.corner(tipHeader, 10)
UIKit.stroke(tipHeader, 3)
UIKit.gradient(tipHeader, { Color3.fromRGB(190, 140, 255), C.Purple }, 90)
local tipTitle = UIKit.label({ Text = "", Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 6), Stroke = 2.5, Parent = tipHeader })

local tipIconBox = new("Frame", {
	BackgroundColor3 = C.Purple,
	Size = UDim2.fromOffset(62, 62),
	Position = UDim2.fromOffset(12, 40),
	Parent = tip,
})
UIKit.corner(tipIconBox, 12)
UIKit.stroke(tipIconBox, 3)
local tipIcon = UIKit.label({ Text = "", Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), Stroke = 0, Parent = tipIconBox })
local tipDesc = UIKit.label({
	Text = "",
	TextScaled = false,
	TextSize = 16,
	TextWrapped = true,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	Size = UDim2.fromOffset(204, 62),
	Position = UDim2.fromOffset(84, 42),
	Stroke = 1.5,
	Parent = tip,
})
local tipStat = UIKit.label({
	Text = "",
	RichText = true,
	TextXAlignment = Enum.TextXAlignment.Left,
	Size = UDim2.fromOffset(276, 20),
	Position = UDim2.fromOffset(12, 108),
	Stroke = 2,
	Parent = tip,
})
local tipStatus = UIKit.label({
	Text = "",
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.fromRGB(255, 90, 90),
	Size = UDim2.fromOffset(276, 16),
	Position = UDim2.fromOffset(12, 130),
	Stroke = 2,
	Parent = tip,
})
local buyButton = UIKit.button({
	Size = UDim2.fromOffset(276, 44),
	Position = UDim2.fromOffset(12, 148),
	Color = C.Grey,
	DarkColor = C.GreyDark,
	Text = "0",
	Parent = tip,
	OnClick = function()
		if selected then
			UpgradeTree.OnBuy(selected)
		end
	end,
})
buyButton.Label.TextXAlignment = Enum.TextXAlignment.Center
UIKit.coin(buyButton.Face, 28, UDim2.new(0, 12, 0.5, 0), Vector2.new(0, 0.5))

local function nodeState(id: string): string
	if not data then
		return "Locked"
	end
	if data.Owned[id] then
		return "Owned"
	end
	local node = Config.Nodes[id]
	if node.Requires == "Start" or data.Owned[node.Requires] then
		return if data.Coins >= node.Cost then "Affordable" else "Available"
	end
	return "Locked"
end

local function refreshTooltip()
	local id = selected
	if not id or not data then
		return
	end
	local node = Config.Nodes[id]
	local branch = node.Branch
	local state = nodeState(id)
	local level = Config.BranchLevel(data.Owned, branch.Id)

	tipTitle.Text = node.Title
	tipIcon.Text = branch.Icon
	tipDesc.Text = branch.Desc
	local before = Config.StatText(branch, node.Tier - 1)
	local after = Config.StatText(branch, node.Tier)
	tipStat.Text = string.format('%s: %s → <font color="#7CFF5A">%s</font>', branch.Stat, before, after)
	tipIconBox.BackgroundColor3 = if state == "Owned" then COLORS.Owned elseif state == "Locked" then COLORS.Locked else COLORS.Available

	buyButton.SetText(Config.Commas(node.Cost))
	if state == "Owned" then
		tipStatus.Text = "✔ OWNED"
		tipStatus.TextColor3 = Color3.fromRGB(130, 255, 110)
		buyButton.SetColors(C.Purple, C.PurpleDark)
		buyButton.SetText("Owned")
	elseif state == "Locked" then
		tipStatus.Text = "Requires " .. Config.Nodes[node.Requires].Title
		tipStatus.TextColor3 = Color3.fromRGB(255, 120, 120)
		buyButton.SetColors(C.Grey, C.GreyDark)
	elseif state == "Available" then
		tipStatus.Text = "Need " .. Config.Commas(node.Cost - data.Coins) .. " more coins"
		tipStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
		buyButton.SetColors(C.Grey, C.GreyDark)
	else
		tipStatus.Text = if level >= node.Tier - 1 then "Ready to buy!" else ""
		tipStatus.TextColor3 = Color3.fromRGB(130, 255, 110)
		buyButton.SetColors(C.Green, C.GreenDark)
	end
end

local function placeTooltip()
	local id = selected
	if not id then
		return
	end
	local view = views[id]
	local s = Hud.UIScale
	local abs = view.Holder.AbsolutePosition + view.Holder.AbsoluteSize / 2
	local p = abs / s
	local screen = Hud.Root.AbsoluteSize / s
	local offset = R * zoom + 18
	if p.X + offset + 300 > screen.X - 10 then
		tip.AnchorPoint = Vector2.new(1, 0.5)
		tip.Position = UDim2.fromOffset(p.X - offset, math.clamp(p.Y, 110, screen.Y - 110))
	else
		tip.AnchorPoint = Vector2.new(0, 0.5)
		tip.Position = UDim2.fromOffset(p.X + offset, math.clamp(p.Y, 110, screen.Y - 110))
	end
end

UpgradeTree.select = function(id: string?)
	selected = id
	if id then
		refreshTooltip()
		placeTooltip()
		tip.Visible = true
		tipScale.Scale = 0.6
		UIKit.tween(tipScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		tip.Visible = false
	end
end

----------------------------------------------------------------------
-- Refresh node colours from player data
----------------------------------------------------------------------
function UpgradeTree.refresh(newData: any)
	data = newData
	if not data then
		return
	end
	coinBoxLabel.Text = Config.Short(data.Coins)
	for id, view in views do
		if id ~= "Start" then
			local state = nodeState(id)
			view.State = state
			if state == "Owned" then
				paint(view.Main, COLORS.Owned)
				paint(view.Inner, COLORS.OwnedInner)
				view.Icon.TextTransparency = 0
			elseif state == "Available" or state == "Affordable" then
				paint(view.Main, COLORS.Available)
				paint(view.Inner, COLORS.AvailableInner)
				view.Icon.TextTransparency = 0
			else
				paint(view.Main, COLORS.Locked)
				paint(view.Inner, COLORS.LockedInner)
				view.Icon.TextTransparency = 0.45
			end
		end
	end
	refreshTooltip()
end

-- Is there anything the player can buy right now? (drives the "!" badge)
function UpgradeTree.anyAffordable(d: any): boolean
	if not d then
		return false
	end
	for _, node in Config.NodeList do
		if not d.Owned[node.Id] and (node.Requires == "Start" or d.Owned[node.Requires]) and d.Coins >= node.Cost then
			return true
		end
	end
	return false
end

-- Celebrate a purchase: bounce the hex and throw out some sparkles
function UpgradeTree.celebrate(id: string)
	local view = views[id]
	if not view then
		return
	end
	UIKit.pop(view.Holder, 1.45)
	for i = 1, 12 do
		local a = (i / 12) * math.pi * 2
		local spark = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = view.Holder.Position,
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = if i % 2 == 0 then COLORS.Glow else C.White,
			Rotation = 45,
			Parent = canvas,
		})
		UIKit.stroke(spark, 2)
		local dist = 90 + math.random() * 40
		UIKit.tween(spark, 0.6, {
			Position = view.Holder.Position + UDim2.fromOffset(math.cos(a) * dist, math.sin(a) * dist),
			Size = UDim2.fromOffset(2, 2),
			Rotation = 225,
		}, Enum.EasingStyle.Quint)
		Debris:AddItem(spark, 0.65)
	end
end

----------------------------------------------------------------------
-- Pan / zoom input
----------------------------------------------------------------------
local dragging = false
local dragStart = Vector2.zero
local panStart = Vector2.zero
local moved = false

capture.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		moved = false
		dragStart = Vector2.new(input.Position.X, input.Position.Y)
		panStart = panTarget
	end
end)

capture.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		zoomTarget = math.clamp(zoomTarget * (1.15 ^ input.Position.Z), 0.45, 1.7)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		local delta = (Vector2.new(input.Position.X, input.Position.Y) - dragStart) / Hud.UIScale
		if delta.Magnitude > 6 then
			moved = true
		end
		panTarget = panStart + delta
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if dragging and not moved then
			UpgradeTree.select(nil)
		end
		dragging = false
	end
end)

UserInputService.TouchPinch:Connect(function(_positions, scale, _velocity, state)
	if not UpgradeTree.IsOpen then
		return
	end
	if state == Enum.UserInputState.Change then
		zoomTarget = math.clamp(zoomTarget * (1 + (scale - 1) * 0.08), 0.45, 1.7)
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if not UpgradeTree.IsOpen then
		return
	end
	local a = 1 - math.exp(-dt * 12)
	pan = pan:Lerp(panTarget, a)
	zoom += (zoomTarget - zoom) * a
	canvas.Position = UDim2.new(0.5, pan.X, 0.5, pan.Y)
	zoomScale.Scale = zoom

	-- pulse the glow on hexes you can afford
	local pulse = 0.25 + 0.35 * (0.5 + 0.5 * math.sin(os.clock() * 5))
	for id, view in views do
		if id ~= "Start" then
			paint(view.Glow, COLORS.Glow, if view.State == "Affordable" then pulse else 1)
		end
	end
	if tip.Visible then
		placeTooltip()
	end
end)

----------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------
function UpgradeTree.open()
	if UpgradeTree.IsOpen then
		return
	end
	UpgradeTree.IsOpen = true
	overlay.Visible = true
	UpgradeTree.select(nil)
	UIKit.setBlur(true)
	UIKit.tween(dim, 0.3, { BackgroundTransparency = 0.45 })
	zoom = 0.4
	zoomScale.Scale = zoom
	zoomTarget = 1
	pan = Vector2.new(0, 40)
	panTarget = Vector2.zero
	canvas.Position = UDim2.new(0.5, pan.X, 0.5, pan.Y)
	-- stagger the hexes popping in, from the centre outwards
	for id, view in views do
		local node = Config.Nodes[id]
		local ring = if node then math.max(math.abs(node.Q), math.abs(node.R), math.abs(node.Q + node.R)) else 0
		view.Scale.Scale = 0
		task.delay(ring * 0.04, function()
			UIKit.tween(view.Scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end
	UIKit.PlaySound("Open", 0.9)
end

UpgradeTree.close = function()
	if not UpgradeTree.IsOpen then
		return
	end
	UpgradeTree.IsOpen = false
	UpgradeTree.select(nil)
	UIKit.setBlur(false)
	UIKit.tween(dim, 0.25, { BackgroundTransparency = 1 })
	local t = UIKit.tween(zoomScale, 0.25, { Scale = 0.3 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	t.Completed:Connect(function()
		if not UpgradeTree.IsOpen then
			overlay.Visible = false
		end
	end)
	UpgradeTree.OnClosed()
end

return UpgradeTree
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1304">
          <Properties>
            <string name="Name">CourseBuilder</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: builds the 3D models for one chunk of the endless course
-- (slope, rails, obstacles, pads, coins, distance signs) from CourseGen specs.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CourseGen = require(Shared:WaitForChild("CourseGen"))

local CourseBuilder = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
local SNOW_A = rgb(244, 249, 255)
local SNOW_B = rgb(214, 232, 252)
local ICE = rgb(150, 215, 255)
local WOOD = rgb(140, 88, 52)
local WOOD_DARK = rgb(98, 60, 36)
local PINE = rgb(46, 150, 84)
local PINE_DARK = rgb(30, 118, 70)
local RED = rgb(230, 52, 60)
local WHITE = rgb(255, 255, 255)
local YELLOW = rgb(255, 204, 40)
local ROCK = rgb(150, 168, 196)

local WIDTH = CourseGen.Width
local TAN = math.tan(math.rad(CourseGen.AngleDeg))

local function part(parent: Instance, props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Color = props.Color or WHITE
	p.Size = props.Size
	p.CFrame = props.CFrame
	if props.Shape then
		p.Shape = props.Shape
	end
	if props.Transparency then
		p.Transparency = props.Transparency
	end
	if props.Reflectance then
		p.Reflectance = props.Reflectance
	end
	if props.CanCollide ~= nil then
		p.CanCollide = props.CanCollide
	end
	if props.CastShadow ~= nil then
		p.CastShadow = props.CastShadow
	end
	p.CanTouch = false
	p.Name = props.Name or "Part"
	p.Parent = parent
	return p
end

local function model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

----------------------------------------------------------------------
-- Obstacle models (cf = upright frame at the base, facing uphill)
----------------------------------------------------------------------
local Builders = {}

function Builders.Snowman(m, cf, o)
	cf = cf * CFrame.Angles(0, math.pi + (o.Rot - math.pi) * 0.12, 0)
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(4.4, 4.4, 4.4), CFrame = cf * CFrame.new(0, 2.2, 0), Color = SNOW_A, Material = Enum.Material.Snow })
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(3.3, 3.3, 3.3), CFrame = cf * CFrame.new(0, 5.4, 0), Color = SNOW_A, Material = Enum.Material.Snow })
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 2.4, 2.4), CFrame = cf * CFrame.new(0, 7.9, 0), Color = SNOW_A, Material = Enum.Material.Snow })
	part(m, { Size = Vector3.new(0.4, 0.4, 1.4), CFrame = cf * CFrame.new(0, 7.9, -1.6), Color = rgb(255, 140, 30) })
	part(m, { Size = Vector3.new(0.35, 0.35, 0.2), CFrame = cf * CFrame.new(-0.45, 8.3, -1.1), Color = rgb(20, 20, 20) })
	part(m, { Size = Vector3.new(0.35, 0.35, 0.2), CFrame = cf * CFrame.new(0.45, 8.3, -1.1), Color = rgb(20, 20, 20) })
	part(m, { Size = Vector3.new(2.6, 0.3, 2.6), CFrame = cf * CFrame.new(0, 9, 0), Color = rgb(30, 30, 36) })
	part(m, { Size = Vector3.new(1.7, 1.6, 1.7), CFrame = cf * CFrame.new(0, 9.9, 0), Color = rgb(30, 30, 36) })
	local scarf = ({ RED, rgb(70, 130, 255), rgb(60, 200, 90), YELLOW })[o.Variant]
	part(m, { Size = Vector3.new(2.8, 0.6, 2.8), CFrame = cf * CFrame.new(0, 6.8, 0), Color = scarf })
end

function Builders.Fence(m, cf)
	for i = -1, 1 do
		part(m, { Size = Vector3.new(1, 4, 1), CFrame = cf * CFrame.new(i * 6, 2, 0), Color = WOOD_DARK, Material = Enum.Material.Wood })
	end
	part(m, { Size = Vector3.new(13, 0.8, 0.6), CFrame = cf * CFrame.new(0, 2.8, 0), Color = WOOD, Material = Enum.Material.WoodPlanks })
	part(m, { Size = Vector3.new(13, 0.8, 0.6), CFrame = cf * CFrame.new(0, 1.4, 0), Color = WOOD, Material = Enum.Material.WoodPlanks })
	part(m, { Size = Vector3.new(13.4, 0.3, 1), CFrame = cf * CFrame.new(0, 3.35, 0), Color = SNOW_A, Material = Enum.Material.Snow })
end

function Builders.Gifts(m, cf, o)
	cf = cf * CFrame.Angles(0, (o.Rot - math.pi) * 0.15, 0)
	local colors = { RED, rgb(60, 190, 90), rgb(70, 130, 255), rgb(190, 90, 240) }
	local boxes = { { -1.6, 0, 3.4, 0 }, { 1.6, 0.6, 2.6, 0 }, { 0.8, 0, 2, 3.4 } }
	for i, b in boxes do
		local size = b[3]
		local boxCF = cf * CFrame.new(b[1], b[4] + size / 2, b[2])
		part(m, { Size = Vector3.new(size, size, size), CFrame = boxCF, Color = colors[(i + o.Variant) % #colors + 1] })
		part(m, { Size = Vector3.new(size + 0.1, size + 0.1, 0.5), CFrame = boxCF, Color = YELLOW })
		part(m, { Size = Vector3.new(0.5, size + 0.1, size + 0.1), CFrame = boxCF, Color = YELLOW })
	end
end

function Builders.Penguin(m, cf, o)
	cf = cf * CFrame.Angles(0, math.pi + (o.Rot - math.pi) * 0.2, 0)
	local black = rgb(30, 34, 46)
	local orange = rgb(255, 160, 30)
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(2.8, 2.8, 2.8), CFrame = cf * CFrame.new(0, 1.6, 0), Color = black })
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(2.1, 2.3, 2.1), CFrame = cf * CFrame.new(0, 1.5, -0.45), Color = WHITE })
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(1.9, 1.9, 1.9), CFrame = cf * CFrame.new(0, 3.5, 0), Color = black })
	part(m, { Size = Vector3.new(0.5, 0.35, 0.8), CFrame = cf * CFrame.new(0, 3.4, -1.1), Color = orange })
	part(m, { Size = Vector3.new(0.7, 0.25, 0.9), CFrame = cf * CFrame.new(-0.6, 0.15, -0.4), Color = orange })
	part(m, { Size = Vector3.new(0.7, 0.25, 0.9), CFrame = cf * CFrame.new(0.6, 0.15, -0.4), Color = orange })
end

local function pineTree(m, cf, s: number)
	part(m, { Size = Vector3.new(1.6, 4, 1.6) * s, CFrame = cf * CFrame.new(0, 2 * s, 0), Color = WOOD, Material = Enum.Material.Wood })
	local tiers = { { 8, 3 }, { 6.4, 2.8 }, { 4.6, 2.6 }, { 2.8, 2.4 } }
	local y = 4 * s
	for i, t in tiers do
		local w, h = t[1] * s, t[2] * s
		local rot = CFrame.Angles(0, math.rad(i * 12), 0)
		part(m, { Size = Vector3.new(w, h, w), CFrame = cf * CFrame.new(0, y + h / 2, 0) * rot, Color = if i % 2 == 0 then PINE_DARK else PINE, Material = Enum.Material.Grass })
		part(m, { Size = Vector3.new(w * 0.8, 0.5 * s, w * 0.8), CFrame = cf * CFrame.new(0, y + h + 0.1, 0) * rot, Color = SNOW_A, Material = Enum.Material.Snow })
		y += h * 0.85
	end
	part(m, { Size = Vector3.new(1.4, 1.4, 1.4) * s, CFrame = cf * CFrame.new(0, y + s, 0) * CFrame.Angles(0, 0, math.rad(45)), Color = YELLOW, Material = Enum.Material.Neon })
end
CourseBuilder.PineTree = pineTree

function Builders.Tree(m, cf, o)
	pineTree(m, cf * CFrame.Angles(0, o.Rot, 0), 1)
end

function Builders.IceWall(m, cf)
	for c = 0, 3 do
		for r = 0, 1 do
			part(m, { Size = Vector3.new(3.9, 3.9, 2), CFrame = cf * CFrame.new((c - 1.5) * 4, r * 4 + 2, 0), Color = ICE, Material = Enum.Material.Ice, Transparency = 0.25, Reflectance = 0.1 })
		end
	end
end

function Builders.SnowWall(m, cf, o)
	local colors = { rgb(120, 170, 255), rgb(90, 140, 240), rgb(150, 195, 255) }
	for r = 0, 2 do
		local offset = if r % 2 == 0 then 0 else 2
		for c = 0, 4 do
			part(m, { Size = Vector3.new(3.9, 2.4, 3), CFrame = cf * CFrame.new((c - 2) * 4 + offset - 1, r * 2.5 + 1.2, 0), Color = colors[(r + c + o.Variant) % 3 + 1], Material = Enum.Material.Glacier })
		end
	end
	part(m, { Size = Vector3.new(20.5, 0.6, 3.4), CFrame = cf * CFrame.new(0, 7.8, 0), Color = SNOW_A, Material = Enum.Material.Snow })
end

function Builders.IceTower(m, cf)
	for i = 0, 3 do
		local size = 5 - i * 0.7
		part(m, { Size = Vector3.new(size, 4, size), CFrame = cf * CFrame.new(0, i * 4 + 2, 0) * CFrame.Angles(0, math.rad(i * 20), 0), Color = ICE, Material = Enum.Material.Ice, Transparency = 0.2, Reflectance = 0.1 })
	end
	part(m, { Size = Vector3.new(1.6, 3, 1.6), CFrame = cf * CFrame.new(0, 17.5, 0) * CFrame.Angles(0, 0, math.rad(45)), Color = rgb(120, 230, 255), Material = Enum.Material.Neon })
end

function Builders.Cabin(m, cf, o)
	cf = cf * CFrame.Angles(0, if o.Variant % 2 == 0 then 0 else math.pi, 0)
	local W, D, H = 14, 12, 8
	for i = 0, H / 2 - 1 do
		local y = i * 2 + 1
		local c = if i % 2 == 0 then WOOD else WOOD_DARK
		part(m, { Size = Vector3.new(W, 2, 1.4), CFrame = cf * CFrame.new(0, y, -D / 2), Color = c, Material = Enum.Material.Wood })
		part(m, { Size = Vector3.new(W, 2, 1.4), CFrame = cf * CFrame.new(0, y, D / 2), Color = c, Material = Enum.Material.Wood })
		part(m, { Size = Vector3.new(1.4, 2, D), CFrame = cf * CFrame.new(-W / 2, y, 0), Color = c, Material = Enum.Material.Wood })
		part(m, { Size = Vector3.new(1.4, 2, D), CFrame = cf * CFrame.new(W / 2, y, 0), Color = c, Material = Enum.Material.Wood })
	end
	part(m, { Size = Vector3.new(3, 5, 0.4), CFrame = cf * CFrame.new(0, 2.5, -D / 2 - 0.6), Color = rgb(200, 60, 50) })
	part(m, { Size = Vector3.new(2.6, 2.4, 0.3), CFrame = cf * CFrame.new(-4.2, 4.6, -D / 2 - 0.6), Color = rgb(255, 220, 120), Material = Enum.Material.Neon })
	part(m, { Size = Vector3.new(2.6, 2.4, 0.3), CFrame = cf * CFrame.new(4.2, 4.6, -D / 2 - 0.6), Color = rgb(255, 220, 120), Material = Enum.Material.Neon })
	local roofAngle = math.rad(32)
	for _, side in { -1, 1 } do
		local roofCF = cf * CFrame.new(side * W / 4, H + 2.2, 0) * CFrame.Angles(0, 0, side * -roofAngle)
		part(m, { Size = Vector3.new(W / 2 / math.cos(roofAngle) + 1.6, 1, D + 2.4), CFrame = roofCF, Color = rgb(196, 44, 50) })
		part(m, { Size = Vector3.new(W / 2 / math.cos(roofAngle) + 1.2, 0.6, D + 2.6), CFrame = roofCF * CFrame.new(0, 0.75, 0), Color = SNOW_A, Material = Enum.Material.Snow })
	end
	part(m, { Size = Vector3.new(1.8, 4, 1.8), CFrame = cf * CFrame.new(3, H + 4.5, 2), Color = rgb(150, 70, 60), Material = Enum.Material.Brick })
end

-- Halloween ------------------------------------------------------------
function Builders.Pumpkin(m, cf, o)
	cf = cf * CFrame.Angles(0, math.pi + (o.Rot - math.pi) * 0.25, 0)
	local orange = rgb(255, 130, 20)
	for i = -2, 2 do
		part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(2.6, 4.6, 4.6), CFrame = cf * CFrame.new(i * 0.85, 2.3, 0) * CFrame.Angles(0, i * 0.35, 0), Color = if i % 2 == 0 then orange else rgb(240, 110, 15) })
	end
	part(m, { Size = Vector3.new(0.7, 1.4, 0.7), CFrame = cf * CFrame.new(0, 4.9, 0) * CFrame.Angles(0, 0, 0.3), Color = rgb(70, 120, 40) })
	-- glowing face
	local glow = rgb(255, 230, 90)
	part(m, { Size = Vector3.new(0.9, 0.7, 0.3), CFrame = cf * CFrame.new(-0.9, 2.9, -2.25) * CFrame.Angles(0, 0, math.rad(20)), Color = glow, Material = Enum.Material.Neon })
	part(m, { Size = Vector3.new(0.9, 0.7, 0.3), CFrame = cf * CFrame.new(0.9, 2.9, -2.25) * CFrame.Angles(0, 0, math.rad(-20)), Color = glow, Material = Enum.Material.Neon })
	part(m, { Size = Vector3.new(2.2, 0.5, 0.3), CFrame = cf * CFrame.new(0, 1.7, -2.25), Color = glow, Material = Enum.Material.Neon })
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(5, 0.6, 5), CFrame = cf * CFrame.new(0, 4.4, 0), Color = SNOW_A, Material = Enum.Material.Snow })
end

function Builders.GhostSnowman(m, cf, o)
	cf = cf * CFrame.Angles(0, math.pi + (o.Rot - math.pi) * 0.12, 0)
	local ghost = rgb(225, 235, 255)
	for _, b in { { 4.4, 2.2 }, { 3.3, 5.4 }, { 2.4, 7.9 } } do
		part(m, { Shape = Enum.PartType.Ball, Size = Vector3.one * b[1], CFrame = cf * CFrame.new(0, b[2], 0), Color = ghost, Material = Enum.Material.SmoothPlastic, Transparency = 0.35 })
	end
	local eye = rgb(140, 255, 120)
	part(m, { Size = Vector3.new(0.45, 0.5, 0.2), CFrame = cf * CFrame.new(-0.45, 8.2, -1.1), Color = eye, Material = Enum.Material.Neon })
	part(m, { Size = Vector3.new(0.45, 0.5, 0.2), CFrame = cf * CFrame.new(0.45, 8.2, -1.1), Color = eye, Material = Enum.Material.Neon })
	part(m, { Size = Vector3.new(0.7, 0.5, 0.2), CFrame = cf * CFrame.new(0, 7.4, -1.15), Color = rgb(30, 30, 40) })
	part(m, { Size = Vector3.new(2.6, 0.3, 2.6), CFrame = cf * CFrame.new(0, 9, 0), Color = rgb(30, 30, 36) })
	part(m, { Size = Vector3.new(1.7, 1.6, 1.7), CFrame = cf * CFrame.new(0, 9.9, 0), Color = rgb(30, 30, 36) })
	part(m, { Size = Vector3.new(1.8, 0.35, 1.8), CFrame = cf * CFrame.new(0, 9.35, 0), Color = rgb(255, 130, 20) })
end

-- Winter ---------------------------------------------------------------
function Builders.GiantPresent(m, cf, o)
	cf = cf * CFrame.Angles(0, (o.Rot - math.pi) * 0.2, 0)
	local wraps = { { RED, rgb(255, 215, 60) }, { rgb(40, 170, 80), RED }, { rgb(70, 130, 255), WHITE }, { rgb(190, 90, 240), rgb(255, 215, 60) } }
	local wrap = wraps[o.Variant]
	local box = part(m, { Size = Vector3.new(6, 6, 6), CFrame = cf * CFrame.new(0, 3, 0), Color = wrap[1] })
	part(m, { Size = Vector3.new(6.1, 6.1, 1.1), CFrame = box.CFrame, Color = wrap[2] })
	part(m, { Size = Vector3.new(1.1, 6.1, 6.1), CFrame = box.CFrame, Color = wrap[2] })
	-- bow on top
	for _, side in { -1, 1 } do
		part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 1.4, 1.4), CFrame = cf * CFrame.new(side * 1, 6.6, 0) * CFrame.Angles(0, 0, side * 0.5), Color = wrap[2] })
	end
	part(m, { Shape = Enum.PartType.Ball, Size = Vector3.new(1.1, 1.1, 1.1), CFrame = cf * CFrame.new(0, 6.5, 0), Color = wrap[2], Material = Enum.Material.Neon })
	part(m, { Size = Vector3.new(6.2, 0.4, 6.2), CFrame = cf * CFrame.new(0, 6.15, 0), Color = SNOW_A, Material = Enum.Material.Snow })
end

function Builders.GingerHouse(m, cf, o)
	cf = cf * CFrame.Angles(0, if o.Variant % 2 == 0 then 0 else math.pi, 0)
	local ginger = rgb(196, 120, 60)
	local icing = WHITE
	part(m, { Size = Vector3.new(8, 6, 7), CFrame = cf * CFrame.new(0, 3, 0), Color = ginger, Material = Enum.Material.SmoothPlastic })
	part(m, { Size = Vector3.new(8.2, 0.5, 7.2), CFrame = cf * CFrame.new(0, 0.6, 0), Color = icing })
	-- door + windows
	part(m, { Size = Vector3.new(1.8, 3, 0.3), CFrame = cf * CFrame.new(0, 1.5, -3.55), Color = rgb(120, 60, 30) })
	for _, side in { -1, 1 } do
		part(m, { Size = Vector3.new(1.4, 1.4, 0.3), CFrame = cf * CFrame.new(side * 2.5, 3.8, -3.55), Color = rgb(255, 220, 120), Material = Enum.Material.Neon })
		part(m, { Size = Vector3.new(1.8, 0.3, 0.4), CFrame = cf * CFrame.new(side * 2.5, 3.0, -3.6), Color = icing })
	end
	-- iced roof
	local roofAngle = math.rad(35)
	for _, side in { -1, 1 } do
		local roofCF = cf * CFrame.new(side * 2.1, 7.3, 0) * CFrame.Angles(0, 0, side * -roofAngle)
		part(m, { Size = Vector3.new(5.6, 0.8, 8), CFrame = roofCF, Color = rgb(170, 95, 45) })
		part(m, { Size = Vector3.new(5.4, 0.4, 8.2), CFrame = roofCF * CFrame.new(0, 0.5, 0), Color = icing })
	end
	-- gumdrops + candy canes
	local drops = { RED, rgb(60, 200, 90), rgb(255, 215, 60), rgb(190, 90, 240) }
	for i = 0, 3 do
		part(m, { Shape = Enum.PartType.Ball, Size = Vector3.one * 0.8, CFrame = cf * CFrame.new(-3 + i * 2, 9.3 - math.abs(i - 1.5) * 0.4, 0), Color = drops[i + 1], Material = Enum.Material.Neon })
	end
	for _, side in { -1, 1 } do
		for k = 0, 3 do
			part(m, { Size = Vector3.new(0.6, 1, 0.6), CFrame = cf * CFrame.new(side * 4.6, k + 0.5, -3.8), Color = if k % 2 == 0 then RED else WHITE })
		end
	end
end

function Builders.Gate(m, cf)
	local w = WIDTH - 4
	for r = 0, 3 do
		local offset = if r % 2 == 0 then 0 else 3
		for c = 0, math.floor(w / 6) - 1 do
			local bx = -w / 2 + c * 6 + 3 + offset
			if bx < w / 2 - 2 then
				part(m, { Size = Vector3.new(5.9, 3.9, 6), CFrame = cf * CFrame.new(bx, r * 4 + 2, 0), Color = if (r + c) % 2 == 0 then SNOW_A else SNOW_B, Material = Enum.Material.Snow })
			end
		end
	end
	for c = 0, math.floor(w / 12) - 1 do
		part(m, { Size = Vector3.new(5, 4, 6), CFrame = cf * CFrame.new(-w / 2 + c * 12 + 4, 18, 0), Color = SNOW_A, Material = Enum.Material.Snow })
	end
	for _, fx in { -w / 2 + 4, 0, w / 2 - 4 } do
		part(m, { Size = Vector3.new(0.6, 10, 0.6), CFrame = cf * CFrame.new(fx, 25, 0), Color = WOOD_DARK })
		part(m, { Size = Vector3.new(4, 2.6, 0.3), CFrame = cf * CFrame.new(fx + 2.2, 28.6, 0), Color = RED })
	end
end

----------------------------------------------------------------------
-- Mutations (Mutation Storm, Meteor Shower, Galaxy): recolour + sparkles
----------------------------------------------------------------------
local function mutate(m: Model, mutation)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.Color = mutation.Color
			d.Material = mutation.Material
			d.Transparency = if mutation.Material == Enum.Material.Glass then 0.15 else 0
			d.Reflectance = 0.2
		end
	end
	local first = m:FindFirstChildWhichIsA("BasePart")
	if first then
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Color = ColorSequence.new(mutation.Color, WHITE)
		sparkle.LightEmission = 0.8
		sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
		sparkle.Lifetime = NumberRange.new(0.6, 1.2)
		sparkle.Rate = 14
		sparkle.Speed = NumberRange.new(2, 5)
		sparkle.SpreadAngle = Vector2.new(180, 180)
		sparkle.Parent = first
	end
end

----------------------------------------------------------------------
-- Chunk
----------------------------------------------------------------------
export type Obstacle = {
	S0: number,
	S1: number,
	X0: number,
	X1: number,
	Top: number,
	Toughness: number,
	Coins: number,
	Candy: number,
	Presents: number,
	Mult: number,
	Model: Model?,
	Smashed: boolean,
}
export type Pad = { S0: number, S1: number, X0: number, X1: number, Top: number, Kind: string, Used: boolean }
export type Pickup = { S: number, X: number, Part: BasePart?, Base: CFrame, Taken: boolean }
export type Built = { Folder: Folder, Obstacles: { Obstacle }, Pads: { Pad }, Pickups: { Pickup } }

local function boostPad(folder, s, x)
	part(folder, { Name = "BoostPad", Size = Vector3.new(12, 0.4, 16), CFrame = CourseGen.SlopeFrame(s, x, 0.15), Color = rgb(40, 220, 255), Material = Enum.Material.Neon, CanCollide = false })
	for i = 0, 1 do
		for _, side in { -1, 1 } do
			part(folder, { Name = "Arrow", Size = Vector3.new(6, 0.3, 1.4), CFrame = CourseGen.SlopeFrame(s - 3 + i * 6, x + side * 2.3, 0.45) * CFrame.Angles(0, math.rad(side * 40), 0), Color = WHITE, Material = Enum.Material.Neon, CanCollide = false })
		end
	end
end

local function ramp(folder, s, x)
	local w = 18
	part(folder, { Class = "WedgePart", Name = "Ramp", Size = Vector3.new(w, 5, 16), CFrame = CourseGen.SlopeFrame(s, x, 2.5) * CFrame.Angles(0, math.pi, 0), Color = SNOW_A, Material = Enum.Material.Snow })
	for _, side in { -1, 1 } do
		part(folder, { Class = "WedgePart", Name = "RampEdge", Size = Vector3.new(1, 5.2, 16.2), CFrame = CourseGen.SlopeFrame(s, x + side * (w / 2 + 0.5), 2.6) * CFrame.Angles(0, math.pi, 0), Color = YELLOW })
	end
end

local function marker(folder, s)
	for _, side in { -1, 1 } do
		local base = CourseGen.Surface(s, side * (WIDTH / 2 + 2))
		for i = 0, 9 do
			part(folder, { Name = "Cane", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 3.2, 3.2), CFrame = CFrame.new(base + Vector3.new(0, i * 3 + 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = if i % 2 == 0 then RED else WHITE })
		end
	end
	local top = CourseGen.Surface(s, 0) + Vector3.new(0, 32, 0)
	local sign = part(folder, { Name = "Sign", Size = Vector3.new(WIDTH + 8, 8, 1.5), CFrame = CFrame.new(top), Color = rgb(98, 60, 38), Material = Enum.Material.WoodPlanks })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 16
	gui.LightInfluence = 0
	gui.Parent = sign
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = rgb(255, 220, 70)
	label.Text = "🏁 " .. Config.Commas(s) .. " STUDS"
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 5
	stroke.Color = rgb(28, 18, 12)
	stroke.Parent = label
end

-- mutations: mutation ids obstacles may roll (from the active events)
function CourseBuilder.Build(index: number, parent: Instance, mutations: { string }): Built
	local spec = CourseGen.Chunk(index)
	local L = CourseGen.ChunkLength
	local folder = Instance.new("Folder")
	folder.Name = "Chunk" .. index
	local built: Built = { Folder = folder, Obstacles = {}, Pads = {}, Pickups = {} }
	local rng = Random.new(index * 31 + 7)

	-- ground: checker tiles, rails, body underneath, wide shoulders
	local TILE = 50
	for row = 0, L / TILE - 1 do
		for col = 0, WIDTH / TILE - 1 do
			local s = spec.S0 + row * TILE + TILE / 2
			local x = -WIDTH / 2 + col * TILE + TILE / 2
			part(folder, { Name = "Snow", Size = Vector3.new(TILE, 4, TILE), CFrame = CourseGen.SlopeFrame(s, x, -2), Color = if (row + col + index * 5) % 2 == 0 then SNOW_A else SNOW_B, Material = Enum.Material.Snow })
		end
	end
	local SEG = 10
	for i = 0, L / SEG - 1 do
		for _, side in { -1, 1 } do
			part(folder, { Name = "Rail", Size = Vector3.new(2, 2, SEG), CFrame = CourseGen.SlopeFrame(spec.S0 + i * SEG + SEG / 2, side * (WIDTH / 2 + 1), 1), Color = if i % 2 == 0 then RED else WHITE })
		end
	end
	local mid = spec.S0 + L / 2
	part(folder, { Name = "Body", Size = Vector3.new(WIDTH + 6, 120, L + 1), CFrame = CourseGen.SlopeFrame(mid, 0, -64), Color = rgb(226, 238, 250), Material = Enum.Material.Snow, CastShadow = false })
	for _, side in { -1, 1 } do
		part(folder, { Name = "Shoulder", Size = Vector3.new(360, 40, L + 1), CFrame = CourseGen.SlopeFrame(mid, side * (WIDTH / 2 + 183), -42), Color = ROCK, Material = Enum.Material.Snow, CastShadow = false })
	end
	-- trees beside the run
	for _ = 1, 4 do
		local side = if rng:NextNumber() < 0.5 then -1 else 1
		local s = rng:NextNumber(spec.S0, spec.S1)
		local off = rng:NextNumber(WIDTH / 2 + 10, WIDTH / 2 + 80)
		local p = CourseGen.Surface(s, side * off) - Vector3.new(0, 22.5 + 2, 0)
		local tree = model(folder, "SideTree")
		pineTree(tree, CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), rng:NextNumber(1.3, 2.2))
	end
	if spec.Marker then
		marker(folder, spec.Marker)
	end

	-- obstacles
	local obstacles = Instance.new("Folder")
	obstacles.Name = "Smashables"
	obstacles.Parent = folder
	for _, o in spec.Obstacles do
		local m = model(obstacles, o.Kind)
		local builder = Builders[o.Kind]
		if builder then
			builder(m, CourseGen.Upright(o.S, o.X, math.min(o.D, 12)), o)
		end
		local mult = 1
		if #mutations > 0 and o.Kind ~= "Gate" then
			local roll = rng:NextNumber()
			local acc = 0
			for _, id in mutations do
				local mutation = Config.MutationById[id]
				acc += mutation.Chance
				if roll < acc then
					mult = mutation.Mult
					mutate(m, mutation)
					break
				end
			end
		end
		table.insert(built.Obstacles, {
			S0 = o.S - o.D / 2,
			S1 = o.S + o.D / 2,
			X0 = o.X - o.W / 2,
			X1 = o.X + o.W / 2,
			Top = o.H + o.D * 0.5 * TAN,
			Toughness = o.Tough,
			Coins = o.Coins,
			Candy = o.Candy or 0,
			Presents = o.Presents or 0,
			Mult = mult,
			Model = m,
			Smashed = false,
		})
	end
	table.sort(built.Obstacles, function(a, b)
		return a.S0 < b.S0
	end)

	-- pads
	for _, p in spec.Pads do
		if p.Kind == "Boost" then
			boostPad(folder, p.S, p.X)
			table.insert(built.Pads, { S0 = p.S - 8, S1 = p.S + 8, X0 = p.X - 6, X1 = p.X + 6, Top = 0, Kind = "Boost", Used = false })
		else
			ramp(folder, p.S, p.X)
			table.insert(built.Pads, { S0 = p.S - 8, S1 = p.S + 8, X0 = p.X - 9, X1 = p.X + 9, Top = 5, Kind = "Ramp", Used = false })
		end
	end

	-- coins
	for _, c in spec.Coins do
		local cf = CFrame.new(CourseGen.Surface(c.S, c.X) + Vector3.new(0, c.H, 0)) * CFrame.Angles(0, math.pi / 2, 0)
		local coin = part(folder, {
			Name = "Coin",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.6, 3, 3),
			CFrame = cf,
			Color = rgb(255, 196, 30),
			Reflectance = 0.15,
			CanCollide = false,
			CastShadow = false,
		})
		table.insert(built.Pickups, { S = c.S, X = c.X, Part = coin, Base = cf, Taken = false })
	end

	folder.Parent = parent
	return built
end

return CourseBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1305">
          <Properties>
            <string name="Name">Runner</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: the run itself. The snowball is simulated on the client
-- along the endless slope (no physics jitter), grows as it rolls, smashes
-- everything in its way and the camera chases it. Course chunks are built
-- ahead of the ball and removed behind it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CourseGen = require(Shared:WaitForChild("CourseGen"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local CourseBuilder = require(script.Parent:WaitForChild("CourseBuilder"))

local P = Config.Physics
local player = Players.LocalPlayer

local Runner = {}
Runner.State = "Idle" -- Idle | Charge | Rolling | Done
Runner.OnFinish = function(_report) end

local WIDTH = CourseGen.Width
local CHUNK = CourseGen.ChunkLength
local START_S = CourseGen.StartOffset
local RIGHT = CourseGen.Right
local surface = CourseGen.Surface

local AHEAD = 650 -- studs of course kept built in front of the ball
local BEHIND = 120

----------------------------------------------------------------------
-- Course chunks (each player smashes their own copy)
----------------------------------------------------------------------
local courseFolder = Instance.new("Folder")
courseFolder.Name = "LocalCourse"
courseFolder.Parent = Workspace

local chunks = {} -- [index] = CourseBuilder.Built
local mutationIds: { string } = {} -- mutations the built course rolled with
local mutationKey = ""
local courseDirty = true

local function buildChunk(i: number)
	if chunks[i] or i < 0 then
		return
	end
	chunks[i] = CourseBuilder.Build(i, courseFolder, mutationIds)
end

local function dropChunk(i: number)
	local c = chunks[i]
	if c then
		c.Folder:Destroy()
		chunks[i] = nil
	end
end

-- keep chunks around `s` built; build at most `budget` new ones this call
local function streamAround(s: number, budget: number)
	local first = math.max(0, math.floor((s - BEHIND) / CHUNK))
	local last = math.floor((s + AHEAD) / CHUNK)
	for i in chunks do
		if i < first then
			dropChunk(i)
		end
	end
	local built = 0
	for i = first, last do
		if not chunks[i] then
			buildChunk(i)
			built += 1
			if built >= budget then
				return
			end
		end
	end
end

function Runner.resetCourse(mutations: { string }?)
	for i in chunks do
		dropChunk(i)
	end
	mutationIds = mutations or {}
	mutationKey = table.concat(mutationIds, ",")
	streamAround(0, 99)
	courseDirty = false
end

-- e.g. a Mutation Storm / Meteor Shower started while standing in the lobby
function Runner.setMutations(ids: { string })
	if table.concat(ids, ",") ~= mutationKey and Runner.State == "Idle" then
		Runner.resetCourse(ids)
	end
end

----------------------------------------------------------------------
-- Snowball visual
----------------------------------------------------------------------
local CLUMP_DIRS = {
	Vector3.new(1, 0.3, 0.2).Unit,
	Vector3.new(-0.6, 0.7, 0.4).Unit,
	Vector3.new(0.1, -0.8, 0.6).Unit,
	Vector3.new(-0.3, 0.2, -1).Unit,
	Vector3.new(0.7, -0.4, -0.6).Unit,
	Vector3.new(-0.9, -0.5, -0.1).Unit,
	Vector3.new(0.2, 1, -0.3).Unit,
}

local ball = nil

local function makeBall(skin)
	local model = Instance.new("Model")
	model.Name = "Snowball"

	local function basePart(name: string): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Shape = Enum.PartType.Ball
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end

	local body = basePart("Body")
	body.Color = skin.Color
	body.Material = skin.Material
	body.Transparency = skin.Transparency
	body.Size = Vector3.one * P.StartRadius * 2

	local clumps = {}
	for i = 1, #CLUMP_DIRS do
		local c = basePart("Clump" .. i)
		c.Color = skin.Clump
		c.Material = if skin.Material == Enum.Material.Neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
		c.CastShadow = false
		table.insert(clumps, c)
	end

	local carrier = Instance.new("Part")
	carrier.Name = "Carrier"
	carrier.Anchored = true
	carrier.CanCollide = false
	carrier.CanQuery = false
	carrier.CanTouch = false
	carrier.Transparency = 1
	carrier.Size = Vector3.one
	carrier.Parent = model

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(-1, 0, 0)
	a0.Parent = carrier
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(1, 0, 0)
	a1.Parent = carrier
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(skin.Trail)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Lifetime = 0.6
	trail.FaceCamera = true
	trail.LightEmission = 0.3
	trail.Parent = carrier

	local spray = Instance.new("ParticleEmitter")
	spray.Color = ColorSequence.new(skin.Trail)
	spray.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0.1) })
	spray.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	spray.Lifetime = NumberRange.new(0.4, 0.8)
	spray.Speed = NumberRange.new(6, 14)
	spray.SpreadAngle = Vector2.new(70, 70)
	spray.Acceleration = Vector3.new(0, -30, 0)
	spray.EmissionDirection = Enum.NormalId.Top
	spray.Rate = 0
	spray.Parent = a0

	-- flames that show while a Turbo is active
	local flames = Instance.new("ParticleEmitter")
	flames.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60), Color3.fromRGB(255, 60, 30))
	flames.LightEmission = 1
	flames.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.5), NumberSequenceKeypoint.new(1, 0) })
	flames.Lifetime = NumberRange.new(0.25, 0.45)
	flames.Speed = NumberRange.new(10, 20)
	flames.SpreadAngle = Vector2.new(25, 25)
	flames.EmissionDirection = Enum.NormalId.Back
	flames.Rate = 0
	flames.Parent = carrier

	model.PrimaryPart = body
	model.Parent = Workspace
	return { Model = model, Body = body, Clumps = clumps, Carrier = carrier, Spray = spray, Trail = trail, Flames = flames, Skin = skin }
end

----------------------------------------------------------------------
-- Run state
----------------------------------------------------------------------
local run = nil
local camPos: Vector3? = nil
local camLook: Vector3? = nil

local function newRun(stats)
	return {
		S = START_S,
		X = 0,
		VX = 0,
		H = 0,
		VH = 0,
		RampH = 0,
		V = 0,
		R = stats.StartRadius or P.StartRadius,
		Roll = 0,
		Combo = 0,
		LastSmash = -100,
		BestCombo = 0,
		Smashed = 0,
		Coins = 0,
		Candy = 0,
		Presents = 0,
		Stats = stats,
		Time = 0,
		Stopped = 0,
		TurboUntil = -1,
	}
end

----------------------------------------------------------------------
-- Steering input: keyboard, gamepad stick, or touching either side
----------------------------------------------------------------------
local stickX = 0
local touches = {}

UserInputService.InputChanged:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Thumbstick1 then
		stickX = if math.abs(input.Position.X) > 0.2 then input.Position.X else 0
	end
end)
UserInputService.TouchStarted:Connect(function(input, processed)
	if not processed then
		touches[input] = input.Position.X
	end
end)
UserInputService.TouchMoved:Connect(function(input)
	if touches[input] then
		touches[input] = input.Position.X
	end
end)
UserInputService.TouchEnded:Connect(function(input)
	touches[input] = nil
end)

local function steerInput(): number
	local v = 0
	if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
		v -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
		v += 1
	end
	v += stickX
	local camera = Workspace.CurrentCamera
	if camera then
		local half = camera.ViewportSize.X / 2
		for _, x in touches do
			v += if x < half then -1 else 1
		end
	end
	return math.clamp(v, -1, 1)
end

----------------------------------------------------------------------
-- Smashing
----------------------------------------------------------------------
local function partsOf(inst: Instance)
	local list = {}
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(list, d)
		end
	end
	return list
end

local function breakApart(o, st, center: Vector3)
	local model = o.Model
	if not model then
		return
	end
	local parts = partsOf(model)
	for _, part in parts do
		part.Anchored = false
		part.CanCollide = true
		part.CanQuery = false
		part.CanTouch = false
		local away = part.Position - center
		away = Vector3.new(away.X, 0, away.Z)
		if away.Magnitude > 0.01 then
			away = away.Unit
		end
		part.AssemblyLinearVelocity = CourseGen.Down * (st.V * 0.8 + 12)
			+ Vector3.yAxis * (22 + math.random() * 26)
			+ away * (10 + math.random() * 20)
		part.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 18
	end
	task.delay(1.3, function()
		for _, part in parts do
			if part.Parent then
				TweenService:Create(part, TweenInfo.new(0.6), { Transparency = 1 }):Play()
			end
		end
	end)
	Debris:AddItem(model, 2.1)
	o.Model = nil
end

local function smash(o, st, center: Vector3)
	o.Smashed = true
	local stats = st.Stats
	local turbo = st.Time < st.TurboUntil
	if not turbo then
		local power = (st.R / P.StartRadius) * stats.Smash
		st.V = math.max(0, st.V - o.Toughness * P.SmashLoss / power)
	end

	if st.Time - st.LastSmash <= stats.ComboTime then
		st.Combo += 1
	else
		st.Combo = 1
	end
	st.LastSmash = st.Time
	st.BestCombo = math.max(st.BestCombo, st.Combo)

	local crit = math.random() < stats.Crit
	local mult = math.min(st.Combo, stats.MaxCombo or P.MaxCombo)
	local sizeBonus = 1 + (st.R - P.StartRadius) / P.SizeBonusDiv
	local coins = o.Coins * mult * sizeBonus * stats.CoinMult * o.Mult * (if crit then 2 else 1)
	coins = math.floor(coins + 0.5)
	st.Coins += coins
	st.Smashed += 1
	if o.Candy > 0 then
		st.Candy += o.Candy
		task.delay(0.15, function()
			Effects.worldText(surface((o.S0 + o.S1) / 2, (o.X0 + o.X1) / 2) + Vector3.yAxis * (math.min(o.Top, 25) + 6), "+" .. o.Candy .. " 🍬", Color3.fromRGB(255, 150, 40), 55)
		end)
	end
	if o.Presents > 0 then
		st.Presents += o.Presents
		task.delay(0.15, function()
			Effects.worldText(surface((o.S0 + o.S1) / 2, (o.X0 + o.X1) / 2) + Vector3.yAxis * (math.min(o.Top, 25) + 6), "+" .. o.Presents .. " 🎁", Color3.fromRGB(255, 95, 110), 55)
		end)
	end
	st.R = math.min(stats.MaxRadius, st.R + 0.12)

	-- feedback
	local midS = (o.S0 + o.S1) / 2
	local midX = (o.X0 + o.X1) / 2
	local base = surface(midS, midX)
	local popPos = base + Vector3.yAxis * (math.min(o.Top, 25) + 2)
	local color = if o.Mult >= 15 then Color3.fromRGB(190, 130, 255)
		elseif o.Mult >= 10 then Color3.fromRGB(255, 120, 40)
		elseif o.Mult >= 8 then Color3.fromRGB(120, 235, 255)
		elseif o.Mult >= 3 then Color3.fromRGB(255, 200, 40)
		elseif crit then Color3.fromRGB(255, 170, 40)
		else Color3.fromRGB(255, 225, 70)
	Effects.worldText(popPos, "+" .. Config.Commas(coins), color, if crit or o.Mult > 1 then 80 else 60)
	Effects.burst(base + Vector3.yAxis * math.min(o.Top, 6), Color3.fromRGB(240, 248, 255), 14 + math.floor(math.min(o.Toughness, 10) * 3), 1.6)
	Effects.play("Smash", 0.9 + math.random() * 0.3)
	if o.Mult > 1 then
		Effects.play("Mutation", 1.4)
	end
	Effects.shake(0.35 + math.min(o.Toughness, 12) * 0.12)
	Hud.setRunCoins(st.Coins)
	Hud.combo(mult, stats.ComboTime)
	if crit then
		Hud.critical()
		Effects.play("Critical", 1.2)
	end
	breakApart(o, st, center)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
-- Put a fresh snowball on the start pad and point the camera down the hill.
function Runner.prepare(stats, skinId: string)
	if courseDirty or (stats.MutationKey or "") ~= mutationKey then
		Runner.resetCourse(stats.Mutations)
	end
	if ball then
		ball.Model:Destroy()
	end
	ball = makeBall(Config.SkinById[skinId] or Config.SkinById.Classic)
	run = newRun(stats)
	camPos = nil
	camLook = nil
	Runner.State = "Charge"
	local camera = Workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	Hud.setRunCoins(0, true)
	Hud.setDistance(0)
	Hud.setSpeed(0)
end

function Runner.launch(power: number)
	local st = run
	if not st or Runner.State ~= "Charge" then
		return
	end
	courseDirty = true
	st.V = math.max(8, st.Stats.Launch * power)
	Runner.State = "Rolling"
	Effects.play("Launch", 1)
	Effects.shake(0.6)
end

function Runner.canTurbo(): boolean
	return run ~= nil and Runner.State == "Rolling" and run.Time >= run.TurboUntil
end

function Runner.turbo()
	local st = run
	if not st or Runner.State ~= "Rolling" then
		return
	end
	st.TurboUntil = st.Time + (st.Stats.TurboTime or Config.Turbo.Duration)
	local burst = st.Stats.TurboSpeed or Config.Turbo.SpeedAdd
	st.V = math.min(P.MaxSpeed + burst, st.V + burst)
	st.Stopped = 0
	Effects.play("Boost", 0.8)
	Effects.play("Launch", 1.3)
	Effects.shake(1.5)
end

-- snowball centre + radius while a snowball is out (pets follow it)
function Runner.getBall(): (Vector3?, number?)
	local st = run
	if not st or not ball then
		return nil, nil
	end
	local point, up = surface(st.S, st.X)
	return point + up * (st.R + st.H + st.RampH), st.R
end

function Runner.stop()
	if ball then
		ball.Model:Destroy()
		ball = nil
	end
	run = nil
	Runner.State = "Idle"
	local camera = Workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
		TweenService:Create(camera, TweenInfo.new(0.4), { FieldOfView = 70 }):Play()
	end
	Hud.setSpeed(0)
	-- show a fresh course in the lobby again
	Runner.resetCourse(mutationIds)
end

local function finish(st)
	Runner.State = "Done"
	Runner.OnFinish({
		Distance = math.max(0, math.floor(st.S)),
		Smashed = st.Smashed,
		BestCombo = st.BestCombo,
		SmashCoins = st.Coins,
		Candy = st.Candy,
		Presents = st.Presents,
	})
end

----------------------------------------------------------------------
-- Per-frame update (called from Main, bound after the camera)
----------------------------------------------------------------------
local spinT = 0

function Runner.update(dt: number)
	local st = run
	local b = ball
	if not st or not b then
		return
	end
	dt = math.min(dt, 1 / 20)
	local stats = st.Stats
	local turbo = st.Time < st.TurboUntil

	if Runner.State == "Rolling" then
		st.Time += dt

		-- steering
		local steer = steerInput()
		local steerSpeed = stats.Steer * (if st.H > 0 then 0.7 else 1)
		st.VX += (steer * steerSpeed - st.VX) * (1 - math.exp(-dt * 8))
		local halfW = WIDTH / 2 - st.R - 1
		st.X = math.clamp(st.X + st.VX * dt, -halfW, halfW)

		-- forward motion
		local airborne = st.H > 0 or st.VH > 0
		if airborne then
			st.VH -= (stats.Gravity or P.Gravity) * dt
			st.H += st.VH * dt
			if st.H <= 0 then
				st.H = 0
				st.VH = 0
				Effects.play("Land", 0.8)
				Effects.shake(0.8)
				Effects.burst(surface(st.S, st.X), Color3.fromRGB(240, 248, 255), 26, 2)
			end
		elseif not turbo then
			st.V -= stats.Friction * dt
		end
		local maxSpeed = if turbo then P.MaxSpeed + (stats.TurboSpeed or Config.Turbo.SpeedAdd) else P.MaxSpeed
		st.V = math.clamp(st.V, 0, math.max(maxSpeed, st.V - 60 * dt))
		local ds = st.V * dt
		st.S += ds
		if not airborne then
			st.R = math.min(stats.MaxRadius, st.R + stats.Growth * ds)
		end
		st.Roll += ds / st.R

		streamAround(st.S, 1)

		local ci0 = math.max(0, math.floor((st.S - 30) / CHUNK))
		local ci1 = math.floor((st.S + 30) / CHUNK)

		-- boost pads and ramps
		st.RampH = 0
		for ci = ci0, ci1 do
			local chunk = chunks[ci]
			if chunk then
				for _, pad in chunk.Pads do
					local inLane = st.X + st.R * 0.5 >= pad.X0 and st.X - st.R * 0.5 <= pad.X1
					if not pad.Used and st.H <= 0 and inLane and st.S >= pad.S0 and st.S <= pad.S1 then
						if pad.Kind == "Boost" then
							pad.Used = true
							st.V = math.min(maxSpeed, st.V + stats.Boost)
							Effects.play("Boost", 1.1)
							Effects.shake(0.5)
						elseif pad.Kind == "Ramp" then
							-- ride up the ramp, then fly off the lip
							local frac = (st.S - pad.S0) / math.max(1, pad.S1 - pad.S0)
							st.RampH = frac * pad.Top
							if frac >= 0.92 then
								pad.Used = true
								st.H = math.max(0.01, st.RampH)
								st.RampH = 0
								st.VH = P.RampLift * stats.Air + st.V * 0.1
								Effects.play("Launch", 1.2)
							end
						end
					end
				end
			end
		end

		local point, up = surface(st.S, st.X)
		local center = point + up * (st.R + st.H + st.RampH)

		-- smash obstacles and grab coins
		for ci = math.max(0, math.floor((st.S - st.R - 20) / CHUNK)), math.floor((st.S + st.R + 20) / CHUNK) do
			local chunk = chunks[ci]
			if chunk then
				for _, o in chunk.Obstacles do
					if o.S0 > st.S + st.R then
						break
					end
					if not o.Smashed and o.S1 > st.S - st.R and st.X + st.R * 0.85 > o.X0 and st.X - st.R * 0.85 < o.X1 and st.H < o.Top then
						smash(o, st, center)
					end
				end
				for _, p in chunk.Pickups do
					local part = p.Part
					if not p.Taken and part and math.abs(p.S - st.S) < st.R + 1.5 and math.abs(p.X - st.X) < st.R + 1.5 and part.Position.Y < center.Y + st.R + 3 then
						p.Taken = true
						local value = math.floor(P.PickupValue * (stats.PickupMult or 1) * stats.CoinMult + 0.5)
						st.Coins += value
						Hud.setRunCoins(st.Coins)
						Effects.play("Coin", 1.3 + math.random() * 0.3, 0.4)
						TweenService:Create(part, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
							Size = Vector3.new(0.1, 0.1, 0.1),
							CFrame = part.CFrame + Vector3.yAxis * 4,
						}):Play()
						Debris:AddItem(part, 0.3)
						p.Part = nil
					end
				end
			end
		end

		-- end of the run (the mountain never ends, you just run out of speed)
		if st.V <= P.StopSpeed and st.H <= 0 and not turbo then
			st.Stopped += dt
			st.V = 0
			if st.Stopped > 0.35 then
				finish(st)
			end
		elseif st.Time > P.MaxRunTime then
			finish(st)
		else
			st.Stopped = 0
		end

		Hud.setDistance(math.max(0, st.S))
		Hud.setSpeed(st.V / 120)
		Effects.speedLines(dt, st.V)
	end

	-- spin nearby coins
	spinT += dt
	local ci = math.max(0, math.floor(st.S / CHUNK))
	for i = ci, ci + 1 do
		local chunk = chunks[i]
		if chunk then
			for _, p in chunk.Pickups do
				if p.Part and not p.Taken then
					p.Part.CFrame = p.Base * CFrame.Angles(0, spinT * 3, 0)
				end
			end
		end
	end

	-- place the snowball
	local point, up, forward = surface(st.S, st.X)
	local center = point + up * (st.R + st.H + st.RampH)
	local rot = CFrame.fromAxisAngle(-RIGHT, st.Roll) * CFrame.fromAxisAngle(forward, -st.X * 0.05)
	local ballCF = CFrame.new(center) * rot
	b.Body.Size = Vector3.one * st.R * 2
	b.Body.CFrame = ballCF
	if b.Skin.Rainbow then
		b.Body.Color = Color3.fromHSV((os.clock() * 0.25) % 1, 0.75, 1)
		b.Trail.Color = ColorSequence.new(b.Body.Color)
	end
	for i, c in b.Clumps do
		c.Size = Vector3.one * st.R * 0.55
		c.CFrame = ballCF * CFrame.new(CLUMP_DIRS[i] * st.R * 0.82)
	end
	b.Carrier.CFrame = CFrame.lookAt(point + up * 0.3, point + up * 0.3 + forward)
	for _, a in b.Carrier:GetChildren() do
		if a:IsA("Attachment") then
			a.Position = Vector3.new(math.sign(a.Position.X) * st.R * 0.7, 0, 0)
		end
	end
	b.Spray.Rate = if Runner.State == "Rolling" and st.H <= 0 then math.clamp(st.V * 0.8, 0, 90) else 0
	b.Trail.Enabled = Runner.State == "Rolling" and st.H <= 0.5
	b.Flames.Rate = if turbo and Runner.State == "Rolling" then 120 else 0

	-- camera
	local camera = Workspace.CurrentCamera
	if camera then
		local flatForward = Vector3.new(forward.X, 0, forward.Z).Unit
		local back = 20 + st.R * 2.4
		local height = 9 + st.R * 1.5
		local wantPos = center - flatForward * back + Vector3.yAxis * height
		local wantLook = center + forward * (10 + st.R)
		if not camPos or not camLook then
			camPos = wantPos
			camLook = wantLook
		end
		local cp = (camPos :: Vector3):Lerp(wantPos, 1 - math.exp(-dt * 6))
		local cl = (camLook :: Vector3):Lerp(wantLook, 1 - math.exp(-dt * 10))
		camPos = cp
		camLook = cl
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = CFrame.lookAt(cp, cl) * Effects.shakeOffset(dt)
		local fov = 70 + math.clamp((st.V - 40) * 0.18, 0, 30)
		camera.FieldOfView += (fov - camera.FieldOfView) * (1 - math.exp(-dt * 4))
	end
end

return Runner
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1306">
          <Properties>
            <string name="Name">PetsUI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: pets on the client. Egg panel (walk up to an egg),
-- hatch animation, Pets inventory, Index book and the pets that follow
-- every player around (and your snowball during a run).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Pets = require(Shared:WaitForChild("Pets"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))
local PetModels = require(script.Parent:WaitForChild("PetModels"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Panels = require(script.Parent:WaitForChild("Panels"))
local Effects = require(script.Parent:WaitForChild("Effects"))

local C = UIKit.Colors
local new = UIKit.new
local player = Players.LocalPlayer

local PetsUI = {}
PetsUI.Callbacks = {
	Hatch = function(_eggId: string, _count: number, _fast: boolean?): boolean return false end, -- returns when the hatch (and animation) is done
	Action = function(_action: string, _uid: string?): (boolean, any) return false, nil end,
	BuyPass = function(_key: string) end,
}
PetsUI.NearEgg = nil :: string?
PetsUI.Busy = false
-- returns (position, radius) of the snowball during a run, or nil
PetsUI.BallTarget = function(): (Vector3?, number?) return nil, nil end

local data = nil

local function hasPass(key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true
end

local function rarityColor(r: string): Color3
	return Pets.Rarities[r].Color
end

local function eggVisible(egg): boolean
	return (not egg.Halloween or Config.Halloween.Enabled) and (not egg.Winter or Config.Winter.Enabled)
end

----------------------------------------------------------------------
-- Small widgets
----------------------------------------------------------------------
-- A pet tile: rarity background, emoji, optional name/bonus line
local function petTile(parent: Instance, petId: string, size: Vector2, showName: boolean, discovered: boolean?, variant: number?): Frame
	local pet = Pets.ById[petId]
	local known = discovered ~= false
	local v = variant or 0
	local tile = new("Frame", {
		BackgroundColor3 = if known then rarityColor(pet.Rarity) else Color3.fromRGB(50, 50, 62),
		Size = UDim2.fromOffset(size.X, size.Y),
		Parent = parent,
	})
	UIKit.corner(tile, 12)
	local tileStroke = UIKit.stroke(tile, 3)
	if v > 0 and known then
		tileStroke.Color = Pets.Variants[v].Color
		tileStroke.Thickness = 4.5
	end
	UIKit.gradient(tile, { Color3.new(1, 1, 1), Color3.new(0.6, 0.6, 0.65) }, 90)
	local iconHeight = size.Y * (if showName then 0.56 else 0.78)
	if known then
		-- the real 3D pet
		PetModels.viewport(petId, tile, UDim2.new(0, iconHeight * 1.15, 0, iconHeight), UDim2.new(0.5, 0, 0, size.Y * 0.03), Vector2.new(0.5, 0), v)
		if v > 0 and showName then
			local tag = UIKit.label({ Text = "★ " .. Pets.VariantName(v), TextColor3 = Pets.Variants[v].Color, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -10, 0, 16), Position = UDim2.fromOffset(6, 4), Stroke = 2, Parent = tile })
			if v == 2 then
				UIKit.gradient(tag, { Color3.fromRGB(255, 90, 140), Color3.fromRGB(255, 230, 90), Color3.fromRGB(100, 255, 160), Color3.fromRGB(90, 190, 255), Color3.fromRGB(210, 120, 255) }, 0)
			end
		end
	else
		UIKit.label({
			Text = "?",
			Size = UDim2.new(0.8, 0, 0, iconHeight),
			Position = UDim2.new(0.5, 0, 0, size.Y * 0.06),
			AnchorPoint = Vector2.new(0.5, 0),
			Stroke = 3,
			TextColor3 = Color3.fromRGB(150, 150, 165),
			Parent = tile,
		})
	end
	if showName then
		UIKit.label({
			Text = if known then pet.Name else "???",
			Size = UDim2.new(1, -10, 0, size.Y * 0.17),
			Position = UDim2.new(0.5, 0, 0, size.Y * 0.6),
			AnchorPoint = Vector2.new(0.5, 0),
			Stroke = 2,
			Parent = tile,
		})
		UIKit.label({
			Text = if known then "+" .. Config.Short(pet.Coins * Pets.Variants[v].Mult) .. "%" else pet.Rarity,
			TextColor3 = if known then Color3.fromRGB(255, 230, 90) else Color3.fromRGB(200, 200, 210),
			Size = UDim2.new(1, -10, 0, size.Y * 0.15),
			Position = UDim2.new(0.5, 0, 0, size.Y * 0.79),
			AnchorPoint = Vector2.new(0.5, 0),
			Stroke = 2,
			Parent = tile,
		})
	end
	return tile
end

local function eggSprite(parent: Instance, color: Color3, size: number, position: UDim2): Frame
	local egg = new("Frame", {
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(size * 0.8, size),
		Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = parent,
	})
	UIKit.round(egg)
	UIKit.stroke(egg, math.max(3, size / 28))
	UIKit.gradient(egg, { Color3.new(1, 1, 1), Color3.new(0.65, 0.65, 0.75) }, 60)
	for _, spot in { { 0.3, 0.3, 0.16 }, { 0.62, 0.22, 0.1 }, { 0.65, 0.58, 0.14 }, { 0.32, 0.68, 0.1 } } do
		local s = new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.25,
			Size = UDim2.fromScale(spot[3], spot[3] * 0.8),
			Position = UDim2.fromScale(spot[1], spot[2]),
			Parent = egg,
		})
		UIKit.round(s)
	end
	new("UIScale", { Parent = egg })
	return egg
end

----------------------------------------------------------------------
-- Egg panel (shows when you stand next to an egg in the lobby)
----------------------------------------------------------------------
local eggPanel = new("Frame", {
	Name = "EggPanel",
	BackgroundColor3 = C.Wood,
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, 300),
	Size = UDim2.fromOffset(560, 270),
	Visible = false,
	ZIndex = 15,
	Parent = Hud.Root,
})
UIKit.corner(eggPanel, 18)
UIKit.stroke(eggPanel, 4)
local eggHeader = new("Frame", {
	BackgroundColor3 = C.Yellow,
	Size = UDim2.new(1, 16, 0, 56),
	Position = UDim2.fromOffset(-8, -22),
	Parent = eggPanel,
})
UIKit.corner(eggHeader, 14)
UIKit.stroke(eggHeader, 4)
local eggTitle = UIKit.label({ Text = "Frosty Egg", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.6, 0, 0, 36), Position = UDim2.fromOffset(18, 10), Stroke = 3, Parent = eggHeader })
local eggPrice = UIKit.label({ Text = "", TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.4, -24, 0, 32), Position = UDim2.new(0.6, 0, 0, 12), Stroke = 3, TextColor3 = Color3.fromRGB(255, 225, 70), Parent = eggHeader })
local oddsRow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -24, 0, 112), Position = UDim2.fromOffset(12, 44), Parent = eggPanel })
new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8), Parent = oddsRow })

local function eggButton(text: string, x: number, color: Color3, dark: Color3, key: string, onClick: () -> ()): UIKit.Button
	local b = UIKit.button({ Size = UDim2.fromOffset(166, 62), Position = UDim2.fromOffset(x, 186), Color = color, DarkColor = dark, Text = text, Key = key, Studs = true, Parent = eggPanel, OnClick = onClick })
	b.Label.TextXAlignment = Enum.TextXAlignment.Center
	return b
end

local autoOn = false
local shownEgg: string? = nil
PetsUI.toggleAuto = function() end -- defined below

local function hatch(count: number)
	if not shownEgg or PetsUI.Busy then
		return
	end
	if count == 3 and not hasPass("TripleHatch") then
		PetsUI.Callbacks.BuyPass("TripleHatch")
		return
	end
	PetsUI.Callbacks.Hatch(shownEgg, count)
end

local _hatch1 = eggButton("Hatch", 14, C.Green, C.GreenDark, "E", function()
	hatch(1)
end)
local hatch3 = eggButton("Hatch x3", 197, C.Blue, C.BlueDark, "R", function()
	hatch(3)
end)
local autoButton = eggButton("Auto", 380, C.Purple, C.PurpleDark, "T", function()
	PetsUI.toggleAuto()
end)

PetsUI.toggleAuto = function()
	if not hasPass("AutoHatch") then
		PetsUI.Callbacks.BuyPass("AutoHatch")
		return
	end
	autoOn = not autoOn
	autoButton.SetText(if autoOn then "Auto: ON" else "Auto")
	autoButton.SetColors(if autoOn then C.Green else C.Purple, if autoOn then C.GreenDark else C.PurpleDark)
end

local function fillEggPanel(eggId: string)
	local egg = Pets.EggById[eggId]
	eggTitle.Text = "🥚 " .. egg.Name
	local state = ReplicatedStorage:FindFirstChild("GameState")
	local partyMult = Config.EventProduct("EggPriceMult", function(id)
		local ends = state and state:GetAttribute("Event_" .. id)
		return type(ends) == "number" and ends > Workspace:GetServerTimeNow()
	end)
	local price = math.max(1, math.floor((if data then Config.EggPrice(data.Owned, egg.Price) else egg.Price) * partyMult + 0.5))
	local currency = Config.Currencies[egg.Currency] or Config.Currencies.Coins
	eggPrice.Text = currency.Icon .. " " .. Config.Commas(price) .. (if price < egg.Price then (if partyMult < 1 then " 🎉" else " 🏷️") else "")
	eggPrice.TextColor3 = currency.Color
	for _, c in oddsRow:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local luckState = ReplicatedStorage:FindFirstChild("GameState")
	local eventLuck = Config.EventProduct("HatchLuck", function(id)
		local ends = luckState and luckState:GetAttribute("Event_" .. id)
		return type(ends) == "number" and ends > Workspace:GetServerTimeNow()
	end, function(id)
		local m = luckState and luckState:GetAttribute("EventMult_" .. id)
		return if type(m) == "number" and m >= 1 then m else 1
	end)
	local luck = (if hasPass("LuckyEggs") then 1.5 else 1) * (if data then Config.HatchLuckMult(data.Owned) else 1) * eventLuck
	local odds = Pets.Odds(eggId, luck)
	for i, pet in egg.Pets do
		local known = data ~= nil and data.Index[pet.Id] == true
		local tile = petTile(oddsRow, pet.Id, Vector2.new(78, 84), false, known or pet.Rarity ~= "Secret")
		tile.LayoutOrder = i
		local chance = odds[pet.Id]
		UIKit.label({
			Text = if chance < 1 then string.format("%.1f%%", chance) else string.format("%d%%", math.floor(chance + 0.5)),
			Size = UDim2.new(1, -6, 0, 22),
			Position = UDim2.new(0.5, 0, 1, -4),
			AnchorPoint = Vector2.new(0.5, 1),
			Stroke = 2.5,
			Parent = tile,
		})
	end
	hatch3.SetText(if hasPass("TripleHatch") then "Hatch x3" else "x3 🔒")
	autoButton.SetText(if not hasPass("AutoHatch") then "Auto 🔒" elseif autoOn then "Auto: ON" else "Auto")
end

local eggModels = {}
task.spawn(function()
	local lobby = Workspace:WaitForChild("Lobby", 30)
	if not lobby then
		return
	end
	local function scan()
		for _, d in lobby:GetDescendants() do
			local id = string.match(d.Name, "^Egg_(.+)$")
			if id and Pets.EggById[id] and d:IsA("Model") then
				eggModels[id] = d
			end
		end
	end
	scan()
	lobby.DescendantAdded:Connect(function()
		task.defer(scan)
	end)
end)

local panelShown = false
local function showEggPanel(eggId: string?)
	if eggId == shownEgg and (eggId ~= nil) == panelShown then
		return
	end
	shownEgg = eggId
	if eggId then
		fillEggPanel(eggId)
		if not panelShown then
			panelShown = true
			eggPanel.Visible = true
			eggPanel.Position = UDim2.new(0.5, 0, 1, 300)
			UIKit.tween(eggPanel, 0.4, { Position = UDim2.new(0.5, 0, 1, -130) }, Enum.EasingStyle.Back)
		end
	elseif panelShown then
		panelShown = false
		autoOn = false
		local t = UIKit.tween(eggPanel, 0.25, { Position = UDim2.new(0.5, 0, 1, 300) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if not panelShown then
				eggPanel.Visible = false
			end
		end)
	end
end

RunService.Heartbeat:Connect(function()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local nearest, best = nil, 14
	if root and Hud.Mode == "Idle" and not Panels.anyOpen() then
		for id, m in eggModels do
			local egg = Pets.EggById[id]
			if m.Parent and eggVisible(egg) then
				local d = (m:GetPivot().Position - root.Position) * Vector3.new(1, 0, 1)
				if d.Magnitude < best then
					nearest, best = id, d.Magnitude
				end
			end
		end
	end
	PetsUI.NearEgg = nearest
	showEggPanel(nearest)
end)

-- auto hatch loop
task.spawn(function()
	while true do
		task.wait(0.2)
		if autoOn and shownEgg and not PetsUI.Busy then
			if not hasPass("AutoHatch") then
				autoOn = false
			else
				local ok = PetsUI.Callbacks.Hatch(shownEgg, if hasPass("TripleHatch") then 3 else 1, true)
				if not ok then
					autoOn = false
					autoButton.SetText("Auto")
					autoButton.SetColors(C.Purple, C.PurpleDark)
				end
			end
		end
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not shownEgg then
		return
	end
	if input.KeyCode == Enum.KeyCode.E then
		hatch(1)
	elseif input.KeyCode == Enum.KeyCode.R then
		hatch(3)
	elseif input.KeyCode == Enum.KeyCode.T then
		PetsUI.toggleAuto()
	end
end)

----------------------------------------------------------------------
-- Hatch animation
----------------------------------------------------------------------
local overlay = new("Frame", {
	Name = "Hatch",
	BackgroundColor3 = Color3.fromRGB(10, 14, 30),
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	ZIndex = 60,
	Parent = Hud.Root,
})
local flash = new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 70, Parent = overlay })

-- plays the hatch animation for `results` (list of pet ids); yields until done
-- variants (optional): parallel list of variant numbers (0 normal, 1 Golden, 2 Rainbow)
function PetsUI.playHatch(eggId: string, results: { string }, newPets: { [string]: boolean }, fast: boolean?, variants: { number }?)
	local egg = Pets.EggById[eggId]
	local speed = if fast then 0.55 else 1
	overlay.Visible = true
	overlay.BackgroundTransparency = 1
	UIKit.tween(overlay, 0.25 * speed, { BackgroundTransparency = 0.35 })
	local holders = {}
	local n = #results
	for i = 1, n do
		local x = 0.5 + (i - (n + 1) / 2) * 0.26
		local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(300, 380), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, 0.5), ZIndex = 62, Parent = overlay })
		local sprite = eggSprite(holder, egg.Color, if n == 1 then 230 else 170, UDim2.fromScale(0.5, 0.45))
		local scale = sprite:FindFirstChildOfClass("UIScale")
		scale.Scale = 0
		UIKit.tween(scale, 0.35 * speed, { Scale = 1 }, Enum.EasingStyle.Back)
		holders[i] = { Holder = holder, Sprite = sprite }
	end
	task.wait(0.35 * speed)
	-- wobble harder and harder
	local wobbles = if fast then 4 else 7
	for w = 1, wobbles do
		local angle = (if w % 2 == 0 then 1 else -1) * (6 + w * 3)
		for _, h in holders do
			UIKit.tween(h.Sprite, 0.09 * speed, { Rotation = angle })
		end
		Effects.play("Click", 0.8 + w * 0.08, 0.5)
		task.wait(0.1 * speed + (wobbles - w) * 0.012)
	end
	flash.BackgroundTransparency = 0
	UIKit.tween(flash, 0.5 * speed, { BackgroundTransparency = 1 })
	Effects.play("Smash", 1.4)
	local bestOrder = 0
	for i, h in holders do
		h.Sprite:Destroy()
		local pet = Pets.ById[results[i]]
		local variant = if variants then variants[i] or 0 else 0
		bestOrder = math.max(bestOrder, Pets.Rarities[pet.Rarity].Order, if variant > 0 then 4 else 0)
		local rays = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(340, 340), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), ZIndex = 62, Parent = h.Holder })
		for r = 1, 8 do
			local ray = new("Frame", {
				BackgroundColor3 = rarityColor(pet.Rarity),
				BackgroundTransparency = 0.55,
				BorderSizePixel = 0,
				Size = UDim2.fromOffset(34, 340),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Rotation = r * 22.5,
				ZIndex = 62,
				Parent = rays,
			})
			UIKit.corner(ray, 17)
		end
		task.spawn(function()
			while rays.Parent do
				rays.Rotation += 1.2
				RunService.RenderStepped:Wait()
			end
		end)
		local icon, petModel = PetModels.viewport(pet.Id, h.Holder, UDim2.fromOffset(250, 250), UDim2.fromScale(0.5, 0.42), Vector2.new(0.5, 0.5), variant)
		icon.ZIndex = 64
		UIKit.pop(icon, 0.2)
		task.spawn(function()
			local spin = math.rad(-25)
			while icon.Parent do
				local dt = RunService.RenderStepped:Wait()
				spin += dt * 1.6
				petModel:PivotTo(CFrame.new(0, math.sin(os.clock() * 3) * 0.12, 0) * CFrame.Angles(0, spin, 0))
			end
		end)
		local name = UIKit.label({ Text = Pets.FullName(pet.Id, variant), Size = UDim2.fromOffset(300, 44), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.72), Stroke = 3.5, ZIndex = 64, Parent = h.Holder })
		local rarity = UIKit.label({ Text = string.upper(pet.Rarity), TextColor3 = rarityColor(pet.Rarity), Size = UDim2.fromOffset(300, 36), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.84), Stroke = 3, ZIndex = 64, Parent = h.Holder })
		if pet.Rarity == "Secret" then
			UIKit.gradient(rarity, { Color3.fromRGB(255, 80, 80), Color3.fromRGB(255, 220, 60), Color3.fromRGB(80, 220, 255), Color3.fromRGB(200, 90, 255) }, 0)
		end
		UIKit.pop(name, 0.4)
		if newPets[results[i]] then
			local tag = new("Frame", { BackgroundColor3 = C.Pink, Size = UDim2.fromOffset(90, 40), Position = UDim2.new(0.5, 70, 0.12, 0), Rotation = 12, ZIndex = 66, Parent = h.Holder })
			UIKit.corner(tag, 10)
			UIKit.stroke(tag, 3)
			UIKit.label({ Text = "NEW!", Size = UDim2.new(1, -10, 1, -8), Position = UDim2.fromOffset(5, 4), Stroke = 2.5, ZIndex = 67, Parent = tag })
			UIKit.pop(tag, 1.8)
		end
	end
	if bestOrder >= 4 then
		Effects.play("NewBest", 1)
		Effects.shake(1.5)
	else
		Effects.play("Coin", 1.3)
	end
	task.wait((if bestOrder >= 4 then 1.9 else 1.3) * speed)
	UIKit.tween(overlay, 0.25 * speed, { BackgroundTransparency = 1 })
	for _, h in holders do
		local s = new("UIScale", { Parent = h.Holder })
		UIKit.tween(s, 0.25 * speed, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	end
	task.wait(0.27 * speed)
	for _, h in holders do
		h.Holder:Destroy()
	end
	overlay.Visible = false
end

----------------------------------------------------------------------
-- Pets inventory panel
----------------------------------------------------------------------
local petsPanel = UIKit.panel(Hud.Root, "Pets", "🐾", 860, 600)
Panels.register("Pets", petsPanel)

local countLabel = UIKit.label({ Text = "", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromOffset(200, 30), Position = UDim2.fromOffset(4, 6), Stroke = 2.5, Parent = petsPanel.Content })
local fuseAll = UIKit.button({ Size = UDim2.fromOffset(160, 48), Position = UDim2.new(1, -562, 0, 0), Color = Color3.fromRGB(255, 190, 40), DarkColor = Color3.fromRGB(190, 120, 10), Text = "Fuse All ✨", Parent = petsPanel.Content, OnClick = function()
	PetsUI.Callbacks.Action("FuseAll", nil)
end })
fuseAll.Label.TextXAlignment = Enum.TextXAlignment.Center
local equipBest = UIKit.button({ Size = UDim2.fromOffset(190, 48), Position = UDim2.new(1, -394, 0, 0), Color = C.Green, DarkColor = C.GreenDark, Text = "Equip Best", Parent = petsPanel.Content, OnClick = function()
	PetsUI.Callbacks.Action("EquipBest", nil)
end })
equipBest.Label.TextXAlignment = Enum.TextXAlignment.Center
local confirmDelete = 0
local deleteAll
deleteAll = UIKit.button({ Size = UDim2.fromOffset(190, 48), Position = UDim2.new(1, -194, 0, 0), Color = C.Red, DarkColor = C.RedDark, Text = "Delete Unlocked", Parent = petsPanel.Content, OnClick = function()
	if os.clock() - confirmDelete < 3 then
		confirmDelete = 0
		deleteAll.SetText("Delete Unlocked")
		PetsUI.Callbacks.Action("DeleteUnlocked", nil)
	else
		confirmDelete = os.clock()
		deleteAll.SetText("Sure? Click again")
		task.delay(3, function()
			deleteAll.SetText("Delete Unlocked")
		end)
	end
end })
deleteAll.Label.TextXAlignment = Enum.TextXAlignment.Center

local grid = new("ScrollingFrame", {
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Size = UDim2.new(1, 0, 1, -150),
	Position = UDim2.fromOffset(0, 60),
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollBarThickness = 8,
	ScrollBarImageColor3 = C.Yellow,
	ScrollingDirection = Enum.ScrollingDirection.Y,
	Parent = petsPanel.Content,
})
new("UIGridLayout", { CellSize = UDim2.fromOffset(118, 140), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), Parent = grid })

-- bottom bar for the selected pet
local selectedUid: string? = nil
local bar = new("Frame", { BackgroundColor3 = C.WoodDark, Size = UDim2.new(1, 0, 0, 78), Position = UDim2.new(0, 0, 1, -78), Parent = petsPanel.Content })
UIKit.corner(bar, 12)
UIKit.stroke(bar, 3)
local barInfo = UIKit.label({ Text = "Click a pet to select it", TextXAlignment = Enum.TextXAlignment.Left, TextScaled = false, TextSize = 20, TextWrapped = true, Size = UDim2.new(1, -490, 1, -12), Position = UDim2.fromOffset(14, 6), Stroke = 2, RichText = true, Parent = bar })
local function barButton(text: string, x: number, color: Color3, dark: Color3, action: string): UIKit.Button
	local b = UIKit.button({ Size = UDim2.fromOffset(112, 52), Position = UDim2.new(1, x, 0.5, -26), Color = color, DarkColor = dark, Text = text, Parent = bar, Corner = 10, OnClick = function()
		if selectedUid then
			PetsUI.Callbacks.Action(action, selectedUid)
		end
	end })
	b.Label.TextXAlignment = Enum.TextXAlignment.Center
	return b
end
local equipButton = barButton("Equip", -472, C.Green, C.GreenDark, "Equip")
local lockButton = barButton("Lock", -354, C.Blue, C.BlueDark, "ToggleLock")
local fuseButton = barButton("Fuse", -236, Color3.fromRGB(255, 190, 40), Color3.fromRGB(190, 120, 10), "Fuse")
barButton("Delete", -118, C.Red, C.RedDark, "Delete")

local function slots(): number
	return Pets.BaseEquipSlots + (if hasPass("ExtraPets") then Pets.ExtraSlotsPass else 0)
end

local function refreshBar()
	local owned = selectedUid and data and data.Pets[selectedUid]
	if not owned then
		selectedUid = nil
		barInfo.Text = "Click a pet to select it"
		return
	end
	local pet = Pets.ById[owned.P]
	local hex = rarityColor(pet.Rarity):ToHex()
	local v = owned.V or 0
	barInfo.Text = string.format('%s <b>%s</b>  <font color="#%s">%s</font>\n%s', pet.Icon, Pets.FullName(owned.P, v), hex, pet.Rarity, Pets.BonusText(owned.P, v))
	local equipped = table.find(data.Equipped, selectedUid) ~= nil
	equipButton.SetText(if equipped then "Unequip" else "Equip")
	equipButton.SetColors(if equipped then C.Grey else C.Green, if equipped then C.GreyDark else C.GreenDark)
	lockButton.SetText(if owned.L then "Unlock" else "Lock")
	-- how many identical unlocked pets do we have?
	local same = 0
	for _, p in data.Pets do
		if p.P == owned.P and (p.V or 0) == v and not p.L then
			same += 1
		end
	end
	if v >= Pets.MaxVariant then
		fuseButton.SetText("Max ★")
		fuseButton.SetColors(C.Grey, C.GreyDark)
	elseif same >= Pets.FuseCount and not owned.L then
		fuseButton.SetText("Fuse! ✨")
		fuseButton.SetColors(Color3.fromRGB(255, 190, 40), Color3.fromRGB(190, 120, 10))
	else
		fuseButton.SetText(string.format("Fuse %d/%d", math.min(same, Pets.FuseCount), Pets.FuseCount))
		fuseButton.SetColors(C.Grey, C.GreyDark)
	end
end

-- the Equip button toggles
equipButton.Clicked = function()
	if selectedUid and data then
		local equipped = table.find(data.Equipped, selectedUid) ~= nil
		PetsUI.Callbacks.Action(if equipped then "Unequip" else "Equip", selectedUid)
	end
end

local function refreshInventory()
	for _, c in grid:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	if not data then
		return
	end
	local list = {}
	local count = 0
	for uid, owned in data.Pets do
		count += 1
		table.insert(list, { Uid = uid, Pet = owned.P, Variant = owned.V or 0, Locked = owned.L, Equipped = table.find(data.Equipped, uid) ~= nil })
	end
	table.sort(list, function(a, b)
		if a.Equipped ~= b.Equipped then
			return a.Equipped
		end
		return Pets.Score(a.Pet, a.Variant) > Pets.Score(b.Pet, b.Variant)
	end)
	countLabel.Text = string.format("Equipped %d/%d  ·  Pets %d/%d", #data.Equipped, slots(), count, Pets.MaxInventory + Config.PetStorageBonus(data.Owned))
	for i, item in list do
		local tile = petTile(grid, item.Pet, Vector2.new(118, 140), true, nil, item.Variant)
		tile.LayoutOrder = i
		if item.Equipped then
			local check = new("Frame", { BackgroundColor3 = C.Green, Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(-6, -6), Parent = tile })
			UIKit.round(check)
			UIKit.stroke(check, 2.5)
			UIKit.label({ Text = "✔", Size = UDim2.fromScale(0.75, 0.75), Position = UDim2.fromScale(0.125, 0.125), Stroke = 0, Parent = check })
		end
		if item.Locked then
			UIKit.label({ Text = "🔒", Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, -28, 0, 2), Stroke = 0, Parent = tile })
		end
		if item.Uid == selectedUid then
			local outline = tile:FindFirstChildOfClass("UIStroke")
			if outline then
				outline.Color = C.Yellow
				outline.Thickness = 5
			end
		end
		local hit = new("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), Parent = tile })
		hit.Activated:Connect(function()
			selectedUid = item.Uid
			Effects.play("Click", 1.2)
			refreshInventory()
		end)
	end
	refreshBar()
end

----------------------------------------------------------------------
-- Index panel
----------------------------------------------------------------------
local indexPanel = UIKit.panel(Hud.Root, "Index", "📘", 860, 600)
Panels.register("Index", indexPanel)
local indexBonus = UIKit.label({ Text = "", TextColor3 = Color3.fromRGB(140, 255, 110), Size = UDim2.new(1, 0, 0, 30), Stroke = 2.5, Parent = indexPanel.Content })
local indexScroll = new("ScrollingFrame", {
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Size = UDim2.new(1, 0, 1, -40),
	Position = UDim2.fromOffset(0, 40),
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollBarThickness = 8,
	ScrollBarImageColor3 = C.Yellow,
	ScrollingDirection = Enum.ScrollingDirection.Y,
	Parent = indexPanel.Content,
})
new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = indexScroll })
new("UIPadding", { PaddingRight = UDim.new(0, 14), Parent = indexScroll })

local function refreshIndex()
	for _, c in indexScroll:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	if not data then
		return
	end
	local completed = Pets.CompletedEggs(data.Index)
	indexBonus.Text = string.format("Complete an egg = +%d%% coins forever  ·  Your Index bonus: +%d%%", Pets.IndexBonus, #completed * Pets.IndexBonus)
	for i, egg in Pets.Eggs do
		if eggVisible(egg) or table.find(completed, egg.Id) then
			local found = 0
			for _, p in egg.Pets do
				if data.Index[p.Id] then
					found += 1
				end
			end
			local done = table.find(completed, egg.Id) ~= nil
			local section = new("Frame", { BackgroundColor3 = C.WoodLight, Size = UDim2.new(1, 0, 0, 170), LayoutOrder = i, Parent = indexScroll })
			UIKit.corner(section, 12)
			UIKit.stroke(section, 3, if done then C.Yellow else C.Outline)
			UIKit.label({ Text = "🥚 " .. egg.Name .. "   " .. found .. "/" .. #egg.Pets, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.6, 0, 0, 30), Position = UDim2.fromOffset(14, 8), Stroke = 2.5, Parent = section })
			UIKit.label({
				Text = if done then "✔ +" .. Pets.IndexBonus .. "% coins" else "Reward: +" .. Pets.IndexBonus .. "% coins",
				TextColor3 = if done then Color3.fromRGB(140, 255, 110) else Color3.fromRGB(255, 225, 120),
				TextXAlignment = Enum.TextXAlignment.Right,
				Size = UDim2.new(0.4, -20, 0, 26),
				Position = UDim2.new(0.6, 0, 0, 10),
				Stroke = 2,
				Parent = section,
			})
			local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -24, 0, 118), Position = UDim2.fromOffset(12, 44), Parent = section })
			new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), Parent = row })
			for j, p in egg.Pets do
				local tile = petTile(row, p.Id, Vector2.new(112, 116), true, data.Index[p.Id] == true)
				tile.LayoutOrder = j
			end
		end
	end
end

----------------------------------------------------------------------
-- Pets following players (and your snowball during a run)
----------------------------------------------------------------------
local followFolder = Instance.new("Folder")
followFolder.Name = "PetFollowers"
followFolder.Parent = Workspace

type Follower = { Model: Model, Pos: Vector3, Dir: Vector3, PetId: string }
local followers: { [Player]: { Follower } } = {}

-- key = "petId:variant"
local function makeFollower(key: string): Follower
	local petId, variant = table.unpack(string.split(key, ":"))
	local model = PetModels.build(petId, true, tonumber(variant) or 0)
	model.Parent = followFolder
	return { Model = model, Pos = Vector3.zero, Dir = Vector3.new(0, 0, -1), PetId = key }
end

local function syncFollowers(p: Player)
	local ids = string.split(tostring(p:GetAttribute("EquippedPets") or ""), ",")
	local list = followers[p] or {}
	local want = {}
	for _, key in ids do
		if Pets.ById[(string.split(key, ":"))[1]] then
			table.insert(want, key)
		end
	end
	-- rebuild only when the set changed
	local same = #want == #list
	if same then
		for i, f in list do
			if f.PetId ~= want[i] then
				same = false
			end
		end
	end
	if same then
		return
	end
	for _, f in list do
		f.Model:Destroy()
	end
	list = {}
	for _, id in want do
		table.insert(list, makeFollower(id))
	end
	followers[p] = list
end

local function watch(p: Player)
	syncFollowers(p)
	p:GetAttributeChangedSignal("EquippedPets"):Connect(function()
		syncFollowers(p)
	end)
end
for _, p in Players:GetPlayers() do
	watch(p)
end
Players.PlayerAdded:Connect(watch)
Players.PlayerRemoving:Connect(function(p)
	local list = followers[p]
	if list then
		for _, f in list do
			f.Model:Destroy()
		end
	end
	followers[p] = nil
end)

RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	for p, list in followers do
		local center, look, spread, flying = nil, nil, 4, false
		if p == player then
			local ballPos, radius = PetsUI.BallTarget()
			if ballPos then
				center = ballPos + Vector3.new(0, (radius or 3) + 3, 0)
				look = Vector3.new(0, 0, -1)
				spread = 4 + (radius or 3) * 0.8
				flying = true
			end
		end
		if not center then
			local character = p.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				center = root.Position - Vector3.new(0, 1.55, 0) -- standing on the ground next to you
				look = root.CFrame.LookVector
			end
		end
		if center and look then
			local flat = Vector3.new(look.X, 0, look.Z)
			flat = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, -1)
			local right = flat:Cross(Vector3.yAxis)
			for i, f in list do
				local side = (i - (#list + 1) / 2)
				local want = center - flat * (spread * 0.9 + math.abs(side) * 0.8) + right * side * spread * 0.7
				if f.Pos == Vector3.zero or (f.Pos - want).Magnitude > 80 then
					f.Pos = want
				end
				local before = f.Pos
				f.Pos = f.Pos:Lerp(want, 1 - math.exp(-dt * 7))
				local move = (f.Pos - before) / math.max(dt, 1 / 240)
				local moveFlat = Vector3.new(move.X, 0, move.Z)
				local speed = moveFlat.Magnitude
				-- face where we're walking, or the same way as the owner when standing still
				local wantDir = if speed > 1.5 then moveFlat.Unit else flat
				f.Dir = f.Dir:Lerp(wantDir, 1 - math.exp(-dt * 8))
				if f.Dir.Magnitude < 0.05 then
					f.Dir = wantDir
				end
				-- little hops while walking, a gentle float while flying or idle
				local hop = if flying then math.sin(t * 3 + i) * 0.5
					else math.abs(math.sin(t * 11 + i * 1.7)) * 0.8 * math.clamp(speed / 6, 0, 1) + math.sin(t * 2.5 + i) * 0.08
				local tilt = if flying then 0 else math.clamp(speed / 30, 0, 0.25)
				local pos = f.Pos + Vector3.new(0, hop, 0)
				f.Model:PivotTo(CFrame.lookAt(pos, pos + f.Dir.Unit) * CFrame.Angles(-tilt, 0, math.sin(t * 11 + i) * tilt * 0.6))
			end
		end
	end
end)

----------------------------------------------------------------------
-- Refresh from player data
----------------------------------------------------------------------
function PetsUI.refresh(newData)
	data = newData
	if petsPanel.IsOpen then
		refreshInventory()
	end
	if indexPanel.IsOpen then
		refreshIndex()
	end
	if shownEgg then
		fillEggPanel(shownEgg)
	end
end

-- rebuild lists when the panels open
petsPanel.Root:GetPropertyChangedSignal("Visible"):Connect(function()
	if petsPanel.Root.Visible then
		refreshInventory()
	end
end)
indexPanel.Root:GetPropertyChangedSignal("Visible"):Connect(function()
	if indexPanel.Root.Visible then
		refreshIndex()
	end
end)
player.AttributeChanged:Connect(function(name)
	if string.sub(name, 1, 5) == "Pass_" then
		PetsUI.refresh(data)
	end
end)

return PetsUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1307">
          <Properties>
            <string name="Name">DailyUI</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: daily login rewards (7-day streak) and redeem codes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Pets = require(Shared:WaitForChild("Pets"))
local UIKit = require(script.Parent:WaitForChild("UIKit"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Panels = require(script.Parent:WaitForChild("Panels"))

local C = UIKit.Colors
local new = UIKit.new

local DailyUI = {}
DailyUI.Callbacks = {
	Claim = function() end,
	Redeem = function(_code: string) end,
}

local data = nil

local function today(): number
	return math.floor(os.time() / 86400)
end

-- day (1-7) you would get if you claimed now, and whether you can
function DailyUI.status(d): (number, boolean)
	if not d then
		return 1, false
	end
	local day = today()
	if d.LastDaily == day then
		return d.DailyStreak, false
	end
	local streak = if d.LastDaily == day - 1 then d.DailyStreak % #Config.Daily + 1 else 1
	return streak, true
end

local function rewardText(r): (string, string)
	if r.Egg then
		local egg = Pets.EggById[r.Egg]
		return "🥚", (if egg then egg.Name else "Egg") .. (if r.Coins then "\n+" .. Config.Short(r.Coins) else "")
	elseif r.Turbos then
		return "🚀", r.Turbos .. " Turbo" .. (if r.Turbos > 1 then "s" else "") .. (if r.Candy then "\n+" .. r.Candy .. " 🍬" else "")
	elseif r.Candy then
		return "🍬", "+" .. r.Candy .. " candy"
	end
	return "🪙", "+" .. Config.Short(r.Coins or 0)
end

local panel = UIKit.panel(Hud.Root, "Daily Rewards", "🎁", 860, 560)
Panels.register("Daily", panel)

local daysRow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 170), Parent = panel.Content })
new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10), Parent = daysRow })

local dayTiles = {}
for i, reward in Config.Daily do
	local tile = new("Frame", { BackgroundColor3 = C.WoodLight, Size = UDim2.fromOffset(104, 160), LayoutOrder = i, Parent = daysRow })
	UIKit.corner(tile, 12)
	local stroke = UIKit.stroke(tile, 3)
	UIKit.label({ Text = "DAY " .. i, Size = UDim2.new(1, -10, 0, 24), Position = UDim2.fromOffset(5, 8), Stroke = 2.5, Parent = tile })
	local icon, text = rewardText(reward)
	UIKit.label({ Text = icon, Size = UDim2.fromOffset(54, 54), Position = UDim2.new(0.5, 0, 0, 38), AnchorPoint = Vector2.new(0.5, 0), Stroke = 0, Parent = tile })
	UIKit.label({ Text = text, TextScaled = false, TextSize = 16, TextWrapped = true, Size = UDim2.new(1, -8, 0, 50), Position = UDim2.fromOffset(4, 100), Stroke = 2, Parent = tile })
	local check = UIKit.label({ Text = "✔", TextColor3 = Color3.fromRGB(120, 255, 100), Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -6, 0, -10), AnchorPoint = Vector2.new(1, 0), Stroke = 3, Visible = false, Parent = tile })
	dayTiles[i] = { Tile = tile, Stroke = stroke, Check = check }
end

local claim = UIKit.button({
	Size = UDim2.fromOffset(300, 66),
	Position = UDim2.new(0.5, -150, 0, 186),
	Color = C.Green,
	DarkColor = C.GreenDark,
	Text = "Claim!",
	Studs = true,
	Parent = panel.Content,
	OnClick = function()
		DailyUI.Callbacks.Claim()
	end,
})
claim.Label.TextXAlignment = Enum.TextXAlignment.Center
local timer = UIKit.label({ Text = "", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 258), Stroke = 2, TextColor3 = Color3.fromRGB(255, 225, 120), Parent = panel.Content })

-- codes
local codes = new("Frame", { BackgroundColor3 = C.WoodLight, Size = UDim2.new(1, 0, 0, 112), Position = UDim2.new(0, 0, 1, -112), Parent = panel.Content })
UIKit.corner(codes, 12)
UIKit.stroke(codes, 3)
UIKit.label({ Text = "🎟️ Got a code? (follow the game for new ones!)", TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -24, 0, 26), Position = UDim2.fromOffset(14, 8), Stroke = 2.5, Parent = codes })
local codeBox = UIKit.textbox(codes, "Enter code...", UDim2.new(1, -200, 0, 50), UDim2.fromOffset(14, 46))
local redeem = UIKit.button({ Size = UDim2.fromOffset(160, 54), Position = UDim2.new(1, -174, 0, 44), Color = C.Purple, DarkColor = C.PurpleDark, Text = "Redeem", Parent = codes, OnClick = function()
	DailyUI.Callbacks.Redeem(codeBox.Text)
	codeBox.Text = ""
end })
redeem.Label.TextXAlignment = Enum.TextXAlignment.Center

local function refresh()
	local day, can = DailyUI.status(data)
	for i, t in dayTiles do
		local claimed = data ~= nil and ((can and i < day) or (not can and i <= day))
		t.Check.Visible = claimed
		t.Tile.BackgroundColor3 = if claimed then C.WoodDark elseif i == day and can then Color3.fromRGB(70, 150, 60) else C.WoodLight
		t.Stroke.Color = if i == day and can then C.Yellow else C.Outline
		t.Stroke.Thickness = if i == day and can then 5 else 3
	end
	claim.SetText(if can then "Claim Day " .. day .. "!" else "Claimed ✔")
	claim.SetColors(if can then C.Green else C.Grey, if can then C.GreenDark else C.GreyDark)
end

RunService.Heartbeat:Connect(function()
	if panel.IsOpen then
		local _, can = DailyUI.status(data)
		if can then
			timer.Text = "Come back every day - miss a day and the streak starts over!"
		else
			local left = (today() + 1) * 86400 - os.time()
			timer.Text = string.format("Next reward in %d:%02d:%02d", left // 3600, (left % 3600) // 60, left % 60)
		end
	end
end)

function DailyUI.refresh(newData)
	data = newData
	refresh()
	local _, can = DailyUI.status(data)
	Hud.setAlert("Daily", can)
end

return DailyUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1308">
          <Properties>
            <string name="Name">CrazyFX</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: world effects for the crazy events.
--   Meteor Shower: red sky, burning meteors raining down (the ones the server
--                  aims at the lobby leave shards you can grab).
--   Galaxy Event:  night sky full of stars, planets, purple glow, low gravity.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Effects = require(script.Parent:WaitForChild("Effects"))

local CrazyFX = {}

local active: string? = nil
local base = nil -- lighting before any crazy event

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- remember the normal (seasonal) look so it can be restored afterwards
function CrazyFX.captureBase()
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	local sky = Lighting:FindFirstChildOfClass("Sky")
	base = {
		Lighting = {
			ClockTime = Lighting.ClockTime,
			Brightness = Lighting.Brightness,
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
		},
		Atmosphere = atmosphere and { Color = atmosphere.Color, Decay = atmosphere.Decay, Density = atmosphere.Density, Haze = atmosphere.Haze },
		CC = cc and { TintColor = cc.TintColor, Saturation = cc.Saturation },
		StarCount = sky and sky.StarCount,
	}
end

local LOOKS = {
	Meteor = {
		Lighting = { ClockTime = 18.3, Brightness = 2, Ambient = rgb(150, 70, 60), OutdoorAmbient = rgb(190, 90, 70) },
		Atmosphere = { Color = rgb(255, 110, 60), Decay = rgb(130, 30, 20), Density = 0.42, Haze = 2 },
		CC = { TintColor = rgb(255, 205, 185), Saturation = 0.35 },
		StarCount = nil,
	},
	Blizzard = {
		Lighting = { ClockTime = 12, Brightness = 2.4, Ambient = rgb(170, 190, 225), OutdoorAmbient = rgb(205, 218, 245) },
		Atmosphere = { Color = rgb(232, 241, 255), Decay = rgb(170, 190, 225), Density = 0.55, Haze = 3 },
		CC = { TintColor = rgb(225, 238, 255), Saturation = -0.1 },
		StarCount = nil,
	},
	GoldFrenzy = {
		Lighting = { ClockTime = 17, Brightness = 3, Ambient = rgb(185, 150, 80), OutdoorAmbient = rgb(235, 190, 100) },
		Atmosphere = { Color = rgb(255, 215, 110), Decay = rgb(200, 140, 40), Density = 0.35, Haze = 1.5 },
		CC = { TintColor = rgb(255, 238, 190), Saturation = 0.5 },
		StarCount = nil,
	},
	Thunder = {
		Lighting = { ClockTime = 21, Brightness = 1.3, Ambient = rgb(70, 80, 135), OutdoorAmbient = rgb(95, 105, 165) },
		Atmosphere = { Color = rgb(95, 105, 155), Decay = rgb(40, 40, 95), Density = 0.5, Haze = 2.5 },
		CC = { TintColor = rgb(200, 210, 255), Saturation = 0.1 },
		StarCount = nil,
	},
	PetParty = {
		Lighting = { ClockTime = 15.2, Brightness = 3, Ambient = rgb(170, 130, 190), OutdoorAmbient = rgb(210, 170, 230) },
		Atmosphere = { Color = rgb(255, 170, 225), Decay = rgb(200, 110, 200), Density = 0.3, Haze = 1 },
		CC = { TintColor = rgb(255, 225, 245), Saturation = 0.5 },
		StarCount = nil,
	},
	Galaxy = {
		Lighting = { ClockTime = 0, Brightness = 2.4, Ambient = rgb(110, 80, 170), OutdoorAmbient = rgb(140, 110, 210) },
		Atmosphere = { Color = rgb(130, 90, 255), Decay = rgb(40, 20, 100), Density = 0.22, Haze = 1.4 },
		CC = { TintColor = rgb(225, 210, 255), Saturation = 0.45 },
		StarCount = 6000,
	},
}

local function tweenTo(look)
	local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	local sky = Lighting:FindFirstChildOfClass("Sky")
	-- ClockTime jumps (tweening across midnight looks odd)
	local lightProps = table.clone(look.Lighting)
	Lighting.ClockTime = lightProps.ClockTime
	lightProps.ClockTime = nil
	TweenService:Create(Lighting, info, lightProps):Play()
	if atmosphere and look.Atmosphere then
		TweenService:Create(atmosphere, info, look.Atmosphere):Play()
	end
	if cc and look.CC then
		TweenService:Create(cc, info, look.CC):Play()
	end
	if sky and look.StarCount then
		sky.StarCount = look.StarCount
	end
end

----------------------------------------------------------------------
-- Galaxy decorations: planets in the sky + twinkling stars around you
----------------------------------------------------------------------
local galaxyFolder: Folder? = nil

local function planet(parent: Instance, pos: Vector3, radius: number, color: Color3, ring: boolean)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = Vector3.one * radius * 2
	p.Position = pos
	p.Parent = parent
	if ring then
		local r = Instance.new("Part")
		r.Shape = Enum.PartType.Cylinder
		r.Anchored = true
		r.CanCollide = false
		r.CanQuery = false
		r.CanTouch = false
		r.CastShadow = false
		r.Material = Enum.Material.Neon
		r.Color = Color3.new(1, 1, 1):Lerp(color, 0.4)
		r.Transparency = 0.45
		r.Size = Vector3.new(radius * 0.08, radius * 3.6, radius * 3.6)
		r.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(70)) * CFrame.Angles(math.rad(20), 0, 0)
		r.Parent = parent
	end
	return p
end

local starPart: Part? = nil

local function galaxyOn()
	if galaxyFolder then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "GalaxySky"
	planet(f, Vector3.new(420, 950, -900), 150, rgb(170, 90, 255), true)
	planet(f, Vector3.new(-650, 820, -1500), 90, rgb(60, 220, 255), false)
	planet(f, Vector3.new(-250, 1150, -300), 55, rgb(255, 120, 200), false)
	planet(f, Vector3.new(900, 700, -2200), 120, rgb(255, 190, 80), true)
	f.Parent = Workspace
	galaxyFolder = f

	local sp = Instance.new("Part")
	sp.Name = "GalaxyStars"
	sp.Anchored = true
	sp.CanCollide = false
	sp.CanQuery = false
	sp.CanTouch = false
	sp.Transparency = 1
	sp.Size = Vector3.new(200, 80, 200)
	sp.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(rgb(255, 255, 255), rgb(190, 150, 255))
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 0) })
	e.Lifetime = NumberRange.new(2, 4)
	e.Rate = 70
	e.Speed = NumberRange.new(0.5, 2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Parent = sp
	starPart = sp
end

local function galaxyOff()
	if galaxyFolder then
		galaxyFolder:Destroy()
		galaxyFolder = nil
	end
	if starPart then
		starPart:Destroy()
		starPart = nil
	end
end

----------------------------------------------------------------------
-- Weather that falls around the camera: confetti, blizzard, gold, rain
----------------------------------------------------------------------
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, rgb(255, 90, 140)),
	ColorSequenceKeypoint.new(0.2, rgb(255, 225, 80)),
	ColorSequenceKeypoint.new(0.4, rgb(100, 255, 160)),
	ColorSequenceKeypoint.new(0.6, rgb(90, 190, 255)),
	ColorSequenceKeypoint.new(0.8, rgb(210, 120, 255)),
	ColorSequenceKeypoint.new(1, rgb(255, 150, 60)),
})

local WEATHER = {
	PetParty = { Color = RAINBOW, Size = 0.55, Rate = 150, Life = NumberRange.new(3, 5), Speed = NumberRange.new(8, 16), Spread = 20,
		Accel = Vector3.new(0, -4, 0), Light = 0.3, Spin = true, Height = 45 },
	Blizzard = { Color = ColorSequence.new(rgb(255, 255, 255), rgb(190, 225, 255)), Size = 0.5, Rate = 900, Life = NumberRange.new(1.5, 2.5), Speed = NumberRange.new(45, 70),
		Spread = 12, Accel = Vector3.new(-70, -10, 12), Light = 0.35, Height = 40, Transparency = 0.15 },
	GoldFrenzy = { Color = ColorSequence.new(rgb(255, 250, 170), rgb(255, 190, 30)), Size = 0.7, Rate = 170, Life = NumberRange.new(3, 5), Speed = NumberRange.new(6, 12),
		Spread = 25, Accel = Vector3.new(0, -3, 0), Light = 1, Spin = true, Height = 45 },
	Thunder = { Color = ColorSequence.new(rgb(200, 220, 255), rgb(120, 150, 255)), Size = 0.22, Rate = 1000, Life = NumberRange.new(0.8, 1.1), Speed = NumberRange.new(110, 140),
		Spread = 4, Accel = Vector3.new(-12, 0, 0), Light = 0.2, Height = 45, Transparency = 0.35, Streak = true },
}

local weatherPart: Part? = nil
local weatherHeight = 45

local function weatherOn(id: string)
	local spec = WEATHER[id]
	if not spec or weatherPart then
		return
	end
	local sp = Instance.new("Part")
	sp.Name = "EventWeather"
	sp.Anchored = true
	sp.CanCollide = false
	sp.CanQuery = false
	sp.CanTouch = false
	sp.Transparency = 1
	sp.Size = Vector3.new(170, 2, 170)
	sp.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Color = spec.Color
	e.LightEmission = spec.Light
	e.Size = NumberSequence.new(spec.Size)
	e.Rate = spec.Rate
	e.Lifetime = spec.Life
	e.Speed = spec.Speed
	e.EmissionDirection = Enum.NormalId.Bottom
	e.SpreadAngle = Vector2.new(spec.Spread, spec.Spread)
	e.Acceleration = spec.Accel
	e.Transparency = NumberSequence.new(spec.Transparency or 0)
	if spec.Spin then
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-240, 240)
	end
	if spec.Streak then
		e.Orientation = Enum.ParticleOrientation.VelocityParallel
		e.Size = NumberSequence.new(0.3)
		e.Squash = NumberSequence.new(-6)
	end
	e.Parent = sp
	weatherPart = sp
	weatherHeight = spec.Height
end

local function weatherOff()
	if weatherPart then
		weatherPart:Destroy()
		weatherPart = nil
	end
end

----------------------------------------------------------------------
-- Lightning (Thunder Storm): a bright flash, a bolt from the sky, shake
----------------------------------------------------------------------
local nextBolt = 0

local function lightning(camera: Camera)
	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, -1)
	local target = camera.CFrame.Position + flat * math.random(80, 260) + Vector3.new(math.random(-140, 140), 0, 0)
	local top = target + Vector3.new(math.random(-30, 30), 340, math.random(-30, 30))
	local last = top
	for i = 1, 7 do
		local nextPoint = top:Lerp(target, i / 7) + (if i < 7 then Vector3.new(math.random(-14, 14), 0, math.random(-14, 14)) else Vector3.zero)
		local seg = Instance.new("Part")
		seg.Anchored = true
		seg.CanCollide = false
		seg.CanQuery = false
		seg.CanTouch = false
		seg.CastShadow = false
		seg.Material = Enum.Material.Neon
		seg.Color = rgb(235, 240, 255)
		local len = (nextPoint - last).Magnitude
		seg.Size = Vector3.new(1.6, 1.6, len)
		seg.CFrame = CFrame.lookAt(last:Lerp(nextPoint, 0.5), nextPoint)
		seg.Parent = Workspace
		Debris:AddItem(seg, 0.18)
		last = nextPoint
	end
	Effects.burst(target + Vector3.new(0, 1, 0), rgb(220, 230, 255), 22, 2)
	local d = (camera.CFrame.Position - target).Magnitude
	Effects.shake(math.clamp(2 - d / 150, 0.3, 1.6))
	Effects.play("MeteorImpact", 1.7, math.clamp(1.3 - d / 250, 0.25, 1))
	-- screen flash: briefly brighter lighting
	local normal = Lighting.Brightness
	Lighting.Brightness = normal + 3
	TweenService:Create(Lighting, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Brightness = normal }):Play()
end

----------------------------------------------------------------------
-- Meteors
----------------------------------------------------------------------
local function meteorModel(size: number): BasePart
	local rock = Instance.new("Part")
	rock.Name = "Meteor"
	rock.Shape = Enum.PartType.Ball
	rock.Anchored = true
	rock.CanCollide = false
	rock.CanQuery = false
	rock.CanTouch = false
	rock.Material = Enum.Material.CrackedLava
	rock.Color = rgb(90, 40, 30)
	rock.Size = Vector3.one * size
	local fire = Instance.new("ParticleEmitter")
	fire.Color = ColorSequence.new(rgb(255, 230, 120), rgb(255, 60, 20))
	fire.LightEmission = 1
	fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.9), NumberSequenceKeypoint.new(1, 0) })
	fire.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	fire.Lifetime = NumberRange.new(0.4, 0.8)
	fire.Rate = 120
	fire.Speed = NumberRange.new(2, 6)
	fire.SpreadAngle = Vector2.new(20, 20)
	fire.Parent = rock
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 140, 50)
	light.Range = size * 6
	light.Brightness = 4
	light.Parent = rock
	return rock
end

-- a meteor that lands at `target` after `fall` seconds
function CrazyFX.meteor(target: Vector3, fall: number, size: number?)
	fall = math.max(0.3, fall)
	local s = size or 5
	local from = target + Vector3.new(math.random(-60, 60), 260, math.random(60, 160))
	local rock = meteorModel(s)
	rock.Position = from
	rock.Parent = Workspace
	local t = TweenService:Create(rock, TweenInfo.new(fall, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = target + Vector3.new(0, s * 0.4, 0) })
	t:Play()
	t.Completed:Connect(function()
		Effects.burst(target + Vector3.new(0, 1, 0), rgb(255, 120, 40), 30, 2.5)
		Effects.burst(target + Vector3.new(0, 1, 0), rgb(60, 50, 50), 16, 3)
		local camera = Workspace.CurrentCamera
		local d = if camera then (camera.CFrame.Position - target).Magnitude else 999
		if d < 180 then
			Effects.shake(math.clamp(2.2 - d / 90, 0.3, 2))
			Effects.play("MeteorImpact", 0.45, math.clamp(1.4 - d / 150, 0.2, 1))
		end
		-- glowing crater ring that fades out
		local ring = Instance.new("Part")
		ring.Shape = Enum.PartType.Cylinder
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanQuery = false
		ring.CanTouch = false
		ring.Material = Enum.Material.Neon
		ring.Color = rgb(255, 110, 30)
		ring.Size = Vector3.new(0.3, s * 2, s * 2)
		ring.CFrame = CFrame.new(target + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
		ring.Parent = Workspace
		TweenService:Create(ring, TweenInfo.new(1.6), { Size = Vector3.new(0.3, s * 5, s * 5), Transparency = 1 }):Play()
		Debris:AddItem(ring, 1.7)
		rock:Destroy()
	end)
	Debris:AddItem(rock, fall + 1)
end

-- extra meteors for the show, raining around the camera
local ambientT = 0
RunService.Heartbeat:Connect(function(dt)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if starPart then
		starPart.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 30, 0))
	end
	if weatherPart then
		weatherPart.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, weatherHeight, 0))
	end
	if active == "Thunder" and os.clock() > nextBolt then
		nextBolt = os.clock() + 1.5 + math.random() * 3.5
		lightning(camera)
	end
	if active == "Meteor" then
		ambientT += dt
		if ambientT > 0.9 then
			ambientT = 0
			local look = camera.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			flat = if flat.Magnitude > 0.01 then flat.Unit else Vector3.new(0, 0, -1)
			local ahead = camera.CFrame.Position + flat * math.random(60, 220) + Vector3.new(math.random(-120, 120), 0, math.random(-40, 40))
			-- find the ground under that point
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { camera }
			local hit = Workspace:Raycast(ahead + Vector3.new(0, 400, 0), Vector3.new(0, -1200, 0), params)
			if hit then
				CrazyFX.meteor(hit.Position, 1.6, math.random(3, 7))
			end
		end
	end
end)

----------------------------------------------------------------------
-- Switch looks
----------------------------------------------------------------------
function CrazyFX.setActive(id: string?)
	if id == active then
		return
	end
	if not base then
		CrazyFX.captureBase()
	end
	active = id
	if id == "Galaxy" then
		galaxyOn()
	else
		galaxyOff()
	end
	weatherOff()
	if id then
		weatherOn(id)
	end
	local look = id and LOOKS[id]
	if look then
		tweenTo(look)
	elseif base then
		tweenTo(base)
	end
end

function CrazyFX.active(): string?
	return active
end

return CrazyFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1309">
          <Properties>
            <string name="Name">PetModels</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: 3D pet models (Pet Simulator style), built from parts so no
-- uploaded meshes are needed. Every pet is a chunky round critter with big
-- shiny eyes, blush and little feet, plus its own ears, horns, wings, hats...
--
-- PetModels.build(petId) -> Model (PrimaryPart "Root" sits in the middle of the
-- body, the face looks along -Z). Move it with Model:PivotTo().

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Pets = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Pets"))

local PetModels = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
local BLACK = rgb(28, 26, 38)
local WHITE = rgb(255, 255, 255)
local PINK = rgb(255, 150, 185)
local GOLD = rgb(255, 205, 50)
local ORANGE = rgb(255, 160, 40)

local function darker(c: Color3, k: number?): Color3
	return c:Lerp(Color3.new(0, 0, 0), k or 0.22)
end
local function lighter(c: Color3, k: number?): Color3
	return c:Lerp(Color3.new(1, 1, 1), k or 0.35)
end

----------------------------------------------------------------------
-- Part helpers
----------------------------------------------------------------------
type Opts = { Material: Enum.Material?, Transparency: number?, Name: string? }

local function newPart(m: Model, class: string, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): BasePart
	local p = Instance.new(class)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = (opts and opts.Material) or Enum.Material.SmoothPlastic
	p.Transparency = (opts and opts.Transparency) or 0
	p.Name = (opts and opts.Name) or "Part"
	p.Parent = m
	return p
end

-- squashed sphere of any size
local function blob(m: Model, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): BasePart
	local p = newPart(m, "Part", size, cf, color, opts)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function block(m: Model, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): BasePart
	return newPart(m, "Part", size, cf, color, opts)
end

-- cylinder standing up (along Y)
local function cyl(m: Model, height: number, diameter: number, cf: CFrame, color: Color3, opts: Opts?): BasePart
	local p = newPart(m, "Part", Vector3.new(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.rad(90)), color, opts)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- stacked cylinders getting thinner: hats, horns, spikes
local function cone(m: Model, base: CFrame, radius: number, height: number, color: Color3, steps: number?, opts: Opts?)
	local n = steps or 5
	local h = height / n
	for i = 0, n - 1 do
		local r = radius * (1 - i / n) + 0.02
		cyl(m, h + 0.02, r * 2, base * CFrame.new(0, h * (i + 0.5), 0), color, opts)
	end
end

-- a square turned 45 degrees: pointy ears, spikes, stars
local function diamond(m: Model, size: Vector3, cf: CFrame, color: Color3, opts: Opts?): BasePart
	return block(m, size, cf * CFrame.Angles(0, 0, math.rad(45)), color, opts)
end

local function at(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

----------------------------------------------------------------------
-- The critter body
----------------------------------------------------------------------
type Ctx = { A: number, B: number, C: number, Top: number, Bottom: number, Spec: any }

-- point on the front of the body (front = -Z), pushed out a little
local function front(ctx: Ctx, x: number, y: number, out: number?): Vector3
	if ctx.Spec.Cube then
		return Vector3.new(x, y, -ctx.C - (out or 0))
	end
	local k = 1 - (x / ctx.A) ^ 2 - (y / ctx.B) ^ 2
	return Vector3.new(x, y, -ctx.C * math.sqrt(math.max(0.04, k)) - (out or 0))
end

local function ears(m: Model, ctx: Ctx, kind: string, color: Color3, inner: Color3)
	local top = ctx.Top
	for _, side in { -1, 1 } do
		if kind == "Cat" or kind == "Fox" then
			local s = if kind == "Fox" then 0.78 else 0.62
			local cf = at(side * ctx.A * 0.52, top - 0.08, 0.1) * CFrame.Angles(0, 0, side * math.rad(-14))
			diamond(m, Vector3.new(s, s, 0.24), cf, color)
			diamond(m, Vector3.new(s * 0.55, s * 0.55, 0.05), cf * at(0, 0.04, -0.13), inner)
		elseif kind == "Bunny" then
			local cf = at(side * 0.4, top + 0.5, 0.1) * CFrame.Angles(0, 0, side * math.rad(-10))
			blob(m, Vector3.new(0.42, 1.35, 0.3), cf, color)
			blob(m, Vector3.new(0.22, 0.95, 0.06), cf * at(0, 0.02, -0.15), inner)
		elseif kind == "Bear" then
			local cf = at(side * ctx.A * 0.68, top - 0.18, 0.1)
			blob(m, Vector3.new(0.6, 0.6, 0.36), cf, color)
			blob(m, Vector3.new(0.32, 0.32, 0.06), cf * at(0, 0, -0.18), inner)
		elseif kind == "Tufts" then
			diamond(m, Vector3.new(0.4, 0.4, 0.16), at(side * ctx.A * 0.6, top - 0.02, 0) * CFrame.Angles(0, 0, side * math.rad(-25)), color)
		elseif kind == "Pointy" then
			block(m, Vector3.new(0.7, 0.26, 0.14), at(side * (ctx.A + 0.15), 0.2, 0.05) * CFrame.Angles(0, 0, side * math.rad(25)), color)
		end
	end
end

local function face(m: Model, ctx: Ctx, spec)
	local ex = spec.EyeX or 0.42
	local ey = spec.EyeY or 0.22
	local es = spec.EyeSize or 1
	local out = spec.FaceOut or 0
	if not spec.NoEyes then
		for _, side in { -1, 1 } do
			local p = front(ctx, side * ex, ey, out - 0.04)
			if spec.EyeRing then
				blob(m, Vector3.new(0.56, 0.62, 0.12) * es, CFrame.new(p + Vector3.new(0, 0, -0.02)), spec.EyeRing)
			end
			local eyeColor = spec.Eye or BLACK
			blob(m, Vector3.new(0.36, 0.48, 0.16) * es, CFrame.new(p + Vector3.new(0, 0, -0.05)), eyeColor, if spec.EyeGlow then { Material = Enum.Material.Neon } else nil)
			if not spec.EyeGlow then
				blob(m, Vector3.new(0.14, 0.14, 0.06) * es, CFrame.new(p + Vector3.new(0.06 * es, 0.1 * es, -0.13)), WHITE, { Material = Enum.Material.Neon })
			end
		end
	end
	if not spec.NoBlush then
		for _, side in { -1, 1 } do
			local p = front(ctx, side * (ex + 0.36), ey - 0.32, out - 0.02)
			blob(m, Vector3.new(0.3, 0.15, 0.08), CFrame.new(p), spec.Blush or PINK, { Transparency = 0.15 })
		end
	end
	if spec.Smile then
		local p = front(ctx, 0, ey - 0.38, -0.03)
		block(m, Vector3.new(0.3, 0.08, 0.06), CFrame.new(p), spec.Smile)
	end
end

-- body + face + feet + ears; returns the context for extras
local function critter(m: Model, spec): Ctx
	local size = spec.Size or Vector3.new(2.4, 2.2, 2.2)
	local ctx: Ctx = { A = size.X / 2, B = size.Y / 2, C = size.Z / 2, Top = size.Y / 2, Bottom = -size.Y / 2, Spec = spec }
	local opts = { Material = spec.Material, Transparency = spec.Transparency, Name = "Body" }
	if spec.Cube then
		block(m, size, CFrame.new(), spec.Body, opts)
	else
		blob(m, size, CFrame.new(), spec.Body, opts)
	end
	if spec.Belly then
		local p = front(ctx, 0, -0.32, -0.32)
		blob(m, Vector3.new(size.X * 0.62, size.Y * 0.55, 0.7), CFrame.new(p), spec.Belly, { Transparency = spec.Transparency })
	end
	face(m, ctx, spec)
	if spec.Feet ~= false then
		local fc = spec.FeetColor or darker(spec.Body, 0.12)
		for _, side in { -1, 1 } do
			blob(m, Vector3.new(0.62, 0.38, 0.75), at(side * ctx.A * 0.46, ctx.Bottom + 0.06, -0.2), fc, { Transparency = spec.Transparency })
		end
	end
	if spec.Ears then
		ears(m, ctx, spec.Ears, spec.EarColor or spec.Body, spec.EarInner or PINK)
	end
	return ctx
end

----------------------------------------------------------------------
-- Reusable extras
----------------------------------------------------------------------
local function snout(m, ctx, color, nose)
	local p = front(ctx, 0, -0.12, -0.12)
	blob(m, Vector3.new(0.75, 0.5, 0.45), CFrame.new(p), color)
	blob(m, Vector3.new(0.26, 0.18, 0.12), CFrame.new(p + Vector3.new(0, 0.1, -0.24)), nose or BLACK)
end

local function nose(m, ctx, color, size)
	local p = front(ctx, 0, -0.05, -0.05)
	blob(m, Vector3.one * (size or 0.2), CFrame.new(p), color)
end

local function beak(m, ctx, color)
	local p = front(ctx, 0, -0.08, -0.12)
	diamond(m, Vector3.new(0.34, 0.34, 0.3), CFrame.new(p) * CFrame.Angles(math.rad(10), 0, 0), color)
end

local function sideWings(m, ctx, color, size)
	local s = size or 1
	for _, side in { -1, 1 } do
		blob(m, Vector3.new(0.28, 1.05 * s, 0.95 * s), at(side * (ctx.A - 0.02), -0.1, 0.1) * CFrame.Angles(0, 0, side * math.rad(18)), color)
	end
end

local function batWings(m, ctx, color, size)
	local s = size or 1
	for _, side in { -1, 1 } do
		local root = at(side * (ctx.A - 0.1), 0.3, 0.35) * CFrame.Angles(0, side * math.rad(-25), side * math.rad(-30))
		block(m, Vector3.new(1.3 * s, 0.9 * s, 0.1), root * at(side * 0.6 * s, 0, 0), color)
		diamond(m, Vector3.new(0.55 * s, 0.55 * s, 0.1), root * at(side * 1.15 * s, -0.25 * s, 0), color)
		diamond(m, Vector3.new(0.45 * s, 0.45 * s, 0.1), root * at(side * 0.55 * s, -0.42 * s, 0), color)
	end
end

local function horns(m, ctx, color, length, spread)
	for _, side in { -1, 1 } do
		cone(m, at(side * (spread or 0.45), ctx.Top - 0.15, 0.15) * CFrame.Angles(math.rad(-15), 0, side * math.rad(-22)), 0.17, length or 0.7, color, 4)
	end
end

local function tail(m, ctx, color, size, tip)
	local s = size or Vector3.new(0.6, 0.6, 1)
	local p = at(0, -0.35, ctx.C + s.Z * 0.3) * CFrame.Angles(math.rad(-30), 0, 0)
	blob(m, s, p, color)
	if tip then
		blob(m, s * 0.55, p * at(0, 0, s.Z * 0.38), tip)
	end
end

local function backSpikes(m, ctx, color, count)
	for i = 0, (count or 3) - 1 do
		local y = ctx.Top - 0.25 - i * 0.45
		diamond(m, Vector3.new(0.38, 0.38, 0.12), at(0, y, ctx.C * math.sqrt(math.max(0.05, 1 - (y / ctx.B) ^ 2)) - 0.05) * CFrame.Angles(0, math.rad(90), 0), color)
	end
end

local function hat(m, ctx, color, trim, pom)
	local base = at(0, ctx.Top - 0.2, 0.05) * CFrame.Angles(math.rad(-12), 0, math.rad(-10))
	cyl(m, 0.28, ctx.A * 1.75, base, trim)
	cone(m, base * at(0, 0.1, 0), ctx.A * 0.78, 1.25, color, 9)
	blob(m, Vector3.one * 0.42, base * at(0.12, 1.4, 0), pom)
end

local function crown(m, ctx, color, gem)
	local y = ctx.Top - 0.05
	cyl(m, 0.38, 1.3, at(0, y, 0), color, { Material = Enum.Material.Foil })
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		diamond(m, Vector3.new(0.3, 0.3, 0.1), at(math.cos(a) * 0.58, y + 0.3, math.sin(a) * 0.58) * CFrame.Angles(0, -a + math.pi / 2, 0), color, { Material = Enum.Material.Foil })
	end
	blob(m, Vector3.one * 0.26, at(0, y + 0.05, -0.66), gem, { Material = Enum.Material.Neon })
end

local function scarf(m, ctx, color)
	cyl(m, 0.32, ctx.A * 2 - 0.15, at(0, -0.42, 0), color)
	block(m, Vector3.new(0.34, 0.75, 0.12), at(0.45, -0.75, -ctx.C + 0.15) * CFrame.Angles(0, 0, math.rad(8)), color)
end

-- a band hugging the body at height y (belts)
local function belt(m, ctx, y, height, color)
	local k = math.sqrt(math.max(0.05, 1 - (y / ctx.B) ^ 2))
	local band = blob(m, Vector3.new(ctx.A * 2 * k + 0.08, height, ctx.C * 2 * k + 0.08), at(0, y, 0), color)
	return band
end

local function cape(m, ctx, color, inner)
	local cf = at(0, -0.15, ctx.C + 0.06) * CFrame.Angles(math.rad(8), 0, 0)
	block(m, Vector3.new(ctx.A * 1.9, ctx.B * 1.9, 0.12), cf, color)
	if inner then
		block(m, Vector3.new(ctx.A * 1.7, ctx.B * 1.7, 0.06), cf * at(0, 0, -0.08), inner)
	end
	-- collar points
	for _, side in { -1, 1 } do
		diamond(m, Vector3.new(0.6, 0.6, 0.1), at(side * 0.75, ctx.Top - 0.45, ctx.C * 0.55) * CFrame.Angles(math.rad(-20), side * math.rad(30), 0), color)
	end
end

local function fangs(m, ctx, color)
	for _, side in { -1, 1 } do
		diamond(m, Vector3.new(0.12, 0.12, 0.05), CFrame.new(front(ctx, side * 0.12, -0.32, -0.06)), color or WHITE)
	end
end

local function sparkleGem(m, cf, color)
	diamond(m, Vector3.new(0.35, 0.35, 0.35), cf * CFrame.Angles(math.rad(45), 0, 0), color, { Material = Enum.Material.Neon })
end

----------------------------------------------------------------------
-- Every pet
----------------------------------------------------------------------
local SPECS = {}

-- Frosty Egg -------------------------------------------------------------
SPECS.Penguin = { Body = rgb(46, 52, 74), Belly = WHITE, FeetColor = ORANGE, Extra = function(m, ctx)
	beak(m, ctx, ORANGE)
	sideWings(m, ctx, rgb(36, 40, 60), 0.9)
end }
SPECS.SnowBunny = { Body = rgb(250, 250, 255), Ears = "Bunny", Extra = function(m, ctx)
	nose(m, ctx, PINK, 0.18)
	blob(m, Vector3.one * 0.55, at(0, -0.5, ctx.C + 0.05), WHITE)
end }
SPECS.ArcticFox = { Body = rgb(240, 246, 255), Ears = "Fox", EarInner = rgb(200, 220, 245), Extra = function(m, ctx)
	snout(m, ctx, WHITE)
	tail(m, ctx, rgb(240, 246, 255), Vector3.new(0.75, 0.75, 1.4), rgb(200, 225, 255))
end }
SPECS.SnowBear = { Body = rgb(248, 246, 240), Ears = "Bear", EarInner = rgb(220, 210, 200), Extra = function(m, ctx)
	snout(m, ctx, rgb(255, 252, 248))
	scarf(m, ctx, rgb(80, 150, 255))
end }
SPECS.SnowOwl = { Body = rgb(245, 245, 250), Ears = "Tufts", EyeRing = GOLD, EyeX = 0.46, Belly = rgb(225, 230, 240), Extra = function(m, ctx)
	beak(m, ctx, rgb(255, 190, 60))
	sideWings(m, ctx, rgb(225, 230, 240), 1.1)
	for _, s in { { -0.5, 0.75 }, { 0.6, 0.55 }, { -0.2, -0.6 }, { 0.4, -0.75 } } do
		blob(m, Vector3.new(0.14, 0.1, 0.06), CFrame.new(front(ctx, s[1] * 0.9, s[2] * 0.9, -0.02)), rgb(120, 120, 140))
	end
end }

-- Glacier Egg ------------------------------------------------------------
SPECS.IceWolf = { Body = rgb(175, 205, 235), Ears = "Fox", EarInner = rgb(220, 235, 255), Belly = rgb(235, 245, 255), Extra = function(m, ctx)
	snout(m, ctx, rgb(225, 238, 255))
	tail(m, ctx, rgb(175, 205, 235), Vector3.new(0.6, 0.6, 1.3), WHITE)
	sparkleGem(m, CFrame.new(front(ctx, 0, 0.75, -0.02)), rgb(120, 230, 255))
end }
SPECS.SnowCat = { Body = rgb(250, 250, 255), Ears = "Cat", Extra = function(m, ctx)
	nose(m, ctx, PINK, 0.16)
	for _, side in { -1, 1 } do
		for k = -1, 1 do
			block(m, Vector3.new(0.5, 0.04, 0.04), CFrame.new(front(ctx, side * 0.62, -0.08 + k * 0.1, -0.06)) * CFrame.Angles(0, 0, math.rad(k * 10 * side)), rgb(120, 130, 150))
		end
	end
	for i = 0, 2 do
		block(m, Vector3.new(0.12, 0.5, 0.06), CFrame.new(front(ctx, -0.25 + i * 0.25, 0.85, 0)), rgb(140, 190, 255))
	end
	tail(m, ctx, WHITE, Vector3.new(0.3, 0.3, 1.3), rgb(140, 190, 255))
end }
SPECS.IceWhale = { Body = rgb(80, 150, 235), Size = Vector3.new(2.6, 2, 2.6), Belly = rgb(190, 225, 255), Feet = false, Extra = function(m, ctx)
	local base = at(0, 0.1, ctx.C + 0.25)
	for _, side in { -1, 1 } do
		block(m, Vector3.new(0.9, 0.12, 0.6), base * at(side * 0.4, 0.35, 0.2) * CFrame.Angles(0, 0, side * math.rad(30)), rgb(70, 135, 220))
		blob(m, Vector3.new(0.25, 0.4, 0.7), at(side * (ctx.A - 0.05), -0.45, -0.1) * CFrame.Angles(0, 0, side * math.rad(40)), rgb(70, 135, 220))
	end
	for i = 0, 2 do
		blob(m, Vector3.one * (0.35 - i * 0.08), at((i - 1) * 0.25, ctx.Top + 0.25 + i * 0.25, 0), rgb(150, 230, 255), { Material = Enum.Material.Neon, Transparency = 0.2 })
	end
end }
SPECS.FrostDragon = { Body = rgb(130, 195, 255), Belly = rgb(215, 240, 255), Extra = function(m, ctx)
	horns(m, ctx, WHITE, 0.65)
	batWings(m, ctx, rgb(170, 225, 255), 0.9)
	backSpikes(m, ctx, WHITE, 3)
	tail(m, ctx, rgb(130, 195, 255), Vector3.new(0.45, 0.45, 1.3), WHITE)
	nose(m, ctx, rgb(100, 160, 230), 0.14)
end }
SPECS.Unicorn = { Body = WHITE, Ears = "Cat", EarInner = rgb(255, 200, 230), Extra = function(m, ctx)
	cone(m, at(0, ctx.Top - 0.2, -0.45) * CFrame.Angles(math.rad(-25), 0, 0), 0.2, 1.1, GOLD, 6, { Material = Enum.Material.Foil })
	local mane = { rgb(255, 150, 210), rgb(160, 150, 255), rgb(120, 220, 255), rgb(255, 220, 120) }
	for i, c in mane do
		blob(m, Vector3.new(0.5, 0.55, 0.5), at(0.15 * ((i % 2) * 2 - 1), ctx.Top - 0.05 - i * 0.28, 0.35 + i * 0.22), c)
	end
	tail(m, ctx, rgb(255, 150, 210), Vector3.new(0.5, 0.5, 1.1), rgb(160, 150, 255))
end }
SPECS.Yeti = { Body = rgb(245, 248, 255), Size = Vector3.new(2.7, 2.6, 2.4), EyeY = 0.3, FaceOut = 0.08, Extra = function(m, ctx)
	local p = front(ctx, 0, 0.12, 0)
	blob(m, Vector3.new(1.75, 1.35, 0.3), CFrame.new(p + Vector3.new(0, 0, 0.06)), rgb(150, 190, 235))
	horns(m, ctx, rgb(200, 210, 230), 0.55, 0.65)
	fangs(m, ctx)
	for _, side in { -1, 1 } do
		blob(m, Vector3.new(0.7, 1.2, 0.7), at(side * (ctx.A + 0.05), -0.4, -0.1) * CFrame.Angles(0, 0, side * math.rad(15)), rgb(240, 244, 255))
	end
end }

-- Aurora Egg -------------------------------------------------------------
SPECS.AuroraBird = { Body = rgb(80, 225, 195), Belly = rgb(200, 255, 235), FeetColor = ORANGE, Extra = function(m, ctx)
