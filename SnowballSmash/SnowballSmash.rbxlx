      <Item class="ModuleScript" referent="1144">
        <Properties>
          <string name="Name">CourseGen</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: the endless mountain.
-- The course is cut into chunks. Each chunk's contents come from a seeded
-- Random, so the server and every client generate exactly the same course.
-- Obstacles get tougher (and pay more) the further down you go, so nobody
-- can ever reach the bottom.

local Config = require(script.Parent:WaitForChild("Config"))

local CourseGen = {}

CourseGen.Seed = 2026
CourseGen.Origin = Vector3.new(0, 500, 0) -- top of the slope (where the lobby ends)
CourseGen.AngleDeg = 14
CourseGen.Width = 100
CourseGen.ChunkLength = 250
CourseGen.StartOffset = -16 -- where the snowball waits on the start pad
CourseGen.GateEvery = 1500 -- a Snow Fort gate across the whole slope every N studs
CourseGen.MarkerEvery = 500 -- distance sign every N studs

local ANGLE = math.rad(CourseGen.AngleDeg)
CourseGen.Right = Vector3.new(1, 0, 0)
CourseGen.Down = Vector3.new(0, -math.sin(ANGLE), -math.cos(ANGLE)) -- forward, down the slope
CourseGen.Normal = Vector3.new(0, math.cos(ANGLE), -math.sin(ANGLE))
CourseGen.Flat = Vector3.new(0, 0, -1)
CourseGen.SlopeCF = CFrame.fromMatrix(CourseGen.Origin, CourseGen.Right, CourseGen.Normal)

-- Obstacle kinds: size footprint (W across, D along the slope, H tall),
-- base toughness and base coins.
CourseGen.Kinds = {
	Snowman = { W = 4.4, D = 4.4, H = 10.5, Tough = 1, Coins = 12 },
	Fence = { W = 13.4, D = 1.2, H = 3.6, Tough = 1, Coins = 8 },
	Gifts = { W = 6, D = 3.6, H = 6, Tough = 1, Coins = 22 },
	Penguin = { W = 2.8, D = 2.8, H = 4.5, Tough = 1, Coins = 28 },
	Tree = { W = 8, D = 8, H = 17, Tough = 2, Coins = 18 },
	IceWall = { W = 16, D = 2, H = 8, Tough = 3, Coins = 30 },
	SnowWall = { W = 20.5, D = 3.4, H = 8, Tough = 4, Coins = 40 },
	IceTower = { W = 5, D = 5, H = 19, Tough = 6, Coins = 70 },
	Cabin = { W = 17, D = 15, H = 14, Tough = 7, Coins = 90 },
	Gate = { W = 100, D = 6, H = 20, Tough = 25, Coins = 400 },
	-- Halloween (only while Config.Halloween.Enabled)
	Pumpkin = { W = 5.5, D = 5.5, H = 6, Tough = 1, Coins = 20, Candy = 1 },
	GhostSnowman = { W = 4.6, D = 4.6, H = 11, Tough = 2, Coins = 30, Candy = 2 },
}

local POOLS = {
	{ Until = 600, Kinds = { "Snowman", "Snowman", "Fence", "Gifts", "Penguin" } },
	{ Until = 2000, Kinds = { "Snowman", "Tree", "Tree", "Fence", "Gifts", "Penguin", "IceWall", "SnowWall" } },
	{ Until = math.huge, Kinds = { "Tree", "IceWall", "SnowWall", "Cabin", "IceTower", "Penguin", "Gifts", "Tree", "Snowman" } },
}

-- difficulty / reward scaling with distance (in thousands of studs)
function CourseGen.ToughScale(s: number): number
	return 1 + 0.6 * math.max(0, s) / 1000
end
function CourseGen.CoinScale(s: number): number
	return 1 + 0.8 * math.max(0, s) / 1000
end

----------------------------------------------------------------------
-- Geometry
----------------------------------------------------------------------
-- point on the surface, its up vector and the forward direction
function CourseGen.Surface(s: number, x: number): (Vector3, Vector3, Vector3)
	if s < 0 then
		return CourseGen.Origin + CourseGen.Flat * s + CourseGen.Right * x, Vector3.yAxis, CourseGen.Flat
	end
	return CourseGen.Origin + CourseGen.Down * s + CourseGen.Right * x, CourseGen.Normal, CourseGen.Down
end

-- frame tilted with the slope (x right, y = surface normal, -z = downhill)
function CourseGen.SlopeFrame(s: number, x: number, h: number): CFrame
	return CourseGen.SlopeCF * CFrame.new(x, h, -s)
end

-- upright frame standing on the slope, sunk a little so the downhill edge touches
function CourseGen.Upright(s: number, x: number, depth: number?): CFrame
	local p = CourseGen.Origin + CourseGen.Down * s + CourseGen.Right * x
	return CFrame.new(p - Vector3.new(0, (depth or 4) * 0.5 * math.tan(ANGLE), 0))
end

----------------------------------------------------------------------
-- Chunk contents
----------------------------------------------------------------------
export type ObstacleSpec = {
	Kind: string,
	S: number,
	X: number,
	Rot: number,
	W: number,
	D: number,
	H: number,
	Tough: number,
	Coins: number,
	Candy: number,
	Variant: number,
}
export type PadSpec = { Kind: string, S: number, X: number }
export type CoinSpec = { S: number, X: number, H: number }
export type ChunkSpec = {
	Index: number,
	S0: number,
	S1: number,
	Obstacles: { ObstacleSpec },
	Pads: { PadSpec },
	Coins: { CoinSpec },
	Marker: number?,
	Value: number,
	Candy: number,
}

local cache: { [number]: ChunkSpec } = {}

local function inRange(list: { { number } }, s: number): boolean
	for _, r in list do
		if s > r[1] and s < r[2] then
			return true
		end
	end
	return false
end

function CourseGen.Chunk(index: number): ChunkSpec
	local cached = cache[index]
	if cached then
		return cached
	end
	local L = CourseGen.ChunkLength
	local s0, s1 = index * L, (index + 1) * L
	local rng = Random.new(CourseGen.Seed * 7919 + index * 104729)
	local half = CourseGen.Width / 2 - 8
	local chunk: ChunkSpec = { Index = index, S0 = s0, S1 = s1, Obstacles = {}, Pads = {}, Coins = {}, Marker = nil, Value = 0, Candy = 0 }
	local reserved = {}

	local function addObstacle(kind: string, s: number, x: number)
		local k = CourseGen.Kinds[kind]
		local o: ObstacleSpec = {
			Kind = kind,
			S = s,
			X = x,
			Rot = rng:NextNumber() * math.pi * 2,
			W = k.W,
			D = k.D,
			H = k.H,
			Tough = k.Tough * CourseGen.ToughScale(s),
			Coins = math.floor(k.Coins * CourseGen.CoinScale(s) + 0.5),
			Candy = k.Candy or 0,
			Variant = rng:NextInteger(1, 4),
		}
		table.insert(chunk.Obstacles, o)
		chunk.Value += o.Coins
		chunk.Candy += o.Candy
	end

	-- gate across the slope
	local gateAt = math.ceil(s0 / CourseGen.GateEvery) * CourseGen.GateEvery
	if gateAt > 0 and gateAt >= s0 and gateAt < s1 then
		addObstacle("Gate", gateAt, 0)
		table.insert(reserved, { gateAt - 30, gateAt + 20 })
	end
	local markerAt = math.ceil(s0 / CourseGen.MarkerEvery) * CourseGen.MarkerEvery
	if markerAt > 0 and markerAt >= s0 and markerAt < s1 then
		chunk.Marker = markerAt
	end

	-- one boost pad per chunk, a ramp every other chunk
	if index >= 0 then
		local bs = s0 + rng:NextNumber(30, L - 60)
		if not inRange(reserved, bs) then
			local bx = rng:NextNumber(-half + 6, half - 6)
			table.insert(chunk.Pads, { Kind = "Boost", S = bs, X = bx })
			table.insert(reserved, { bs - 12, bs + 14 })
			for i = 0, 4 do
				table.insert(chunk.Coins, { S = bs + 14 + i * 6, X = bx, H = 3 })
			end
		end
		if index % 2 == 1 then
			local rs = s0 + rng:NextNumber(40, L - 80)
			if not inRange(reserved, rs) and not inRange(reserved, rs + 40) then
				local rx = rng:NextNumber(-half + 10, half - 10)
				table.insert(chunk.Pads, { Kind = "Ramp", S = rs, X = rx })
				table.insert(reserved, { rs - 25, rs + 60 })
				for i = 0, 6 do
					table.insert(chunk.Coins, { S = rs + 14 + i * 7, X = rx, H = 6 + math.sin(i / 6 * math.pi) * 14 })
				end
			end
		end
	end

	-- rows of obstacles, denser the further you go
	local s = math.max(s0, 50)
	while s < s1 do
		local d = s / 1000
		if not inRange(reserved, s) then
			local pool
			for _, p in POOLS do
				if s < p.Until then
					pool = p.Kinds
					break
				end
			end
			local perRow = rng:NextInteger(2, 3) + math.min(3, math.floor(d))
			local used = {}
			for _ = 1, perRow do
				local kind = pool[rng:NextInteger(1, #pool)]
				local spooky = rng:NextNumber()
				if Config.Halloween.Enabled and spooky < Config.Halloween.SpawnChance then
					kind = if spooky < Config.Halloween.SpawnChance * 0.6 then "Pumpkin" else "GhostSnowman"
				end
				local x = rng:NextNumber(-half, half)
				if kind == "Cabin" then
					x = math.clamp(x, -half + 4, half - 4)
				end
				local ok = true
				for _, ux in used do
					if math.abs(ux - x) < 15 then
						ok = false
					end
				end
				if ok then
					table.insert(used, x)
					addObstacle(kind, s + rng:NextNumber(-3, 3), x)
				end
			end
			if rng:NextNumber() < 0.45 then
				local cx = rng:NextNumber(-half, half)
				for i = 0, rng:NextInteger(3, 5) - 1 do
					table.insert(chunk.Coins, { S = s + 8 + i * 6, X = cx, H = 3 })
				end
			end
		end
		s += rng:NextNumber(18, 28) * math.max(0.55, 1.2 - d * 0.12)
	end

	cache[index] = chunk
	return chunk
end

-- Total coin value of every obstacle and coin pickup up to distance `s`
-- (used by the server to reject impossible run results).
function CourseGen.ValueUpTo(s: number, pickupValue: number): number
	local total = 0
	local last = math.floor(math.max(0, s) / CourseGen.ChunkLength)
	for i = 0, last do
		local chunk = CourseGen.Chunk(i)
		total += chunk.Value + #chunk.Coins * pickupValue
	end
	return total
end

-- Most Halloween candy a run up to distance `s` could collect
function CourseGen.CandyUpTo(s: number): number
	local total = 0
	for i = 0, math.floor(math.max(0, s) / CourseGen.ChunkLength) do
		total += CourseGen.Chunk(i).Candy
	end
	return total
end

function CourseGen.CountUpTo(s: number): number
	local total = 0
	for i = 0, math.floor(math.max(0, s) / CourseGen.ChunkLength) do
		total += #CourseGen.Chunk(i).Obstacles
	end
	return total
end

return CourseGen
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="1145">
        <Properties>
          <string name="Name">Pets</string>
          <string name="Source"><![CDATA[--!nonstrict
-- Snowball Smash: pets ("Snow Buddies"), eggs, rarities and the Index.
-- Bonuses are percentages: Coins = 25 means +25% coins while equipped.

local Pets = {}

Pets.MaxInventory = 75
Pets.BaseEquipSlots = 3
Pets.ExtraSlotsPass = 2 -- with the "+2 Pet Slots" game pass
Pets.IndexBonus = 10 -- +10% coins for every egg you complete in the Index

Pets.Rarities = {
	Common = { Order = 1, Color = Color3.fromRGB(190, 200, 215) },
	Rare = { Order = 2, Color = Color3.fromRGB(70, 160, 255) },
	Epic = { Order = 3, Color = Color3.fromRGB(175, 90, 255) },
	Legendary = { Order = 4, Color = Color3.fromRGB(255, 190, 40) },
	Secret = { Order = 5, Color = Color3.fromRGB(255, 60, 90) },
}

-- Chance is in percent. Luck (Lucky Eggs pass) boosts everything Rare and above.
Pets.Eggs = {
	{
		Id = "Frosty",
		Name = "Frosty Egg",
		Currency = "Coins",
		Price = 2500,
		Color = Color3.fromRGB(170, 225, 255),
		Pets = {
			{ Id = "Penguin", Name = "Penguin", Icon = "🐧", Rarity = "Common", Chance = 45, Coins = 10 },
			{ Id = "SnowBunny", Name = "Snow Bunny", Icon = "🐰", Rarity = "Common", Chance = 30, Coins = 15 },
			{ Id = "ArcticFox", Name = "Arctic Fox", Icon = "🦊", Rarity = "Rare", Chance = 17, Coins = 30, Growth = 5 },
			{ Id = "SnowBear", Name = "Snow Bear", Icon = "🐻", Rarity = "Epic", Chance = 7, Coins = 60, Growth = 10 },
			{ Id = "SnowOwl", Name = "Snow Owl", Icon = "🦉", Rarity = "Legendary", Chance = 1, Coins = 150, Launch = 10 },
		},
	},
	{
		Id = "Glacier",
		Name = "Glacier Egg",
		Currency = "Coins",
		Price = 40000,
		Color = Color3.fromRGB(90, 170, 255),
		Pets = {
			{ Id = "IceWolf", Name = "Ice Wolf", Icon = "🐺", Rarity = "Common", Chance = 45, Coins = 35 },
			{ Id = "SnowCat", Name = "Snow Cat", Icon = "🐱", Rarity = "Common", Chance = 30, Coins = 45 },
			{ Id = "IceWhale", Name = "Ice Whale", Icon = "🐳", Rarity = "Rare", Chance = 17, Coins = 90, Growth = 10 },
			{ Id = "FrostDragon", Name = "Frost Dragon", Icon = "🐲", Rarity = "Epic", Chance = 7, Coins = 180, Launch = 10 },
			{ Id = "Unicorn", Name = "Glacier Unicorn", Icon = "🦄", Rarity = "Legendary", Chance = 0.9, Coins = 400, Growth = 20 },
			{ Id = "Yeti", Name = "Yeti", Icon = "🦍", Rarity = "Secret", Chance = 0.1, Coins = 1000, Growth = 30, Launch = 20 },
		},
	},
	{
		Id = "Aurora",
		Name = "Aurora Egg",
		Currency = "Coins",
		Price = 500000,
		Color = Color3.fromRGB(190, 120, 255),
		Pets = {
			{ Id = "AuroraBird", Name = "Aurora Bird", Icon = "🐦", Rarity = "Common", Chance = 45, Coins = 120 },
			{ Id = "FrostOcto", Name = "Frost Octo", Icon = "🐙", Rarity = "Common", Chance = 30, Coins = 150 },
			{ Id = "IceDragon", Name = "Ice Dragon", Icon = "🐉", Rarity = "Rare", Chance = 17, Coins = 300, Launch = 10 },
			{ Id = "StarSpirit", Name = "Star Spirit", Icon = "🌟", Rarity = "Epic", Chance = 7, Coins = 600, Growth = 20 },
			{ Id = "CrystalGolem", Name = "Crystal Golem", Icon = "💎", Rarity = "Legendary", Chance = 0.9, Coins = 1500, Growth = 30 },
			{ Id = "SnowKing", Name = "Snow King", Icon = "👑", Rarity = "Secret", Chance = 0.1, Coins = 4000, Growth = 50, Launch = 30 },
		},
	},
	{
		Id = "Spooky",
		Name = "Spooky Egg",
		Currency = "Candy",
		Price = 250,
		Color = Color3.fromRGB(255, 130, 30),
		Halloween = true, -- only shown while Config.Halloween.Enabled is true
		Pets = {
			{ Id = "Bat", Name = "Bat", Icon = "🦇", Rarity = "Common", Chance = 45, Coins = 40 },
			{ Id = "Ghost", Name = "Ghost", Icon = "👻", Rarity = "Common", Chance = 30, Coins = 55 },
			{ Id = "PumpkinCat", Name = "Pumpkin Cat", Icon = "🎃", Rarity = "Rare", Chance = 17, Coins = 120, Growth = 10 },
			{ Id = "Spider", Name = "Frost Spider", Icon = "🕷️", Rarity = "Epic", Chance = 7, Coins = 250, Launch = 15 },
			{ Id = "Skeleton", Name = "Ice Skeleton", Icon = "💀", Rarity = "Legendary", Chance = 0.9, Coins = 600, Growth = 25 },
			{ Id = "Vampire", Name = "Vampire", Icon = "🧛", Rarity = "Secret", Chance = 0.1, Coins = 1500, Growth = 40, Launch = 25 },
		},
	},
}

Pets.EggById = {}
Pets.ById = {}
Pets.All = {}
for _, egg in Pets.Eggs do
	Pets.EggById[egg.Id] = egg
	for _, pet in egg.Pets do
		pet.Egg = egg.Id
		pet.Coins = pet.Coins or 0
		pet.Growth = pet.Growth or 0
		pet.Launch = pet.Launch or 0
		Pets.ById[pet.Id] = pet
		table.insert(Pets.All, pet)
	end
end

-- Strength used by "Equip Best"
function Pets.Score(petId: string): number
	local p = Pets.ById[petId]
	if not p then
		return 0
	end
	return p.Coins + p.Growth * 2 + p.Launch * 2
end

function Pets.BonusText(petId: string): string
	local p = Pets.ById[petId]
	if not p then
		return ""
	end
	local parts = { "+" .. p.Coins .. "% coins" }
	if p.Growth > 0 then
		table.insert(parts, "+" .. p.Growth .. "% growth")
	end
	if p.Launch > 0 then
		table.insert(parts, "+" .. p.Launch .. "% speed")
	end
	return table.concat(parts, "  ")
end

-- Chances (percent) for an egg, with an optional luck multiplier on Rare+.
function Pets.Odds(eggId: string, luck: number?): { [string]: number }
	local egg = Pets.EggById[eggId]
	local l = luck or 1
	local weights = {}
	local total = 0
	for _, p in egg.Pets do
		local w = p.Chance
		if Pets.Rarities[p.Rarity].Order >= 2 then
			w *= l
		end
		weights[p.Id] = w
		total += w
	end
	for id, w in weights do
		weights[id] = w / total * 100
	end
	return weights
end

-- Roll a pet. `rng` is a Random object (server only).
function Pets.Roll(eggId: string, luck: number?, rng): string
	local odds = Pets.Odds(eggId, luck)
	local roll = rng:NextNumber() * 100
	local acc = 0
	local egg = Pets.EggById[eggId]
	for _, p in egg.Pets do
		acc += odds[p.Id]
		if roll <= acc then
			return p.Id
		end
	end
	return egg.Pets[1].Id
end

-- A random Legendary (5% chance: Secret) from the coin eggs (Legendary Pet product)
function Pets.RollLegendary(rng): string
	local pool = {}
	local wantSecret = rng:NextNumber() < 0.05
	for _, p in Pets.All do
		local egg = Pets.EggById[p.Egg]
		if not egg.Halloween and p.Rarity == (if wantSecret then "Secret" else "Legendary") then
			table.insert(pool, p.Id)
		end
	end
	return pool[rng:NextInteger(1, #pool)]
end

-- Eggs completed in the Index (every pet except Secrets discovered)
function Pets.CompletedEggs(index: { [string]: boolean }): { string }
	local done = {}
	for _, egg in Pets.Eggs do
		local complete = true
		for _, p in egg.Pets do
			if p.Rarity ~= "Secret" and not index[p.Id] then
				complete = false
				break
			end
		end
		if complete then
			table.insert(done, egg.Id)
		end
	end
	return done
end

return Pets
]]></string>
