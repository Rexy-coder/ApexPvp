		diamond(m, Vector3.new(0.5, 0.5, 0.5) * (1 + i * 0.1), at(s[1], ctx.Top + s[2] * 0.6, 0.1) * CFrame.Angles(math.rad(45), 0, 0), rgb(150, 240, 255), { Material = Enum.Material.Neon })
	end
	for _, side in { -1, 1 } do
